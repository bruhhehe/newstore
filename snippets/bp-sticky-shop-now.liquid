{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-sticky-cta" id="BpStickyCta" aria-hidden="true">
  <div class="bp-sticky-cta-inner">
    <span class="bp-sticky-cta-text">Cordless Heated Knee Massager</span>
    <a href="/#offer" class="bp-sticky-cta-btn">Shop now →</a>
  </div>
</div>

<style>
  .bp-sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    background: var(--bp-bg-blush-light, #FBF8F1);
    border-top: 1px solid var(--bp-line, #DCD4C0);
    color: var(--bp-ink, #23201B);
    box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .bp-sticky-cta.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  .bp-sticky-cta-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .bp-sticky-cta-text {
    font-size: 14px;
    font-weight: 600;
    opacity: 0.85;
  }

  .bp-sticky-cta-price {
    font-family: var(--bp-serif, serif);
    font-size: 18px;
    font-weight: 600;
    white-space: nowrap;
  }

  .bp-sticky-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bp-pink-deep, #B85C24);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 999px;
    white-space: nowrap;
    transition: filter 0.15s ease;
  }

  .bp-sticky-cta-btn:hover {
    filter: brightness(0.95);
  }

  @media screen and (max-width: 480px) {
    .bp-sticky-cta-text {
      display: none;
    }
    .bp-sticky-cta-inner {
      flex-direction: column;
      gap: 8px;
    }
    .bp-sticky-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  (function () {
    var bar = document.getElementById('BpStickyCta');
    if (!bar) return;

    var SHOW_AFTER_SCROLL = 400;
    var offerVisible = false;

    function updateVisibility() {
      var pastThreshold = window.scrollY > SHOW_AFTER_SCROLL;
      var shouldShow = pastThreshold && !offerVisible;
      bar.classList.toggle('is-visible', shouldShow);
      bar.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
    }

    // Hide the bar automatically whenever the real Featured offer buy box
    // is already on screen (only present on the home page) so we don't
    // show a duplicate CTA on top of the real one. We deliberately watch
    // the offer's actual content container, not the '#offer'
    // anchor itself — that anchor is a zero-height marker used only for
    // the scroll-jump link, so watching it directly meant the bar
    // reappeared as soon as the shopper scrolled past that thin marker,
    // even while the real buy box still filled the screen below it.
    var offerAnchor = document.getElementById('offer');
    var offerSection = offerAnchor ? offerAnchor.nextElementSibling : null;
    var offerObserveTarget = offerSection || offerAnchor;
    if (offerObserveTarget && 'IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        offerVisible = entries[0].isIntersecting;
        updateVisibility();
      });
      observer.observe(offerObserveTarget);
    }

    window.addEventListener('scroll', updateVisibility, { passive: true });
    updateVisibility();
  })();
</script>
