{%- comment -%}
  Steadwell Buy-it-now cart restore.
  Buy it now uses a cart permalink (/cart/variant:qty) for true single-item
  express checkout — Shopify permalinks REPLACE the cart, so the buy-now click
  backs the cart up to localStorage first, and this snippet (rendered on every
  storefront page) restores it on the customer's next page view: after a
  completed purchase OR an abandoned checkout, their original cart is intact.
{%- endcomment -%}
<script>
(function(){
  var raw;
  try { raw = localStorage.getItem('stw_cart_backup'); } catch(e) { return; }
  if (!raw) return;
  var data;
  try { data = JSON.parse(raw); } catch(e) { try{localStorage.removeItem('stw_cart_backup');}catch(_e){} return; }
  var drop = function(){ try{localStorage.removeItem('stw_cart_backup');}catch(_e){} };
  if (!data || !Array.isArray(data.items)) { drop(); return; }
  if (Date.now() - (data.t || 0) > 86400000) { drop(); return; } /* stale after 24h */
  fetch('/cart/clear.js', { method: 'POST' })
    .then(function(){
      if (!data.items.length) return null;
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: data.items })
      });
    })
    .then(function(){
      drop();
      if (window.location.pathname === '/cart') { window.location.reload(); return; }
      /* best-effort: correct the header cart count without a reload */
      return fetch('/cart.js').then(function(r){ return r.json(); }).then(function(c){
        var bubble = document.querySelector('#cart-icon-bubble .cart-count-bubble span[aria-hidden="true"]');
        if (bubble) bubble.textContent = c.item_count;
      }).catch(function(){});
    })
    .catch(drop);
})();
</script>