    "hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"stw-hero\"><div class=\"stw-hero__inner\"><p class=\"stw-hero__eyebrow\">Comfort &amp; mobility &middot; made for 45+</p><h1 class=\"stw-hero__title\">Everyday comfort, for the way you move now</h1><p class=\"stw-hero__sub\">Considered products for joint stiffness, aches and everyday mobility &mdash; described honestly, with no exaggerated claims.</p><div class=\"stw-hero__actions\"><a href=\"/collections/all\" class=\"button\">Shop all products</a><a href=\"/collections\" class=\"button button--ghost\">Shop by concern</a></div></div></div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "trust-strip": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class='stw-guar' id='guarantees'><div class='stw-guar__head'><h2>Backed by real guarantees, not just words</h2><p>The reassurance you'd want before ordering — in writing, on every order.</p></div><div class='stw-guar__grid'><div class='stw-guar__card'><span class='stw-guar__icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z'/><path d='M9 12l2 2 4-4'/></svg></span><h3>30-day returns</h3><p>Changed your mind? Send it back within 30 days of delivery for a full refund.</p></div><div class='stw-guar__card'><span class='stw-guar__icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M21 8l-9-5-9 5v8l9 5 9-5V8z'/><path d='M3 8l9 5 9-5'/><path d='M12 13v10'/></svg></span><h3>Tracked UK delivery</h3><p>Dispatched in 1–2 working days, delivered in 3–5. Free on orders over £40.</p></div><div class='stw-guar__card'><span class='stw-guar__icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><rect x='5' y='11' width='14' height='9' rx='2'/><path d='M8 11V8a4 4 0 0 1 8 0v3'/></svg></span><h3>Secure checkout</h3><p>SSL-encrypted payments processed through Shopify's certified checkout.</p></div><div class='stw-guar__card'><span class='stw-guar__icon'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M21 12a8 8 0 0 1-8 8H4l2-3a8 8 0 1 1 15-5z'/></svg></span><h3>Real people to talk to</h3><p>Questions before or after you buy? Our team replies within one working day.</p></div></div></div>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
