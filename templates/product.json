{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "stw_trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<ul class=\"stw-pdp-trust\" aria-label=\"Delivery and returns highlights\"><li>30-day returns</li><li>Free UK delivery over &pound;40</li><li>Tracked shipping</li></ul>"
          }
        },
        "stw_tab_delivery": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery & returns",
            "icon": "truck",
            "content": "<p>UK standard delivery is £4.99 (3–5 working days) and free on orders over £40. Express delivery (1–2 working days) is £6.99. You have 30 days from delivery to change your mind, on top of your 14-day legal right to cancel. Full details in our <a href=\"/policies/shipping-policy\">Shipping Policy</a> and <a href=\"/policies/refund-policy\">Refund Policy</a>.</p>",
            "page": ""
          }
        },
        "stw_tab_use": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How to use & care",
            "icon": "heart",
            "content": "<p>Each product arrives with simple instructions. Start with the gentlest setting and short sessions, and build up as feels comfortable. Wipe clean with a dry or slightly damp cloth; don't submerge electrical items in water. If you have a health condition, a pacemaker, or you're unsure whether a product is right for you, please check with your GP or pharmacist first.</p>",
            "page": ""
          }
        },
        "stw_buy_now": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"stw-buy-now-wrap\"><form method=\"post\" action=\"{{ routes.cart_add_url }}\" class=\"stw-buy-now-form\" novalidate><input type=\"hidden\" name=\"id\" value=\"{{ product.selected_or_first_available_variant.id }}\"><input type=\"hidden\" name=\"quantity\" value=\"1\"><input type=\"hidden\" name=\"return_to\" value=\"/checkout\"><button type=\"submit\" class=\"button stw-buy-now\"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>Buy it now</button></form></div><script>document.addEventListener(\"submit\",function(e){var f=e.target;if(!f.classList||!f.classList.contains(\"stw-buy-now-form\"))return;var s=document.querySelector('form[data-type=\"add-to-cart-form\"] input[name=\"id\"]');if(s&&s.value)f.querySelector('input[name=\"id\"]').value=s.value;var q=document.querySelector(\".quantity__input\");if(q&&q.value)f.querySelector('input[name=\"quantity\"]').value=q.value;},true);</script>"
          }
        },
        "stw_complementary": {
          "type": "complementary",
          "settings": {
            "block_heading": "Pairs well with",
            "make_collapsible_row": false,
            "icon": "price-tag",
            "product_list_limit": 2,
            "products_per_page": 2,
            "pagination_style": "counter",
            "image_ratio": "square",
            "enable_quick_add": true
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "stw_buy_now",
        "stw_trust",
        "description",
        "stw_tab_delivery",
        "stw_tab_use",
        "stw_complementary",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}