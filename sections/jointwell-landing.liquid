  #jw-page .spec strong{display:block;font-family:var(--font-display);font-size:15px;margin-bottom:5px}
  #jw-page .spec span{color:var(--ink-soft)}

  #jw-page .details{display:grid;gap:16px;margin-top:30px}
  @media(min-width:760px){#jw-page .details{grid-template-columns:repeat(3,1fr)}}
  #jw-page .details figure{border:1px solid var(--line);border-radius:var(--radius-card);overflow:hidden;background:#fff;box-shadow:var(--shadow-soft)}
  #jw-page .details img{width:100%;height:auto;display:block}
  #jw-page .details figcaption{padding:14px 16px 16px}
  #jw-page .details figcaption b{display:block;font-family:var(--font-display);font-size:15px;margin-bottom:4px}
  #jw-page .details figcaption span{font-size:13.5px;color:var(--ink-soft);line-height:1.5}
  #jw-page .founder{border:1px dashed #c9bfb2;border-radius:var(--radius-card);background:#fff;padding:26px;margin-top:34px}
  #jw-page .founder .tag{font-size:11px;font-weight:800;letter-spacing:.08em;color:#8a8177;text-transform:uppercase;margin-bottom:10px}
  #jw-page .founder p{font-size:15.5px;color:var(--ink-soft);margin-bottom:10px}

  #jw-page .gbox{max-width:680px;margin:34px auto 0;border:2px solid var(--ember);border-radius:var(--radius-card);padding:30px;text-align:center;background:#fff;box-shadow:var(--shadow-soft)}
  #jw-page .gbox h3{font-size:24px;font-weight:800;margin-bottom:10px}
