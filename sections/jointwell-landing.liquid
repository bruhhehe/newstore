    {
      "type": "number",
      "id": "bundle_discount",
      "label": "4-wrap bundle discount (pence)",
      "default": 2000,
      "info": "Fixed amount taken off the 4-wrap tile only, mirroring the ORDER-class automatic discount in admin ('4-wrap bundle'). 1000 = £10. If you change one, change the other, or the page will show a total checkout won't charge."
    },
    {
      "type": "text",
      "id": "sale_end",
      "label": "Sale end (ISO date-time)",
      "default": "2026-09-01T23:59:59+01:00",
      "info": "Countdown target. Must match the discounts' end date in admin."
    },
    {
      "type": "header",
      "content": "Temperature"
    },
    {
      "type": "number",
      "id": "temp_min",
      "label": "Lowest heat level (°C)",
      "default": 45
    },
    {
      "type": "number",
      "id": "temp_max",
      "label": "Highest heat level (°C)",
      "default": 65,
      "info": "NOT YET MEASURED. Every temperature on the page renders from this. Test a real unit with an IR thermometer and put the true figure here before running ads. The previous device's supplier sheet said 60°C while its own graphic said 50°C."
    },
    {
      "type": "text",
      "id": "temp_steps",
      "label": "Heat steps, as written",
      "default": "45, 50, 55, 60 and 65",
      "info": "Shown in the how-to-use steps. Keep in step with the two figures above."
    },
    {
      "type": "header",
      "content": "Trust & legal"
    },
    {
      "type": "url",
      "id": "cert_ce_url",
      "label": "CE certificate PDF (Shopify Files URL)",
      "info": "Upload 'tst certificate of compliance.pdf' under Content > Files, paste the URL here, and the CE badge becomes a link. Leave empty to show the badge unlinked."
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Verified review count (optional)",
      "info": "Leave empty until you have a real, reconciled number. Never guess."
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder first name"
    },
    {
      "type": "richtext",
      "id": "founder_note",
      "label": "Founder note (true story only)",
      "info": "Hidden until filled. Paste the real, verified founder story (~120 words) — never an invented one (CMA/DMCC risk)."
    },
    {
      "type": "text",
      "id": "company_number",
      "label": "Company number (optional)"
    }
  ],
  "presets": [{ "name": "Jointwell Landing" }]
}
