        { "type": "textarea", "id": "quote", "label": "The review", "info": "Shown in full in the reviews grid." },
        { "type": "textarea", "id": "short", "label": "The line for the hero carousel", "info": "One sentence. Any longer and it wraps past the box." },
        { "type": "text", "id": "name", "label": "First name", "default": "Sarah" },
        { "type": "text", "id": "age", "label": "Age" },
        { "type": "text", "id": "town", "label": "Town" },
        { "type": "text", "id": "carousel_name", "label": "Name for the carousel", "info": "The first-name-and-initial form, e.g. Sarah L. Falls back to the first name." },
