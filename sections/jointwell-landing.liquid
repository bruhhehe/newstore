{
  "name": "Jointwell Landing",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "The joint massager product the buy buttons add to cart. Falls back to handle 'jointwell-heated-joint-massager' if unset."
    },
    {
      "type": "checkbox",
      "id": "show_protection",
      "label": "Offer the priority handling add-on",
      "default": true,
      "info": "Only tick this if you will genuinely submit and pay these orders to CJ ahead of the rest, every working day. The promise is deliberately scoped to what you control (order goes in first, chased, fee refunded if dispatch takes over 3 working days) — do NOT reword it into a next-day dispatch or delivery guarantee, which the warehouse, not you, decides."
    },
    {
      "type": "text",
      "id": "condition_lead",
      "label": "Condition list heading",
      "default": "Most often used for:",
      "info": "Keep it factual about WHO buys it. Do not change to 'Helps with' or 'Treats' — naming a condition after those verbs is a medical claim (ASA/CAP Section 12) and is what gets ads banned."
    },
    {
      "type": "textarea",
      "id": "condition_chips",
      "label": "Conditions (comma separated)",
      "default": "Cold mornings, Damp winter weather, Kneeling on site, Ten-hour shifts, Long days on your feet, After training, After the garden, Long drives, After a long walk, Before bed",
      "info": "Shown as chips under the subhead. Leave empty to hide the whole block."
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "Show the stock bar",
      "default": false,
      "info": "Shows the text below. If you switch inventory tracking on in Shopify and stock drops to the threshold, it upgrades itself to the real count."
    },
    {
      "type": "text",
      "id": "stock_label",
      "label": "Stock bar text",
      "default": "Low stock",
      "info": "Keep it general unless you are tracking real stock. A specific count or a 'today only' claim has to be true (DMCC Act 2024)."
    },
    {
      "type": "number",
      "id": "stock_threshold",
      "label": "Show the bar when stock is at or below",
