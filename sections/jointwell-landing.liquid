        </blockquote>
      </div>
      <div class="split-media">
        <img src="{{ 'th-sofa.jpg' | asset_url }}" alt="A woman in her sixties sitting on a sofa reading the paper, wearing the Jointwell wrap on her knee, with a mug of tea beside her" width="1024" height="1024" loading="lazy" decoding="async">
