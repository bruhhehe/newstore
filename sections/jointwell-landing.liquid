      {%- if blogs.journal.articles_count > 0 -%}
        <a href="{{ routes.root_url }}blogs/journal">Journal</a>
      {%- endif -%}
      <a href="{{ routes.root_url }}pages/contact">Contact</a>
      <a class="jw-track" href="{{ routes.root_url }}pages/track-my-order">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h13v10H3z"/><path d="M16 10h3.5l1.5 3v4h-5"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
        Track my order
      </a>
    </nav>
    <button class="jw-menu-btn" id="jwMenuBtn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="jwMobileNav">
      <span class="jw-burger" aria-hidden="true"></span>
    </button>
  </div>
  <div class="jw-mobile-nav" id="jwMobileNav" hidden>
    <nav class="wrap" aria-label="Mobile">
      <a href="#how">How it works</a>
      <a href="#faq">FAQ</a>
      {%- if blogs.journal.articles_count > 0 -%}
        <a href="{{ routes.root_url }}blogs/journal">Journal</a>
      {%- endif -%}
      <a href="{{ routes.root_url }}pages/contact">Contact</a>
    </nav>
  </div>
</header>

<!-- 3 ▸ BUY BOX -->
