            <img src="{{ 'th-gal-timer.jpg' | asset_img_url: '160x160' }}" alt="" width="76" height="76" loading="lazy" decoding="async">
          </button>
          <button class="thumb" aria-pressed="false" data-type="img" data-src="{{ 'th-in-box.jpg' | asset_url }}" data-alt="In the box: the wrap, a USB-C charging cable and an instruction manual, in the branded box" aria-label="Photo 8: what is in the box">
