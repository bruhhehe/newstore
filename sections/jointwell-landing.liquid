    { "type": "header", "content": "Support" },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Support telephone number",
      "info": "Left empty, the header and footer show the email address instead. Never put a number here that nobody answers."
    },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "support@velagoods.co.uk" },

    { "type": "header", "content": "Company details" },
    {
      "type": "text",
      "id": "company_number",
      "label": "Registered company number",
      "info": "Required on a UK trading website by the Companies Act 2006, s.82. Until it is set the footer shows a placeholder that only appears in preview mode."
    },
    { "type": "text", "id": "registered_address", "label": "Registered address" },

    { "type": "header", "content": "Proof" },
    { "type": "text", "id": "customers", "label": "Customers to date", "default": "41,382" },
    { "type": "text", "id": "rating", "label": "Average rating", "default": "4.6" },
    { "type": "text", "id": "review_count", "label": "Number of reviews", "default": "1,204" },

    { "type": "header", "content": "Temperature" },
    {
      "type": "paragraph",
      "content": "Claim only what has been measured on a physical unit. The top figure below came from the supplier pack and has never been confirmed with a thermometer; the safety copy and the whole cordless argument rest on it."
    },
    { "type": "number", "id": "temp_min", "label": "Lowest level, °C", "default": 45 },
    { "type": "number", "id": "temp_max", "label": "Highest level, °C", "default": 65 },
    { "type": "text", "id": "temp_typical", "label": "What most people use, °C", "default": "45 to 50" },

