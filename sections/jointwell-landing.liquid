  /* ============ FAQ ============ */
  #jw-page .faq{max-width:720px;margin:34px auto 0}
  #jw-page .faq-item{border:1px solid var(--line);border-radius:var(--radius-card);margin-bottom:10px;background:#fff;overflow:hidden}
  #jw-page .faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;gap:14px;background:none;border:none;font:inherit;font-weight:700;font-size:15.5px;text-align:left;padding:17px 18px;cursor:pointer}
