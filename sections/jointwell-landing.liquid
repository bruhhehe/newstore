    },
    { "type": "number", "id": "value_strap", "label": "Extension strap", "default": 900 },
    { "type": "number", "id": "value_cable", "label": "USB-C cable", "default": 600 },
    { "type": "number", "id": "value_card", "label": "Routine card", "default": 300 },
    { "type": "number", "id": "value_brace_one", "label": "One compression brace", "default": 2500 },
    { "type": "number", "id": "value_brace_two", "label": "Two compression braces", "default": 5000 },

    { "type": "header", "content": "What it is compared against" },
    { "type": "number", "id": "compare_physio", "label": "One physio session, in pence", "default": 5000 },
    { "type": "number", "id": "compare_injection", "label": "One private injection, in pence", "default": 25000 },

    { "type": "header", "content": "Payment" },
