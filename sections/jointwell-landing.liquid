<script>
(function(){
  var page=document.getElementById('jw-page');
  var reduceMotion=window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var saleEnded=false;

  // ---- sale expiry ----
  // There is no longer a visible countdown, but the page still has to stop
  // showing sale prices if the deadline passes while the tab is open.
  function endSale(){
    if(saleEnded)return; saleEnded=true;
    page.querySelectorAll('.sale-only').forEach(function(el){el.style.display='none';});
    // the announce bar carries the launch-price line during a sale, so restore
    // its standing message rather than leaving an empty bar on expiry
    page.querySelectorAll('[data-sale-off]').forEach(function(el){el.hidden=false;});
  }
  {%- if sale_on %}
  (function(){
    var end=new Date({{ sale_end | json }}).getTime();
    if(isNaN(end)) return;
    var left=end-Date.now();
    if(left<=0){ endSale(); return; }
    // setTimeout is unreliable over very long delays, and a tab open for days
    // will have been reloaded anyway; only arm it inside the last day
    if(left<864e5){ window.setTimeout(endSale,left); }
  })();
  {%- endif %}

  var ctaOriginalHTML=null;   // label captured at click, restored on bfcache

  // ---- mobile menu ----
  var menuBtn=document.getElementById('jwMenuBtn');
  var mobileNav=document.getElementById('jwMobileNav');
  if(menuBtn&&mobileNav){
    var menuTimer=null;
    var setMenu=function(open){
      if(menuTimer){ clearTimeout(menuTimer); menuTimer=null; }
      menuBtn.setAttribute('aria-expanded',open?'true':'false');
      menuBtn.setAttribute('aria-label',open?'Close menu':'Open menu');
      if(open){
        mobileNav.hidden=false;
        // one frame with hidden removed so max-height has a start value to animate from
        if(reduceMotion){ mobileNav.classList.add('is-open'); }
        else{ requestAnimationFrame(function(){ mobileNav.classList.add('is-open'); }); }
      }else{
        mobileNav.classList.remove('is-open');
        if(reduceMotion){ mobileNav.hidden=true; }
        else{ menuTimer=setTimeout(function(){ mobileNav.hidden=true; },340); }
      }
    };
    menuBtn.addEventListener('click',function(){
      setMenu(mobileNav.hidden||!mobileNav.classList.contains('is-open'));
    });
    // close once a link is taken, otherwise the panel covers the target
    mobileNav.addEventListener('click',function(e){
      if(e.target.tagName==='A') setMenu(false);
    });
    document.addEventListener('keydown',function(e){
      if(e.key==='Escape'&&!mobileNav.hidden){ setMenu(false); menuBtn.focus(); }
    });
    // if the viewport grows past the breakpoint the panel would be stranded open
    window.addEventListener('resize',function(){
      if(window.innerWidth>520&&!mobileNav.hidden) setMenu(false);
    });
  }

  // ---- scroll reveal + header lift ----
  // Gated on IntersectionObserver and reduced-motion: if either is missing the
  // .js-anim class is never added, so [data-rv] keeps its default visibility.
  if(!reduceMotion && 'IntersectionObserver' in window){
    var groups=[];
    Array.prototype.forEach.call(page.querySelectorAll('section'),function(sec){
      if(sec.id==='buy') return;                       // above the fold, never hide it
      var box=sec.querySelector('.wrap')||sec;
      var kids=Array.prototype.slice.call(box.children).filter(function(k){
        return k.offsetParent!==null||k.getClientRects().length;
      });
      groups.push(kids.length>1&&kids.length<=8?kids:[sec]);
    });

    var revealed=[];
    groups.forEach(function(g){
      g.forEach(function(el,i){
        el.setAttribute('data-rv','');
        el.style.transitionDelay=Math.min(i,5)*70+'ms';
        revealed.push(el);
      });
    });

    if(revealed.length){
      page.classList.add('js-anim');
      var io=new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){ en.target.classList.add('is-in'); io.unobserve(en.target); }
        });
      },{threshold:0.12,rootMargin:'0px 0px -6% 0px'});
      revealed.forEach(function(el){ io.observe(el); });
      // safety net: if anything is still hidden after 3s, show it
      setTimeout(function(){
        revealed.forEach(function(el){ el.classList.add('is-in'); });
      },3000);
    }
  }

  var headEl=page.querySelector('header.jw-head');
  if(headEl){
    var mqMobile=window.matchMedia('(max-width:879px)');
    var ticking=false, lastY=window.pageYOffset, hideAfter=90;
    var onScroll=function(){
      if(ticking) return;
      ticking=true;
      requestAnimationFrame(function(){
        var y=window.pageYOffset;
        headEl.classList.toggle('is-stuck',y>8);
        if(!mqMobile.matches){
          headEl.classList.remove('is-hidden');   // desktop stays pinned
          lastY=y; ticking=false; return;
        }
        var dy=y-lastY;
        // ignore sub-pixel jitter, otherwise the bar flickers on trackpads
        if(Math.abs(dy)>6){
          // never retract while the dropdown is open, it would drag the
          // open panel off screen with it
          var menuOpen=mobileNav&&!mobileNav.hidden;
          if(dy>0&&y>hideAfter&&!menuOpen){ headEl.classList.add('is-hidden'); }
          else if(dy<0){ headEl.classList.remove('is-hidden'); }
          lastY=y;
        }
        if(y<=hideAfter){ headEl.classList.remove('is-hidden'); }
        ticking=false;
      });
    };
    window.addEventListener('scroll',onScroll,{passive:true});
    // keyboard users tabbing into a retracted header need it back
    headEl.addEventListener('focusin',function(){ headEl.classList.remove('is-hidden'); });
    onScroll();
  }

  // ---- experts carousel (looping) ----
  var exTrack=document.getElementById('expertsTrack');
  var exPrev=document.getElementById('expertsPrev');
  var exNext=document.getElementById('expertsNext');
  if(exTrack&&exPrev&&exNext){
    var exCards=Array.prototype.slice.call(exTrack.querySelectorAll('.expert'));
    var exGap=function(){
      var cs=getComputedStyle(exTrack);
      return parseInt(cs.columnGap||cs.gap,10)||20;
    };
    var exStep=function(){
      var c=exTrack.querySelector('.expert');
      return c ? c.offsetWidth+exGap() : exTrack.clientWidth;
    };
    // width of one full set of the original cards
    var exSetWidth=function(){ return exCards.length*exStep(); };

    // Only loop if the set actually overflows; cloning a set that already
    // fits would just create a scrollbar where none is needed.
    var exLooping = exSetWidth() > exTrack.clientWidth + 1;

    if(exLooping){
      // one clone set either side, so there is always content to scroll into
      var before=document.createDocumentFragment(), after=document.createDocumentFragment();
      exCards.forEach(function(c){
        var a=c.cloneNode(true), b=c.cloneNode(true);
        a.classList.add('is-clone'); b.classList.add('is-clone');
        a.setAttribute('aria-hidden','true'); b.setAttribute('aria-hidden','true');
        before.appendChild(a); after.appendChild(b);
      });
      exTrack.insertBefore(before, exTrack.firstChild);
      exTrack.appendChild(after);
      exTrack.scrollLeft = exSetWidth();          // start on the real set

      var exSettle=null;
      var exNormalise=function(){
        var set=exSetWidth();
        var x=exTrack.scrollLeft;
        if(x < set*0.5 || x > set*1.5){
          // snap must be off for the silent jump, or it fights the reposition
          var snap=exTrack.style.scrollSnapType;
          exTrack.style.scrollSnapType='none';
          exTrack.scrollLeft = x < set*0.5 ? x+set : x-set;
          exTrack.style.scrollSnapType=snap||'';
        }
      };
      exTrack.addEventListener('scroll',function(){
        if(exSettle) clearTimeout(exSettle);
        exSettle=setTimeout(exNormalise,120);     // only reposition once scrolling stops
      },{passive:true});
      window.addEventListener('resize',function(){ exTrack.scrollLeft=exSetWidth(); });
    }

    var exGo=function(dir){
      var left=exTrack.scrollLeft+dir*exStep();
      if(!exLooping){
        // no clones: wrap around the ends instead of stopping dead
        var max=exTrack.scrollWidth-exTrack.clientWidth;
        if(left<-1) left=max;
        else if(left>max+1) left=0;
      }
      if(exTrack.scrollTo){ exTrack.scrollTo({left:left,behavior:reduceMotion?'auto':'smooth'}); }
      else{ exTrack.scrollLeft=left; }
    };
    exPrev.addEventListener('click',function(){exGo(-1)});
    exNext.addEventListener('click',function(){exGo(1)});
  }

  // ---- gallery: image/video swapper ----
  var main=document.getElementById('galleryMain');
  // Play the clip when the gallery is on screen and pause it when it is not,
  // so it starts on scroll rather than only at the moment of selection, and
  // does not carry on playing to an empty room further down the page.
  var galleryVis=null;
  if('IntersectionObserver' in window && main){
    galleryVis=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        var v=main.querySelector('video');
        if(!v) return;
        if(e.isIntersecting){
          if(!reduceMotion) v.play().catch(function(){});
        }else{
          try{ v.pause(); }catch(err){}
        }
      });
    },{threshold:0.5});
    galleryVis.observe(main);
  }

  var thumbs=page.querySelectorAll('.thumb');
  var thumbList=Array.prototype.slice.call(thumbs);
  var strip=page.querySelector('.thumbs');
  var curIdx=0;

  function isVideoThumb(t){ return t.getAttribute('data-type')==='video'; }

  function scrollThumbIntoView(t){
    if(!strip) return;
    var target=t.offsetLeft-(strip.clientWidth-t.offsetWidth)/2;
    target=Math.max(0,Math.min(target,strip.scrollWidth-strip.clientWidth));
    if(strip.scrollTo){ strip.scrollTo({left:target,behavior:reduceMotion?'auto':'smooth'}); }
    else{ strip.scrollLeft=target; }
  }

  var swapToken=0;   // guards against a slower earlier swap landing last

  function showMedia(t){
    thumbs.forEach(function(x){x.setAttribute('aria-pressed','false')});
    t.setAttribute('aria-pressed','true');
    curIdx=thumbList.indexOf(t);
    scrollThumbIntoView(t);

    var token=++swapToken;

    var commit=function(el){
      if(token!==swapToken) return;      // a newer click already won

      // drop any overlay still mid-fade from a rapid previous swap
      var stale=main.querySelectorAll('.gm-out');
      Array.prototype.forEach.call(stale,function(s){ if(s.parentNode===main) main.removeChild(s); });

      var old=main.firstElementChild;
      main.appendChild(el);
      if(el.tagName==='VIDEO'&&!reduceMotion){ el.play().catch(function(){}); }

      if(old){
        if(reduceMotion){
          main.removeChild(old);
        }else{
          if(old.tagName==='VIDEO'){ try{old.pause();}catch(e){} }
          old.classList.add('gm-out');
          void old.offsetWidth;              // force reflow so the transition runs
          old.classList.add('is-fading');
          window.setTimeout(function(){
            if(old.parentNode===main) main.removeChild(old);
          },460);
        }
      }
    };

    if(isVideoThumb(t)){
      main.classList.add('is-video');
      var v=document.createElement('video');
      v.src=t.getAttribute('data-src');
      v.poster=t.getAttribute('data-poster')||'';
      v.muted=true; v.loop=true; v.playsInline=true; v.setAttribute('playsinline','');
      v.controls=true; v.preload='metadata';
      commit(v);                            // the poster shows immediately
      return;
    }

    main.classList.remove('is-video');
    var img=new Image();
    img.alt=t.getAttribute('data-alt')||'';
    img.src=t.getAttribute('data-src');

    // Only swap once the bitmap is ready. Appending first meant the fade ran
    // over an empty element and the gallery blanked for a moment.
    if(img.decode){
      img.decode().then(function(){commit(img)}).catch(function(){commit(img)});
    }else if(img.complete){
      commit(img);
    }else{
      img.onload=function(){commit(img)};
      img.onerror=function(){commit(img)};
    }
  }

  // dir: 1 forward, -1 back
  function advance(dir){
    var n=thumbList.length; if(!n) return;
    showMedia(thumbList[(curIdx+dir+n)%n]);
  }

  thumbs.forEach(function(t){ t.addEventListener('click',function(){showMedia(t)}); });

  // Warm the full-size files so a swap is a cache hit rather than a fetch.
  // Deferred to idle so it never competes with the hero or first paint.
  (function preloadGallery(){
    var srcs=[];
    thumbList.forEach(function(t){
      if(isVideoThumb(t)) return;               // the clip stays on-demand
      var u=t.getAttribute('data-src');
      if(u && srcs.indexOf(u)===-1) srcs.push(u);
    });
    if(!srcs.length) return;
    var i=0;
    var next=function(){
      if(i>=srcs.length) return;
      var im=new Image();
      // one at a time, so the queue cannot saturate a phone connection
      im.onload=im.onerror=next;
      im.src=srcs[i++];
    };
    var kick=function(){ next(); };
    if('requestIdleCallback' in window){ requestIdleCallback(kick,{timeout:3000}); }
    else{ window.setTimeout(kick,1200); }
  })();

  var prevBtn=document.getElementById('galleryPrev');
  var nextBtn=document.getElementById('galleryNext');
  if(prevBtn) prevBtn.addEventListener('click',function(){advance(-1)});
  if(nextBtn) nextBtn.addEventListener('click',function(){advance(1)});

  // The gallery only ever changes on a click. No timer, so nothing to pause
  // on hover, touch or tab-hide, and the video is reachable by the arrows.

  // ---- quantity tiles → prices, CTA label, form quantity, discount code ----
  var tiles=page.querySelectorAll('.tile');
  var priceMain=document.getElementById('priceMain');
  var ctaPrice=document.getElementById('ctaPrice');
  var priceNote=document.getElementById('priceNote');
  var stickyPrice=document.getElementById('stickyPrice');
  var planEl=document.getElementById('jwPlan');
  var planTotalEl=document.getElementById('jwPlanTotal');
  var planUnit=0;
  if(planEl){
    // parse the unit price once from the rendered money string
    planUnit=parseFloat((planEl.getAttribute('data-price')||'').replace(/[^0-9.]/g,''))||0;
  }
  function money(n){ return '\u00a3'+(n%1===0?n.toFixed(0):n.toFixed(2)); }
  function packTotal(){
    var t=page.querySelector('.tile[aria-pressed="true"]');
    if(!t)return 0;
    return parseFloat((t.getAttribute('data-total')||'').replace(/[^0-9.]/g,''))||0;
  }
  // CTA and sticky bar always show what the customer will actually be charged,
  // so ticking the add-on can never surprise them at checkout.
  function refreshPlan(){
    var checked = !!(planEl && planEl.checked);
    if(planTotalEl){
      // flat fee per order — deliberately does NOT multiply by pack size
      planTotalEl.style.opacity = checked ? '1' : '.6';
    }
    var grand = packTotal() + (checked ? planUnit : 0);
    if(ctaPrice) ctaPrice.textContent = money(grand);
    var t=page.querySelector('.tile[aria-pressed="true"]');
    if(stickyPrice && t){
      stickyPrice.textContent = money(grand) + ' \u00b7 ' + (t.getAttribute('data-sticky')||'').split('\u00b7').pop().trim();
    }
    if(priceNote && t){
      priceNote.textContent = t.getAttribute('data-note') + (checked ? ' \u00b7 incl. priority handling' : '');
    }
  }
  if(planEl){ planEl.addEventListener('change',refreshPlan); }

  // Stock bar: shows the real Shopify inventory for the selected pack, and
  // only when it is at or under the threshold. No number, no bar.
  var stockBar=document.getElementById('stockBar');
  var stockText=document.getElementById('stockText');
  var stockThreshold=parseInt({{ section.settings.stock_threshold | default: 25 | json }},10)||25;
  function updateStock(tile){
    if(!stockBar||!stockText||!tile)return;
    var raw=tile.getAttribute('data-stock');
    var n=(raw===null||raw==='')?null:parseInt(raw,10);
    if(n!==null&&!isNaN(n)&&n>0&&n<=stockThreshold){
      stockText.textContent='Only '+n+' left in stock';
    }else{
      stockText.textContent=stockBar.getAttribute('data-label');
    }
  }

  function select(tile){
    tiles.forEach(function(x){x.setAttribute('aria-pressed','false');x.setAttribute('aria-checked','false')});
    tile.setAttribute('aria-pressed','true');tile.setAttribute('aria-checked','true');
    priceMain.textContent=tile.getAttribute('data-total');
    updateStock(tile);
    var vEl=document.getElementById('lpVariant');
    if(vEl){ vEl.value=tile.getAttribute('data-variant'); }
    refreshPlan();
  }
  tiles.forEach(function(t){t.addEventListener('click',function(){select(t)})});
  // Single is the server-rendered default; sync JS state to it.
  refreshPlan();
  updateStock(page.querySelector('.tile[aria-pressed="true"]'));

  // ---- add to cart: AJAX, then auto-apply the pack's sale code ----
  var form=document.getElementById('lpBuyForm');
  if(form){
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var btn=document.getElementById('mainCta');
      if(ctaOriginalHTML===null){ ctaOriginalHTML=btn.innerHTML; }
      btn.disabled=true; btn.style.opacity='.75';
      btn.textContent='Adding…';
      var sel = page.querySelector('.tile[aria-pressed="true"]');
      var variantId = parseInt((sel && sel.getAttribute('data-variant')) || {{ v_single.id | json }}, 10);
      // data-units is the LINE quantity: the 4-wrap tile is the Pair variant
      // ordered twice, because CJ only stocks 1pc and 2pc.
      var units = parseInt((sel && sel.getAttribute('data-units')) || '1', 10) || 1;
      var plan = document.getElementById('jwPlan');
      var planId = plan ? parseInt(plan.getAttribute('data-variant'),10) : 0;

      // /cart/update.js sets ABSOLUTE quantities, so zeroing the other known
      // variants replaces the selection in a single round trip. The previous
      // clear.js -> add.js pair meant two sequential waits before the
      // checkout redirect could even start.
      var updates = {};
      updates[{{ v_single.id | json }}] = 0;
      updates[{{ v_pair.id | json }}] = 0;
      if (planId) { updates[planId] = 0; }
      updates[variantId] = units;
      if (plan && plan.checked && planId) {
        // ONE per order: priority dispatch speeds up the whole parcel, so it
        // must not scale with pack size
        updates[planId] = 1;
      }

      fetch('{{ routes.cart_url }}/update.js',{
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify({ updates: updates })
      })
        .then(function(r){ if(!r.ok){throw new Error('update failed')} return r.json(); })
        .then(function(){
          // Summer Sale is an automatic discount, so no /discount/ hop is needed
          window.location.href = '/checkout';
        })
        .catch(function(){ btn.disabled=false; btn.style.opacity='1'; btn.innerHTML=ctaOriginalHTML||btn.innerHTML; form.submit(); });
    });
  }

  // ---- back button: browsers restore this page from bfcache with the
  //      button still disabled from the previous click, which looked broken.
  //      Re-enable it on every restore (and on normal load). ----
  function resetCta(){
    var b=document.getElementById('mainCta');
    if(b){
      b.disabled=false; b.style.opacity='1';
      // bfcache restores the DOM exactly as it was left, i.e. reading
      // "Adding…", so put the captured label back with its price span
      if(ctaOriginalHTML!==null){ b.innerHTML=ctaOriginalHTML; }
    }
  }
  window.addEventListener('pageshow', resetCta);
  resetCta();

  // ---- FAQ accordion ----
  page.querySelectorAll('.faq-q').forEach(function(q){
    q.addEventListener('click',function(){
      var item=q.parentElement, open=item.classList.toggle('open');
      q.setAttribute('aria-expanded',open?'true':'false');
      q.querySelector('.pm').textContent=open?'\u2013':'+';
    });
  });

  // ---- sticky bar: show once buy box scrolls out ----
  var bar=document.getElementById('stickybar');
  var buy=document.getElementById('buy');
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      var visible=entries[0].isIntersecting;
      bar.classList.toggle('show',!visible);
      bar.setAttribute('aria-hidden',visible?'true':'false');
    },{threshold:0.05}).observe(buy);
  }else{bar.classList.add('show');bar.setAttribute('aria-hidden','false');}

  // ---- comparison table: hide right fade when scrolled to the end ----
  var outer=document.getElementById('compareOuter');
  var scroller=document.getElementById('compareScroll');
  if(outer&&scroller){
    var checkEnd=function(){
      var atEnd=scroller.scrollLeft+scroller.clientWidth>=scroller.scrollWidth-8;
      outer.classList.toggle('at-end',atEnd);
    };
    scroller.addEventListener('scroll',checkEnd,{passive:true});
    window.addEventListener('resize',checkEnd);
    checkEnd();
  }

  // ---- unwired CTA (no sellable variant resolved) ----
  var unwired=page.querySelector('#mainCta[data-unwired]');
  if(unwired){
    unwired.addEventListener('click',function(){
      alert('Checkout is not linked yet. In Shopify: Theme editor \u2192 Jointwell Landing \u2192 Product, and pick the massager product.');
    });
  }
})();
</script>

