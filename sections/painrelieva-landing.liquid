{%- comment -%}
  PainRelieva — single-page storefront (feature/thermawell), v2.
  Changes from v1 (owner feedback 18 Aug):
    * Buy box binds to the REAL product (gid …16313, £69) — created via admin
      API. Robust resolution guard: form only renders when a variant exists,
      is available and has a price > 0 (kills the "£0" fallback bug).
    * SUMMER SALE: codes SUMMER10 (10% off 2+) and SUMMER15 (15% off 4+) are
      live in admin, product-scoped, ending 1 Sept 23:59 BST. The page shows
      sale pricing + £ savings ONLY while the sale is on (server-gated by
      date, client-gated by the countdown), and the matching code is applied
      automatically at checkout via /discount/<code>?redirect=/checkout after
      a clear+add — tiles can never show a price checkout won't honour. The
      cart is cleared before each add, so returning to the page and clicking
      again REPLACES the selection instead of stacking quantities. There is
      no cart link in the header: the button goes straight to checkout.
    * Pair (2 wraps) selected by default, "Most popular" badge; family gets
      "Best value". CTA is plain purchase language ("Add to cart") — all
      "trial" wording replaced with "30-day money-back guarantee".
    * Image stretch bug fixed: CSS width:100% + HTML height attr distorted
      images -> height:auto everywhere, object-fit:contain, max-height caps
      so media never fills the whole viewport.
    * Comparison table: sticky first column, right-edge fade that disappears
      at scroll end, swipe hint on mobile.
    * Copy corrected to the supplier spec sheet: heat is ADJUSTABLE 45–60°C
      (resolves the earlier 50°C-vs-60°C conflict), auto shut-off at
      10/15/20 min, fits up to 46 cm (18″), 400 g, breathable neoprene with
      4 jade beads, box = massager + UK plug + extension strap. The supplier
      "Function" list (relieve rheumatoid arthritis / lower heart rate /
      better sleep) is deliberately NOT used — ASA/CAP medical-claim risk.

  MEDIA MAP unchanged (each slot purposeful, LP-template cadence):
    pr-hero.jpg (slot 1 hero) · pr-video-demo.mp4 (slot 2 in-use demo) ·
    pr-fit-measurements.webp (slot 3 fit objection) · pr-box-contents.webp
    (slot 4 contents) · pr-multi-use.jpg (slot 5 versatility) ·
    pr-in-use-heat.jpg (§identification) · pr-thermal-deep-heat.jpg +
    pr-mechanism-dual-action.gif (§mechanism) · pr-video-fit.mp4 (§fit).
{%- endcomment -%}

{%- liquid
  assign lp_product = section.settings.product
  if lp_product == blank or lp_product.id == blank
    assign lp_product = all_products['painrelieva-heated-knee-massager']
  endif
  assign lp_variant = lp_product.first_available_variant

  assign wired = false
  if lp_variant and lp_variant.available and lp_variant.price > 0
    assign wired = true
    assign unit_cents = lp_variant.price
  else
    assign unit_cents = 6900
  endif

  comment
    Summer sale gate: on only when enabled, codes present and now < end.
    Section markup may be cached a few minutes past expiry; the countdown JS
    hides sale UI at zero for anyone mid-visit.
  endcomment
  assign sale_end = section.settings.sale_end | default: '2026-09-01T23:59:59+01:00'
  assign now_s = 'now' | date: '%s' | plus: 0
  assign end_s = sale_end | date: '%s' | plus: 0
  assign sale_on = false
  if section.settings.sale_enabled and section.settings.code_pair != blank and section.settings.code_family != blank and now_s < end_s
    assign sale_on = true
  endif

  assign x2_cents = unit_cents | times: 2
  assign x4_cents = unit_cents | times: 4
  if sale_on
    assign pair_cents = x2_cents | times: 0.9 | round
    assign fam_cents = x4_cents | times: 0.85 | round
  else
    assign pair_cents = x2_cents
    assign fam_cents = x4_cents
  endif
  assign pair_save = x2_cents | minus: pair_cents
  assign fam_save = x4_cents | minus: fam_cents
  assign pair_each = pair_cents | divided_by: 2
  assign fam_each = fam_cents | divided_by: 4

  assign unit_disp = unit_cents | money_without_trailing_zeros
  assign pair_disp = pair_cents | money_without_trailing_zeros
  assign fam_disp = fam_cents | money_without_trailing_zeros
  assign pair_each_disp = pair_each | money_without_trailing_zeros
  assign fam_each_disp = fam_each | money_without_trailing_zeros
  assign pair_save_disp = pair_save | money_without_trailing_zeros
  assign fam_save_disp = fam_save | money_without_trailing_zeros
  assign x2_disp = x2_cents | money_without_trailing_zeros
  assign x4_disp = x4_cents | money_without_trailing_zeros
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&display=swap" rel="stylesheet">

<style>
  :root{
    --ink:#141311;
    --ink-soft:#5d5852;
    --paper:#ffffff;
    --paper-warm:#faf6f1;
    --line:#e6e0d8;
    --ember:#c8500f;
    --ember-hi:#e0631b;
    --ember-tint:#fdeee3;
    --radius-btn:10px;
    --radius-card:14px;
    --maxw:1080px;
    --shadow-soft:0 1px 2px rgba(20,19,17,.05),0 8px 24px rgba(20,19,17,.05);
    --font-display:'Archivo',system-ui,sans-serif;
    --font-body:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  }
  #pr-page, #pr-page *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    #pr-page *,#pr-page *::before,#pr-page *::after{animation:none!important;transition:none!important}
  }
  body{margin:0;background:var(--paper)}
  #pr-page{font-family:var(--font-body);color:var(--ink);background:var(--paper);line-height:1.55;font-size:16px}
  /* height:auto is load-bearing: HTML width/height attrs otherwise distort
     any image given width:100% in CSS (the v1 stretch bug). */
  #pr-page img,#pr-page svg,#pr-page video{max-width:100%;height:auto;display:block}
  #pr-page a{color:inherit}
  #pr-page h1,#pr-page h2,#pr-page h3{font-family:var(--font-display);line-height:1.12;letter-spacing:-0.01em}
  #pr-page h2{font-size:clamp(26px,4.5vw,38px);text-align:center;font-weight:800}
  #pr-page h2 em{font-style:normal;color:var(--ember)}
  #pr-page .wrap{max-width:var(--maxw);margin:0 auto;padding:0 18px}
  #pr-page section{padding:56px 0}
  #pr-page .eyebrow{display:inline-block;font-family:var(--font-display);font-weight:700;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--ember);background:var(--ember-tint);border:1px solid var(--ember);border-radius:999px;padding:4px 12px;margin-bottom:14px}
  #pr-page .center{text-align:center}
  #pr-page .lede{max-width:640px;margin:14px auto 0;text-align:center;color:var(--ink-soft);font-size:17px}

  /* ============ announcement strip ============ */
  #pr-page .announce{background:var(--ink);color:#fff;text-align:center;font-size:13px;padding:9px 14px;font-weight:600}
  #pr-page .announce span{color:#f0b48d}
  #pr-page .announce .pr-timer{font-variant-numeric:tabular-nums;color:#fff;background:rgba(200,80,15,.35);border-radius:6px;padding:1px 7px;margin-left:4px}

  /* ============ header ============ */
  #pr-page header.pr-head{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
  #pr-page .header-in{display:flex;align-items:center;justify-content:space-between;height:58px}
  #pr-page .header-in nav.pr-nav{margin-left:auto}
  #pr-page .logo{display:block;text-decoration:none}
  #pr-page .logo img{height:22px;width:auto}
  #pr-page nav.pr-nav{display:flex;gap:22px;font-size:14px;font-weight:600}
  #pr-page nav.pr-nav a{text-decoration:none;color:var(--ink-soft)}
  #pr-page nav.pr-nav a:hover,#pr-page nav.pr-nav a:focus-visible{color:var(--ink)}
  #pr-page .cart{font-size:13px;font-weight:700;border:1px solid var(--line);border-radius:var(--radius-btn);padding:8px 13px;text-decoration:none}
  @media(max-width:640px){#pr-page nav.pr-nav{display:none}}

  /* ============ buy box ============ */
  #pr-page .buybox{display:grid;gap:34px;padding-top:26px}
  @media(min-width:880px){#pr-page .buybox{grid-template-columns:1.05fr .95fr;align-items:start}}
  #pr-page .gallery-main{aspect-ratio:1/1;max-height:480px;width:100%;border:1px solid var(--line);border-radius:var(--radius-card);overflow:hidden;background:var(--paper-warm);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-soft)}
  #pr-page .gallery-main.is-video{aspect-ratio:16/9;max-height:420px}
  #pr-page .gallery-main img,#pr-page .gallery-main video{width:100%;height:100%;object-fit:contain}
  #pr-page .thumbs{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:8px}
  #pr-page .thumb{position:relative;aspect-ratio:1/1;border:1px solid var(--line);border-radius:8px;background:#f4efe8;cursor:pointer;overflow:hidden;padding:0;transition:transform .12s ease,border-color .12s ease}
  #pr-page .thumb:hover{transform:translateY(-1px)}
  #pr-page .thumb img{width:100%;height:100%;object-fit:cover}
  #pr-page .thumb .t-tag{position:absolute;left:0;right:0;bottom:0;background:rgba(20,19,17,.62);color:#fff;font-size:9px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;padding:2px 3px;text-align:center;line-height:1.25}
  #pr-page .thumb .t-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:26px;height:26px;border-radius:50%;background:rgba(20,19,17,.72);display:flex;align-items:center;justify-content:center}
  #pr-page .thumb .t-play::after{content:"";border-style:solid;border-width:6px 0 6px 10px;border-color:transparent transparent transparent #fff;margin-left:2px}
  #pr-page .thumb[aria-pressed="true"]{border:2px solid var(--ember)}
  #pr-page .thumb:focus-visible{outline:3px solid var(--ember);outline-offset:2px}

  #pr-page .trustline{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;flex-wrap:wrap}
  #pr-page .stars{color:var(--ember);letter-spacing:2px;font-size:15px}
  #pr-page h1{font-size:clamp(28px,5vw,40px);font-weight:800;margin:10px 0 8px}
  #pr-page h1 em{font-style:normal;color:var(--ember)}
  #pr-page .subhead{color:var(--ink-soft);font-size:17px;margin-bottom:16px}
  #pr-page .bullets{list-style:none;margin:0 0 18px}
  #pr-page .bullets li{display:flex;gap:10px;align-items:flex-start;padding:5px 0;font-size:15.5px}
  #pr-page .bullets svg{flex:none;margin-top:3px}

  #pr-page .price-row{display:flex;align-items:baseline;gap:12px;margin:6px 0 6px}
  #pr-page .price-now{font-family:var(--font-display);font-weight:800;font-size:32px}
  #pr-page .price-note{font-size:13.5px;color:var(--ink-soft)}

  /* sale chip + countdown */
  #pr-page .sale-chip{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--ember-hi),var(--ember));color:#fff;font-family:var(--font-display);font-weight:800;font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;border-radius:999px;padding:7px 14px;margin:2px 0 12px;box-shadow:0 4px 14px rgba(200,80,15,.28)}
  #pr-page .sale-chip .dot{width:8px;height:8px;border-radius:50%;background:#fff;animation:pr-pulse 1.4s ease infinite}
  @keyframes pr-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.72)}}
  #pr-page .sale-chip .pr-timer{font-variant-numeric:tabular-nums;background:rgba(0,0,0,.22);border-radius:6px;padding:1px 8px;letter-spacing:.02em}
  #pr-page .code-note{font-size:12px;color:var(--ink-soft);margin:-4px 0 14px}
  #pr-page .code-note b{color:var(--ember)}

  /* quantity tiles */
  #pr-page .tiles{display:grid;gap:12px;margin-bottom:14px}
  #pr-page .tile{position:relative;display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;border:1px solid var(--line);border-radius:var(--radius-card);padding:15px 14px;background:#fff;cursor:pointer;text-align:left;font:inherit;width:100%;transition:transform .12s ease,box-shadow .12s ease,border-color .12s ease}
  #pr-page .tile:hover{transform:translateY(-1px);box-shadow:var(--shadow-soft)}
  #pr-page .tile[aria-pressed="true"]{border:2px solid var(--ember);background:var(--ember-tint);box-shadow:0 6px 20px rgba(200,80,15,.14)}
  #pr-page .tile:focus-visible{outline:3px solid var(--ember);outline-offset:2px}
  #pr-page .tile .radio{width:18px;height:18px;border:2px solid #b9b0a4;border-radius:50%;flex:none}
  #pr-page .tile[aria-pressed="true"] .radio{border-color:var(--ember);background:radial-gradient(circle,var(--ember) 0 45%,transparent 50%)}
  #pr-page .tile .t-label{font-weight:700;font-size:15px}
  #pr-page .tile .t-sub{font-size:12.5px;color:var(--ink-soft)}
  #pr-page .tile .t-sub b{color:var(--ember)}
  #pr-page .tile .t-price{text-align:right}
  #pr-page .tile .t-total{font-family:var(--font-display);font-weight:800;font-size:18px}
  #pr-page .tile .t-compare{font-size:12.5px;color:#9a9187;text-decoration:line-through}
  #pr-page .ribbon{position:absolute;top:-11px;right:12px;background:linear-gradient(135deg,var(--ember-hi),var(--ember));color:#fff;font-size:10.5px;font-weight:800;letter-spacing:.08em;padding:3px 10px;border-radius:999px;text-transform:uppercase;box-shadow:0 3px 10px rgba(200,80,15,.3)}
  #pr-page .ribbon.alt{background:var(--ink)}

  #pr-page .cta{display:block;width:100%;background:linear-gradient(135deg,var(--ember-hi),var(--ember));color:#fff;border:none;border-radius:var(--radius-btn);font-family:var(--font-display);font-weight:800;font-size:17px;padding:17px;cursor:pointer;text-align:center;text-decoration:none;box-shadow:0 8px 22px rgba(200,80,15,.28);transition:filter .12s ease,transform .12s ease}
  #pr-page .cta:hover{filter:brightness(.94);transform:translateY(-1px)}
  #pr-page .cta:focus-visible{outline:3px solid var(--ink);outline-offset:2px}
  #pr-page .cta small{display:block;font-family:var(--font-body);font-weight:500;font-size:12.5px;opacity:.85;margin-top:2px}
  #pr-page .guarantee-line{display:flex;gap:8px;align-items:center;justify-content:center;font-size:13.5px;font-weight:600;margin-top:12px;color:var(--ink-soft)}
  #pr-page .payrow{display:flex;gap:7px;justify-content:center;align-items:center;margin-top:14px;flex-wrap:wrap;list-style:none;padding:0}
  #pr-page .payrow li{display:flex}
  #pr-page .payrow .payicon,#pr-page .payrow svg{height:26px;width:auto;border-radius:4px;box-shadow:0 0 0 1px var(--line)}
  #pr-page .certrow{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;list-style:none;padding:0;margin-top:12px}
  #pr-page .certrow li{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;color:var(--ink-soft);border:1px solid var(--line);border-radius:999px;padding:5px 11px;background:#fff}
  #pr-page .certrow svg{color:var(--ember);flex:none}
  #pr-page .certrow a{display:inline-flex;align-items:center;gap:6px;color:inherit;text-decoration:none}
  #pr-page .certrow a:hover{color:var(--ink);text-decoration:underline}

  /* ============ benefit icon row ============ */
  #pr-page .icon-row{display:grid;grid-template-columns:repeat(2,1fr);gap:22px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:30px 0}
  @media(min-width:760px){#pr-page .icon-row{grid-template-columns:repeat(4,1fr)}}
  #pr-page .icon-item{text-align:center;font-size:13.5px;font-weight:600;color:var(--ink-soft)}
  #pr-page .icon-item svg{margin:0 auto 8px}
  #pr-page .icon-item strong{display:block;color:var(--ink);font-size:14.5px;margin-bottom:2px}

  /* ============ empathy / story sections ============ */
  #pr-page .band{background:var(--paper-warm)}
  #pr-page .split{display:grid;gap:30px;align-items:center;margin-top:34px}
  @media(min-width:820px){#pr-page .split{grid-template-columns:1fr 1fr}#pr-page .split.rev>.split-media{order:2}}
  #pr-page .split h3{font-size:clamp(21px,3vw,27px);font-weight:800;margin-bottom:12px}
  #pr-page .split p{color:var(--ink-soft);margin-bottom:12px;font-size:16px}
  #pr-page .split p strong{color:var(--ink)}
  /* media never fills the viewport: contained, capped, letterboxed on white */
  #pr-page .split-media{border:1px solid var(--line);border-radius:var(--radius-card);overflow:hidden;background:#fff;box-shadow:var(--shadow-soft)}
  #pr-page .split-media img,#pr-page .split-media video{width:100%;height:auto;max-height:420px;object-fit:contain}

  #pr-page .fig{background:#fff;border:1px solid var(--line);border-radius:var(--radius-card);padding:22px;box-shadow:var(--shadow-soft)}
  #pr-page .fig>svg{width:100%;height:auto;overflow:visible}
  #pr-page .fig figcaption{font-size:12.5px;color:#8a8177;text-align:center;margin-top:10px}
  #pr-page .fig.fig-media{padding:0;overflow:hidden}
  #pr-page .fig.fig-media img{width:100%;height:auto;max-height:340px;object-fit:contain;background:#fff}
  #pr-page .fig.fig-media figcaption{padding:10px 14px 14px}
  #pr-page .media-duo{display:grid;gap:16px;margin-top:30px}
  @media(min-width:760px){#pr-page .media-duo{grid-template-columns:1fr 1fr}}

  #pr-page blockquote.pull{border-left:3px solid var(--ember);padding:6px 0 6px 18px;margin:18px 0;font-size:17px;font-style:italic}
  #pr-page blockquote.pull footer{font-style:normal;font-size:13px;color:var(--ink-soft);margin-top:6px;font-weight:600}

  /* ============ comparison table ============ */
  #pr-page .swipe-hint{display:none;text-align:center;font-size:12.5px;font-weight:700;color:var(--ember);margin:18px 0 -14px}
  @media(max-width:880px){#pr-page .swipe-hint{display:block}}
  #pr-page .compare-outer{position:relative;margin-top:34px}
  #pr-page .compare-outer .edge-fade{position:absolute;top:0;right:0;bottom:0;width:56px;background:linear-gradient(to left,#fff 15%,rgba(255,255,255,0));pointer-events:none;transition:opacity .2s ease;border-radius:0 var(--radius-card) var(--radius-card) 0}
  #pr-page .compare-outer.at-end .edge-fade{opacity:0}
  #pr-page .compare-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  #pr-page table.compare{border-collapse:separate;border-spacing:0;width:100%;min-width:640px;font-size:14px}
  #pr-page .compare th,#pr-page .compare td{padding:12px 14px;text-align:center;border-bottom:1px solid var(--line)}
  #pr-page .compare th:first-child,#pr-page .compare td:first-child{text-align:left;font-weight:600;min-width:150px;position:sticky;left:0;background:var(--paper);z-index:2;border-right:1px solid var(--line)}
  #pr-page .compare thead th{font-family:var(--font-display);font-weight:800;font-size:13.5px}
  #pr-page .compare .you{background:var(--ember-tint);border-left:2px solid var(--ember);border-right:2px solid var(--ember)}
  #pr-page .compare thead .you{border-top:2px solid var(--ember);border-radius:10px 10px 0 0}
  #pr-page .compare tbody tr:last-child .you{border-bottom:2px solid var(--ember)}
  #pr-page .yes{color:var(--ember);font-weight:800}
  #pr-page .no{color:#b9b0a4;font-weight:700}

  /* ============ reviews ============ */
  #pr-page .reviews{display:grid;gap:16px;margin-top:34px}
  @media(min-width:820px){#pr-page .reviews{grid-template-columns:repeat(2,1fr)}}
  #pr-page .review{border:1px solid var(--line);border-radius:var(--radius-card);padding:20px;background:#fff;box-shadow:var(--shadow-soft)}
  #pr-page .review .stars{font-size:13px}
  #pr-page .review p{font-size:14.5px;margin:10px 0}
  #pr-page .review footer{font-size:12.5px;font-weight:700}
  #pr-page .review footer span{color:var(--ink-soft);font-weight:600}
  #pr-page .review .answers{display:inline-block;margin-top:8px;font-size:11px;font-weight:700;color:var(--ember);background:var(--ember-tint);border-radius:999px;padding:2px 9px}

  /* ============ specs / fit ============ */
  #pr-page .spec-grid{display:grid;gap:14px;margin-top:30px}
  @media(min-width:760px){#pr-page .spec-grid{grid-template-columns:repeat(3,1fr)}}
  #pr-page .spec{border:1px solid var(--line);border-radius:var(--radius-card);padding:18px;background:#fff;font-size:14px;box-shadow:var(--shadow-soft)}
  #pr-page .spec strong{display:block;font-family:var(--font-display);font-size:15px;margin-bottom:5px}
  #pr-page .spec span{color:var(--ink-soft)}

  #pr-page .founder{border:1px dashed #c9bfb2;border-radius:var(--radius-card);background:#fff;padding:26px;margin-top:34px}
  #pr-page .founder .tag{font-size:11px;font-weight:800;letter-spacing:.08em;color:#8a8177;text-transform:uppercase;margin-bottom:10px}
  #pr-page .founder p{font-size:15.5px;color:var(--ink-soft);margin-bottom:10px}

  #pr-page .gbox{max-width:680px;margin:34px auto 0;border:2px solid var(--ember);border-radius:var(--radius-card);padding:30px;text-align:center;background:#fff;box-shadow:var(--shadow-soft)}
  #pr-page .gbox h3{font-size:24px;font-weight:800;margin-bottom:10px}
  #pr-page .gbox p{color:var(--ink-soft);font-size:15.5px;margin-bottom:8px}
  #pr-page .gbox .seal{width:64px;height:64px;margin:0 auto 14px;border:2px solid var(--ember);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;color:var(--ember);font-size:13px;line-height:1.1;text-align:center}

  /* ============ FAQ ============ */
  #pr-page .faq{max-width:720px;margin:34px auto 0}
  #pr-page .faq-item{border:1px solid var(--line);border-radius:var(--radius-card);margin-bottom:10px;background:#fff;overflow:hidden}
  #pr-page .faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;gap:14px;background:none;border:none;font:inherit;font-weight:700;font-size:15.5px;text-align:left;padding:17px 18px;cursor:pointer}
