{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section stw-risk-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .stw-risk-{{ section.id }} .stw-risk-wrap{ max-width:760px; margin:0 auto; padding:76px 24px; text-align:center; }
    .stw-risk-{{ section.id }} .stw-risk-seal{
      width:96px; height:96px; border-radius:50%; margin:0 auto 26px;
      border:2px solid {{ section.settings.accent_color }};
      display:flex; align-items:center; justify-content:center; flex-direction:column;
      color:{{ section.settings.accent_color }}; line-height:1.1;
    }
    .stw-risk-{{ section.id }} .stw-risk-seal .num{ font-family:var(--bp-serif); font-size:30px; font-weight:600; }
    .stw-risk-{{ section.id }} .stw-risk-seal .lbl{ font-size:11px; letter-spacing:.1em; font-weight:700; }
    .stw-risk-{{ section.id }} h2{ font-size:32px; margin-bottom:16px; color:{{ section.settings.text_color }}; }
    .stw-risk-{{ section.id }} p{ font-size:17.5px; line-height:1.65; color:{{ section.settings.text_color }}; opacity:.85; margin:0 auto; max-width:60ch; }
    .stw-risk-{{ section.id }} .stw-risk-steps{
      display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:38px; text-align:left;
    }
    .stw-risk-{{ section.id }} .stw-risk-step{
      background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.2);
      border-radius:var(--bp-radius); padding:20px;
    }
    .stw-risk-{{ section.id }} .stw-risk-step b{
      display:block; font-size:12.5px; letter-spacing:.09em; text-transform:uppercase;
      color:{{ section.settings.accent_color }}; margin-bottom:7px;
    }
    .stw-risk-{{ section.id }} .stw-risk-step span{ font-size:15.5px; color:{{ section.settings.text_color }}; opacity:.9; }
    @media (max-width:700px){
      .stw-risk-{{ section.id }} .stw-risk-wrap{ padding:52px 20px; }
      .stw-risk-{{ section.id }} h2{ font-size:26px; }
      .stw-risk-{{ section.id }} .stw-risk-steps{ grid-template-columns:1fr; }
    }
  </style>
  <div class="stw-risk-wrap">
    <div class="stw-risk-seal">
      <span class="num">30</span>
      <span class="lbl">DAYS</span>
    </div>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="stw-risk-steps">
      <div class="stw-risk-step"><b>Step 1</b><span>Email or ring us — no forms to fill in.</span></div>
      <div class="stw-risk-step"><b>Step 2</b><span>We send you a return label.</span></div>
      <div class="stw-risk-step"><b>Step 3</b><span>Your full refund, back where it came from.</span></div>
    </div>
    {% if section.settings.cta_text != blank %}
      <div style="margin-top:38px;">
        <a class="bp-btn" href="{{ section.settings.cta_link | default: '/#offer' }}">{{ section.settings.cta_text }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "STW Risk reversal",
  "tag": "section",
  "class": "section-stw-risk",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#33483A" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E8B98A" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it for a month. If it's not for you, we'll refund you." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Use it every evening for 30 days. If you don't find it comfortable, send it back for a full refund — no forms, no restocking fee, and no need to explain yourself." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Choose your set" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "STW Risk reversal" }]
}
{% endschema %}
