{% render 'sajda-head' %}

<section class="band">
  <div class="wrap">
    <div class="col">
      <p class="eyebrow">Contact</p>
      <h1>A person answers this.</h1>
      <p class="lede">Not a ticket queue and not a bot. Write to us and one of us replies, usually the same day and almost always within one working day.</p>
    </div>
  </div>
</section>

<section class="band band--white">
  <div class="wrap">
    <div class="grid2" style="align-items:start">

      <div class="card">
        {%- form 'contact', id: 'sajda-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-ok">Thank you — your message has reached us. We'll reply to the email address you gave.</p>
          {%- elsif form.errors -%}
            <div class="form-err">
              <strong>That didn't send.</strong>
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <label for="sajda-name">Your name</label>
          <input type="text" id="sajda-name" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>

          <label for="sajda-email">Email address</label>
          <input type="email" id="sajda-email" name="contact[email]" value="{{ form.email }}" autocomplete="email" spellcheck="false" required>

          <label for="sajda-topic">What's this about?</label>
          <select id="sajda-topic" name="contact[Enquiry type]">
            <option value="A question before ordering">A question before ordering</option>
            <option value="An existing order">An existing order</option>
            <option value="Bulk or masjid order">Bulk or masjid order</option>
            <option value="A return or refund">A return or refund</option>
            <option value="Something else">Something else</option>
          </select>

          <label for="sajda-order">Order number <span style="font-weight:400;color:var(--muted)">(if you have one)</span></label>
          <input type="text" id="sajda-order" name="contact[Order number]" placeholder="e.g. #1042">

          <label for="sajda-body">Your message</label>
          <textarea id="sajda-body" name="contact[body]" required>{{ form.body }}</textarea>

          <button type="submit" class="btn" style="width:100%">Send message</button>
          <p class="form-note">We only use your details to answer you. Nothing else.</p>
        {%- endform -%}
      </div>

      <div>
        <h3 style="margin-top:0">Prefer email?</h3>
        <p>Write to <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a> and it reaches the same inbox as the form.</p>

        <h3>Where's my order?</h3>
        <p>Every order ships tracked and the link is emailed the moment it leaves us. You can also <a href="/pages/track-my-order">track it here</a>.</p>

        <h3>Returns</h3>
        <p>Thirty days from delivery. If you've changed your mind, you pay the return postage; if the stool is faulty or arrived damaged, we cover everything. Email us first and we'll send the return address.</p>

        <h3>Questions about praying seated</h3>
        <p>We'll point you to the references we've read and we're glad to talk — but we're not scholars and won't issue rulings. For your own situation, your imam is the right person to ask.</p>
      </div>

    </div>
  </div>
</section>

<section class="band band--wash" id="bulk">
  <div class="wrap">
    <div class="col">
      <p class="eyebrow">Bulk &amp; masjid orders</p>
      <h2>Ordering six or more?</h2>
      <p>Email us or use the form above and we'll quote you properly rather than run it through a discount code. Tell us roughly how many people you're buying for and which prayers they struggle with — it changes what we'd recommend, and sometimes the answer is fewer than you think.</p>
      <p>We can invoice a masjid or community organisation directly, and we'll confirm lead times before you commit to anything.</p>
      <p style="margin-top:26px">
        <a class="btn" href="#sajda-contact-form" id="bulk-jump">Start a bulk enquiry</a>
      </p>
    </div>
  </div>
</section>

{% render 'sajda-foot' %}

<script>
(function(){
  var sel = document.getElementById('sajda-topic');
  if(!sel) return;
  function pickBulk(){
    for (var i=0;i<sel.options.length;i++){
      if (sel.options[i].value === 'Bulk or masjid order'){ sel.selectedIndex = i; break; }
    }
  }
  // arriving from the homepage's bulk panel, or clicking the button below it
  if (location.hash === '#bulk' || /[?&]topic=bulk/.test(location.search)) pickBulk();
  var jump = document.getElementById('bulk-jump');
  if (jump) jump.addEventListener('click', function(){
    pickBulk();
    var body = document.getElementById('sajda-body');
    if (body && !body.value) body.focus();
  });
})();
</script>

{% schema %}
{
  "name": "Sajda contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "email", "label": "Support email", "default": "support@sajdastool.co.uk" }
  ],
  "presets": [{ "name": "Sajda contact" }]
}
{% endschema %}
