{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "announcement-bar": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% assign stw_sale_end = '2026-09-01' | date: '%s' | plus: 0 %}{% assign stw_now = 'now' | date: '%s' | plus: 0 %}{% if stw_now < stw_sale_end %}<div class=\"stw-announce\" role=\"region\" aria-label=\"Announcement\"><a href=\"/collections/all\">SUMMER SALE &mdash; 20% off everything with code SUMMER20 &middot; ends 31 August</a></div>{% endif %}",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme-1",
        "menu_color_scheme": "scheme-1",
        "logo_position": "middle-left",
        "menu": "main-menu",
        "menu_type_desktop": "dropdown",
        "sticky_header_type": "on-scroll-up",
        "show_line_separator": true,
        "enable_country_selector": false,
        "enable_language_selector": false,
        "enable_customer_avatar": true,
        "mobile_logo_position": "center",
        "margin_bottom": 0,
        "padding_top": 20,
        "padding_bottom": 20
      }
    }
  },
  "order": [
    "announcement-bar",
    "header"
  ]
}