{%- comment -%}
  Jointwell — blog listing.

  Styling is deliberately a trimmed copy of the landing section's tokens rather
  than a shared stylesheet: the landing page is one self-contained section, and
  duplicating ~60 lines of CSS is cheaper than refactoring a working page.

  The page renders three ways with no configuration:
    * articles exist            -> card grid, newest first, paginated
    * blog exists but is empty  -> honest empty state, no filler posts
    * template used off a blog  -> falls back to the 'journal' blog
{%- endcomment -%}

{%- liquid
  assign the_blog = blog
  if the_blog == blank or the_blog.id == blank
    comment
      A filter cannot be used inside a bracket lookup, so resolve the handle
      into its own variable first.
    endcomment
    assign fallback_handle = section.settings.blog_handle | default: 'journal'
    assign the_blog = blogs[fallback_handle]
  endif
  assign has_posts = false
  if the_blog.articles_count > 0
    assign has_posts = true
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&display=swap" rel="stylesheet">

<style>
  :root{
    --ink:#141311; --ink-soft:#5d5852; --paper:#ffffff; --paper-warm:#faf6f1;
    --line:#e6e0d8; --ember:#c8500f; --ember-hi:#e0631b; --ember-tint:#fdeee3;
    --radius-card:14px; --maxw:1080px;
    --shadow-soft:0 1px 2px rgba(20,19,17,.05),0 8px 24px rgba(20,19,17,.05);
    --font-display:'Archivo',system-ui,sans-serif;
    --font-body:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  }
  #jw-blog, #jw-blog *{box-sizing:border-box;margin:0;padding:0}
  body{margin:0;background:var(--paper)}
  #jw-blog{font-family:var(--font-body);color:var(--ink);background:var(--paper);line-height:1.55;font-size:16px}
  #jw-blog img{max-width:100%;height:auto;display:block}
  #jw-blog a{color:inherit}
  #jw-blog h1,#jw-blog h2,#jw-blog h3{font-family:var(--font-display);line-height:1.12;letter-spacing:-.01em}
  #jw-blog .wrap{max-width:var(--maxw);margin:0 auto;padding:0 18px}
  #jw-blog section{padding:56px 0}
  #jw-blog .eyebrow{display:inline-block;font-family:var(--font-display);font-weight:700;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--ember);background:var(--ember-tint);border:1px solid var(--ember);border-radius:999px;padding:4px 12px;margin-bottom:14px}
  #jw-blog .band{background:var(--paper-warm)}
  #jw-blog .center{text-align:center}

  #jw-blog .announce{background:var(--ink);color:#fff;text-align:center;font-size:13px;padding:9px 14px;font-weight:600}
  #jw-blog .announce span{color:#f0b48d}
  #jw-blog header.jw-head{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
  #jw-blog .header-in{display:flex;align-items:center;justify-content:space-between;height:58px}
  #jw-blog .logo img{height:22px;width:auto}
  #jw-blog nav.jw-nav{display:flex;gap:22px;font-size:14px;font-weight:600;margin-left:auto}
  #jw-blog nav.jw-nav a{text-decoration:none;color:var(--ink-soft)}
  #jw-blog nav.jw-nav a:hover{color:var(--ink)}
  @media(max-width:640px){#jw-blog nav.jw-nav{gap:16px;font-size:13px}}

  #jw-blog h1.page{font-size:clamp(30px,5vw,44px);font-weight:800;margin-bottom:10px}
  #jw-blog .lede{max-width:620px;color:var(--ink-soft);font-size:17px}

  #jw-blog .posts{display:grid;gap:20px;margin-top:8px}
  @media(min-width:760px){#jw-blog .posts{grid-template-columns:repeat(2,1fr)}}
  #jw-blog .post{border:1px solid var(--line);border-radius:var(--radius-card);background:#fff;overflow:hidden;box-shadow:var(--shadow-soft);display:flex;flex-direction:column}
  #jw-blog .post .thumb{aspect-ratio:16/9;background:var(--paper-warm);overflow:hidden}
  #jw-blog .post .thumb img{width:100%;height:100%;object-fit:cover}
  #jw-blog .post .body{padding:20px 22px 24px;display:flex;flex-direction:column;gap:8px;flex:1}
  #jw-blog .post time{font-size:12.5px;font-weight:700;color:var(--ink-soft);letter-spacing:.02em}
  #jw-blog .post h2{font-size:20px;font-weight:800}
  #jw-blog .post h2 a{text-decoration:none}
  #jw-blog .post h2 a:hover{color:var(--ember)}
  #jw-blog .post p{font-size:14.5px;color:var(--ink-soft)}
  #jw-blog .post .more{margin-top:auto;font-size:13.5px;font-weight:700;color:var(--ember);text-decoration:none}

  /* empty state */
  #jw-blog .empty{max-width:620px;margin:0 auto;text-align:center;border:1px dashed #d8cec1;border-radius:var(--radius-card);background:#fff;padding:48px 32px}
  #jw-blog .empty h2{font-size:24px;font-weight:800;margin-bottom:10px}
  #jw-blog .empty p{color:var(--ink-soft);font-size:15.5px;margin-bottom:8px}
  #jw-blog .empty .cta{display:inline-block;margin-top:18px;background:linear-gradient(135deg,var(--ember-hi),var(--ember));color:#fff;font-family:var(--font-display);font-weight:800;font-size:15px;padding:14px 26px;border-radius:10px;text-decoration:none;box-shadow:0 8px 22px rgba(200,80,15,.28)}

  #jw-blog .pager{display:flex;gap:10px;justify-content:center;margin-top:34px;font-weight:700;font-size:14px}
  #jw-blog .pager a,#jw-blog .pager span{border:1px solid var(--line);border-radius:8px;padding:9px 14px;text-decoration:none;color:var(--ink-soft)}
  #jw-blog .pager a:hover{color:var(--ink);border-color:var(--ember)}

  #jw-blog footer.site{border-top:1px solid var(--line);padding:34px 0;font-size:12.5px;color:var(--ink-soft)}
  #jw-blog .trustbar{display:flex;gap:18px;flex-wrap:wrap;justify-content:center;font-weight:700;font-size:12px;margin-bottom:20px;color:var(--ink)}
  #jw-blog .disclaimer{max-width:760px;margin:0 auto;text-align:center;line-height:1.6}
</style>

<div id="jw-blog">

<div class="announce">Free UK delivery · <span>30-day money-back guarantee</span> · 2-year warranty</div>

<header class="jw-head">
  <div class="wrap header-in">
    <a class="logo" href="{{ routes.root_url }}" aria-label="Jointwell home">
      <img src="{{ 'jointwell-logo.svg' | asset_url }}" alt="Jointwell" width="158" height="32">
    </a>
    <nav class="jw-nav" aria-label="Main">
      <a href="{{ routes.root_url }}#how">How it works</a>
      <a href="{{ routes.root_url }}#faq">FAQ</a>
      <a href="{{ routes.root_url }}blogs/journal">Journal</a>
      <a href="{{ routes.root_url }}#buy">Shop</a>
    </nav>
  </div>
</header>

<section class="band">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.eyebrow | default: 'Jointwell journal' }}</span>
    <h1 class="page">{{ section.settings.heading | default: 'Living with stiff joints' }}</h1>
    <p class="lede">{{ section.settings.intro }}</p>
  </div>
</section>

<section>
  <div class="wrap">
    {%- if has_posts -%}
      {%- paginate the_blog.articles by 10 -%}
        <div class="posts">
          {%- for article in the_blog.articles -%}
            <article class="post">
              {%- if article.image -%}
                <a class="thumb" href="{{ article.url }}">
                  <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="800" height="450">
                </a>
              {%- endif -%}
              <div class="body">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%-d %B %Y' }}</time>
                <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
                <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
                <a class="more" href="{{ article.url }}">Read this &rarr;</a>
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pager" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Newer</a>{%- endif -%}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Older &rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}

    {%- else -%}
      {%- comment -%}
        No posts yet. This says so plainly rather than padding the page with
        placeholder articles, which is the thing that makes a new shop look
        fake to the exact buyer we are selling to.
      {%- endcomment -%}
      <div class="empty">
        <h2>{{ section.settings.empty_heading | default: 'Nothing here yet' }}</h2>
        <p>{{ section.settings.empty_body | default: "We're writing the first few pieces now: what actually helps a stiff knee in the morning, how heat works on a joint, and the questions customers keep asking us. Check back shortly." }}</p>
        <a class="cta" href="{{ routes.root_url }}#buy">See the massager</a>
      </div>
    {%- endif -%}
  </div>
</section>

<footer class="site">
  <div class="wrap">
    <div class="trustbar">
      <span>✓ Free UK delivery</span><span>✓ 30-day money-back guarantee</span><span>✓ 2-year warranty</span><span>✓ UK support</span>
    </div>
    <p class="disclaimer">Jointwell is a heat and massage device for the comfort and relaxation of stiff, tired knees, shoulders and elbows. It is not a medical treatment and does not cure, treat or prevent any disease or condition, including arthritis. Results vary from person to person. If you have a condition affecting circulation or skin sensation, are pregnant, or are under medical care for your knee, talk to your GP before use.</p>
    <p class="disclaimer" style="margin-top:14px">© {{ 'now' | date: '%Y' }} Jointwell · {{ shop.domain }} · <a href="{{ routes.root_url }}policies/privacy-policy">Privacy</a> · <a href="{{ routes.root_url }}policies/refund-policy">Returns</a> · <a href="{{ routes.root_url }}pages/contact">Contact</a></p>
  </div>
</footer>

</div>

{% schema %}
{
  "name": "Jointwell Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Jointwell journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Living with stiff joints" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Practical writing about heat, movement and getting through a cold morning. No miracle cures, no jargon." },
    { "type": "text", "id": "blog_handle", "label": "Blog handle (fallback)", "default": "journal", "info": "Only used if this template is rendered outside a blog context." },
    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Nothing here yet" },
    { "type": "textarea", "id": "empty_body", "label": "Empty body", "default": "We're writing the first few pieces now: what actually helps a stiff knee in the morning, how heat works on a joint, and the questions customers keep asking us. Check back shortly." }
  ],
  "presets": [{ "name": "Jointwell Blog" }]
}
{% endschema %}
