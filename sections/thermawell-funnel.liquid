<!-- ===== STICKY HEAT BAR ===== -->
<div id="tw-heatbar" aria-hidden="true">
  <div class="tw-track"><div class="tw-fill" id="tw-fill"></div></div>
  <div class="tw-bar-in">
    <div class="tw-sec-label" id="tw-sec-label">{{ product.title }}</div>
    <div class="tw-bar-price" id="tw-bar-price">{{ pair_total | money }}</div>
    <button type="button" class="tw-bar-btn" id="tw-bar-btn">Buy Now</button>
  </div>
</div>

<script>
(function(){
  var funnel=document.getElementById('tw-funnel'); if(!funnel) return;

  /* carousel dots */
  var slides=document.getElementById('tw-slides'),dotsWrap=document.getElementById('tw-dots');
  if(slides&&dotsWrap){
    var n=slides.children.length,i;
    for(i=0;i<n;i++){var d=document.createElement('div');d.className='tw-dot'+(i===0?' on':'');dotsWrap.appendChild(d);}
    var dots=dotsWrap.children;
    slides.addEventListener('scroll',function(){
      var idx=Math.round(slides.scrollLeft/slides.clientWidth);
      for(var j=0;j<n;j++)dots[j].classList.toggle('on',j===idx);
    },{passive:true});
  }

  /* tier selection */
  var tiers=funnel.querySelectorAll('.tw-tier'),qty=document.getElementById('tw-qty'),
      buyBtn=document.getElementById('tw-buy-btn'),barPrice=document.getElementById('tw-bar-price'),
      form=document.getElementById('tw-atc-form'),activeCode='{{ section.settings.code_pair }}';
  function select(t){
    tiers.forEach(function(x){x.classList.remove('sel');x.setAttribute('aria-checked','false');});
    t.classList.add('sel');t.setAttribute('aria-checked','true');
    qty.value=t.dataset.qty;activeCode=t.dataset.code||'';
    var label=t.dataset.priceLabel;
    if(buyBtn)buyBtn.textContent='Buy Now — '+label+' · Secure Checkout →';
    if(barPrice)barPrice.textContent=label;
  }
  tiers.forEach(function(t){
    t.addEventListener('click',function(){select(t);});
    t.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();select(t);}});
  });

  /* submit: add to cart, optionally apply tier discount code, go to checkout */
  if(form){form.addEventListener('submit',function(e){
    e.preventDefault();
    var fd=new FormData(form);
    fetch('/cart/add.js',{method:'POST',body:fd}).then(function(){
      window.location.href=activeCode?'/discount/'+encodeURIComponent(activeCode)+'?redirect=%2Fcheckout':'/checkout';
    }).catch(function(){form.submit();});
  });}
  var finalBuy=document.getElementById('tw-final-buy'),barBtn=document.getElementById('tw-bar-btn');
  function fire(){if(form)form.dispatchEvent(new Event('submit',{cancelable:true}));}
  if(finalBuy)finalBuy.addEventListener('click',fire);
  if(barBtn)barBtn.addEventListener('click',fire);

  /* sticky heat bar */
  var bar=document.getElementById('tw-heatbar'),fill=document.getElementById('tw-fill'),
      secLabel=document.getElementById('tw-sec-label'),hero=document.getElementById('tw-top'),
      sections=funnel.querySelectorAll('[data-heat-label]'),
      footer=document.querySelector('footer, .footer, #shopify-section-footer, [id*="footer"]');
  function onScroll(){
    var heroBottom=hero?hero.getBoundingClientRect().bottom:0,
        footerHit=false;
    if(footer){footerHit=footer.getBoundingClientRect().top<window.innerHeight;}
    var show=heroBottom<0&&!footerHit;
    bar.classList.toggle('show',show);
    bar.setAttribute('aria-hidden',show?'false':'true');
    var end=funnel.offsetTop+funnel.offsetHeight-window.innerHeight,
        p=Math.min(1,Math.max(0,(window.scrollY-funnel.offsetTop)/(end-funnel.offsetTop)));
    fill.style.width=(p*100)+'%';
    bar.classList.toggle('hot',p>0.75);
    var current=null;
    sections.forEach(function(s){if(s.getBoundingClientRect().top<window.innerHeight*0.4)current=s;});
    if(current&&secLabel)secLabel.textContent=current.dataset.heatLabel;
  }
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',onScroll);
  onScroll();
})();
</script>

