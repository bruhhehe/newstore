{% comment %}
  THERMAWELL FUNNEL — long-form sales page for the Cordless Heated Knee Massager.
  Use on an alternate product template (templates/product.funnel.json).
  - Tiers: 1x / 2x (pair) / 4x (two pairs) + bulk contact
  - Real add-to-cart -> straight to checkout (return_to)
  - Optional per-tier discount codes auto-applied before checkout
  - Sticky "heat bar": scroll progress + current section + glowing buy button,
    appears after the hero, hides at the footer.
{% endcomment %}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign single = product.price -%}
{%- assign single_pct = section.settings.single_discount_pct | default: 0 -%}
{%- assign single_mult = 100 | minus: single_pct -%}
{%- assign single_now = single | times: single_mult | divided_by: 100 -%}
{%- assign single_save = single | minus: single_now -%}
{%- assign pair_pct = section.settings.pair_discount_pct | default: 15 -%}
{%- assign quad_pct = section.settings.quad_discount_pct | default: 25 -%}
{%- assign pair_mult = 100 | minus: pair_pct -%}
{%- assign quad_mult = 100 | minus: quad_pct -%}
{%- assign pair_total = single | times: 2 | times: pair_mult | divided_by: 100 -%}
{%- assign quad_total = single | times: 4 | times: quad_mult | divided_by: 100 -%}
{%- assign pair_full = single | times: 2 -%}
{%- assign quad_full = single | times: 4 -%}
{%- assign pair_save = pair_full | minus: pair_total -%}
{%- assign quad_save = quad_full | minus: quad_total -%}
{%- assign pair_each = pair_total | divided_by: 2 -%}
{%- assign quad_each = quad_total | divided_by: 4 -%}

<style>
  #tw-funnel{--tw-ink:#262b33;--tw-soft:#4c5560;--tw-paper:#fbf9f5;--tw-card:#fff;--tw-line:#e8e3da;
    --tw-heat-a:#ffb55c;--tw-heat-b:#e4572e;--tw-ember:#d64a21;--tw-wash:#fdeee0;
    --tw-trust:#3e6b52;--tw-trust-wash:#e9f1ec;--tw-star:#f5a623;--tw-r:16px;
    font-size:17px;line-height:1.65;color:var(--tw-ink);background:var(--tw-paper)}
  #tw-funnel *{box-sizing:border-box;margin:0;padding:0}
  #tw-funnel img{max-width:100%;display:block}
  #tw-funnel .tw-wrap{max-width:1080px;margin:0 auto;padding:0 20px}
  #tw-funnel section{padding:52px 0}
  #tw-funnel h1,#tw-funnel h2,#tw-funnel h3{line-height:1.15;letter-spacing:-.01em}
  #tw-funnel .tw-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;
    letter-spacing:.14em;text-transform:uppercase;color:var(--tw-ember);margin-bottom:14px}
  #tw-funnel .tw-eyebrow::before{content:"";width:22px;height:3px;border-radius:2px;
    background:linear-gradient(90deg,var(--tw-heat-a),var(--tw-heat-b))}
  #tw-funnel .tw-h2{font-size:clamp(27px,4.5vw,38px);font-weight:700;margin-bottom:14px}
  #tw-funnel .tw-lead{color:var(--tw-soft);font-size:18px;max-width:640px}

  /* hero */
  #tw-funnel .tw-hero{padding:34px 0 52px}
  #tw-funnel .tw-hero-grid{display:grid;gap:30px}
  @media(min-width:900px){#tw-funnel .tw-hero-grid{grid-template-columns:1.05fr 1fr;gap:52px;align-items:start}}
  #tw-funnel .tw-carousel{position:relative;border-radius:var(--tw-r);overflow:hidden;
    box-shadow:0 10px 30px rgba(38,43,51,.08);background:var(--tw-card)}
  #tw-funnel .tw-slides{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
  #tw-funnel .tw-slides::-webkit-scrollbar{display:none}
  #tw-funnel .tw-slide{flex:0 0 100%;scroll-snap-align:center;aspect-ratio:1/1;position:relative;background:#f2ede4}
  #tw-funnel .tw-slide img{width:100%;height:100%;object-fit:cover}
  #tw-funnel .tw-slide-cap{position:absolute;left:12px;right:12px;bottom:12px;background:rgba(255,255,255,.94);
    border-radius:10px;padding:10px 14px;font-size:13.5px;font-weight:700}
  #tw-funnel .tw-dots{display:flex;gap:6px;justify-content:center;padding:12px 0;background:var(--tw-card)}
  #tw-funnel .tw-dot{width:7px;height:7px;border-radius:50%;background:var(--tw-line);transition:.2s}
  #tw-funnel .tw-dot.on{background:var(--tw-ember);width:20px;border-radius:99px}
  #tw-funnel .tw-stars{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  #tw-funnel .tw-s{color:var(--tw-star);letter-spacing:2px}
  #tw-funnel .tw-stars small{font-size:13.5px;font-weight:600;color:var(--tw-soft)}
  #tw-funnel h1{font-size:clamp(31px,5.2vw,44px);font-weight:800;margin-bottom:14px}
  #tw-funnel h1 em{font-style:normal;background:linear-gradient(120deg,var(--tw-heat-b),var(--tw-heat-a));
    -webkit-background-clip:text;background-clip:text;color:transparent}
  #tw-funnel .tw-sub{font-size:18.5px;color:var(--tw-soft);margin-bottom:22px}
  #tw-funnel .tw-sub b{color:var(--tw-ink)}
  #tw-funnel .tw-bullets{list-style:none;margin-bottom:24px;display:grid;gap:11px}
  #tw-funnel .tw-bullets li{display:flex;gap:11px;align-items:flex-start;font-weight:500}
  #tw-funnel .tw-tick{flex:none;width:22px;height:22px;border-radius:50%;margin-top:2px;
    background:linear-gradient(135deg,var(--tw-heat-a),var(--tw-heat-b));color:#fff;display:flex;
    align-items:center;justify-content:center;font-size:12px;font-weight:800}
  #tw-funnel .tw-cta{display:inline-flex;align-items:center;justify-content:center;gap:10px;width:100%;
    max-width:420px;padding:18px 28px;border:none;border-radius:14px;cursor:pointer;font-size:18px;
    font-weight:800;color:#fff;background:linear-gradient(135deg,var(--tw-heat-b),var(--tw-ember));
    box-shadow:0 8px 22px rgba(214,74,33,.32);text-decoration:none;transition:transform .15s}
  #tw-funnel .tw-cta:hover{transform:translateY(-2px)}
  #tw-funnel .tw-under{margin-top:12px;font-size:13.5px;color:var(--tw-soft);display:flex;gap:16px;flex-wrap:wrap;font-weight:600}

  /* trust bar */
  #tw-funnel .tw-trustbar{background:var(--tw-card);border-top:1px solid var(--tw-line);
    border-bottom:1px solid var(--tw-line);padding:16px 0}
  #tw-funnel .tw-trust-row{display:flex;justify-content:center;gap:12px 30px;flex-wrap:wrap;
    font-size:14px;font-weight:700;color:var(--tw-soft)}

  /* offer tiers */
  #tw-funnel .tw-offer{background:linear-gradient(180deg,var(--tw-paper),var(--tw-wash) 140%)}
  #tw-funnel .tw-tiers{display:grid;gap:16px;max-width:580px;margin:30px auto 0}
  #tw-funnel .tw-tier{position:relative;background:var(--tw-card);border:2px solid var(--tw-line);
    border-radius:var(--tw-r);padding:20px;display:grid;grid-template-columns:auto 1fr auto;gap:14px;
    align-items:center;cursor:pointer;transition:.15s;text-align:left}
  #tw-funnel .tw-tier:hover{border-color:var(--tw-heat-a)}
  #tw-funnel .tw-tier.sel{border-color:var(--tw-ember);box-shadow:0 12px 32px rgba(214,74,33,.14)}
  #tw-funnel .tw-flag{position:absolute;top:-13px;left:50%;transform:translateX(-50%);white-space:nowrap;
    background:linear-gradient(90deg,var(--tw-heat-b),var(--tw-ember));color:#fff;font-size:11.5px;
    font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:5px 14px;border-radius:99px}
  #tw-funnel .tw-radio{width:22px;height:22px;border-radius:50%;border:2px solid var(--tw-line)}
  #tw-funnel .tw-tier.sel .tw-radio{border-color:var(--tw-ember);
    background:radial-gradient(circle,var(--tw-ember) 40%,transparent 45%)}
  #tw-funnel .tw-tname{font-weight:800;font-size:17px}
  #tw-funnel .tw-tsub{font-size:13.5px;color:var(--tw-soft);margin-top:2px}
  #tw-funnel .tw-tsave{display:inline-block;margin-top:6px;background:var(--tw-trust-wash);
    color:var(--tw-trust);font-size:12px;font-weight:800;padding:3px 9px;border-radius:6px}
  #tw-funnel .tw-tprice{text-align:right}
  #tw-funnel .tw-now{font-size:21px;font-weight:800}
  #tw-funnel .tw-each{font-size:12px;color:var(--tw-soft)}
  #tw-funnel .tw-bulk{max-width:580px;margin:14px auto 0;display:flex;gap:12px;align-items:center;
    justify-content:space-between;background:var(--tw-ink);color:#fff;border-radius:var(--tw-r);padding:18px 20px}
  #tw-funnel .tw-bulk a{color:#fff;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);
    padding:10px 18px;border-radius:10px;font-weight:800;font-size:14px;text-decoration:none;white-space:nowrap}
  #tw-funnel .tw-bulk small{opacity:.8;display:block;font-weight:500}
  #tw-funnel .tw-offer-cta{max-width:580px;margin:24px auto 0;text-align:center}
  #tw-funnel .tw-guarantee{max-width:580px;margin:20px auto 0;background:var(--tw-trust-wash);
    border-radius:var(--tw-r);padding:18px 20px;display:flex;gap:14px;align-items:flex-start}
  #tw-funnel .tw-gb{flex:none;width:46px;height:46px;border-radius:50%;background:var(--tw-trust);
    color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px}
  #tw-funnel .tw-guarantee b{color:var(--tw-trust)}
  #tw-funnel .tw-guarantee p{font-size:14.5px;color:var(--tw-soft)}

  /* faq */
  #tw-funnel .tw-faq{max-width:720px;margin:0 auto}
  #tw-funnel details{background:var(--tw-card);border:1px solid var(--tw-line);border-radius:12px;
    margin-bottom:10px;overflow:hidden}
  #tw-funnel summary{cursor:pointer;list-style:none;padding:18px 20px;font-weight:700;font-size:16.5px;
    display:flex;justify-content:space-between;align-items:center;gap:12px}
  #tw-funnel summary::-webkit-details-marker{display:none}
  #tw-funnel summary::after{content:"+";font-size:22px;color:var(--tw-ember);transition:.2s}
  #tw-funnel details[open] summary::after{transform:rotate(45deg)}
  #tw-funnel details .tw-a{padding:0 20px 18px;color:var(--tw-soft);font-size:15.5px}

  /* reviews */
  #tw-funnel .tw-revs{display:grid;gap:16px;margin-top:30px}
  @media(min-width:760px){#tw-funnel .tw-revs{grid-template-columns:repeat(3,1fr)}}
  #tw-funnel .tw-rev{background:var(--tw-card);border:1px solid var(--tw-line);border-radius:var(--tw-r);
    padding:22px;box-shadow:0 10px 30px rgba(38,43,51,.06)}
  #tw-funnel .tw-rev h4{font-size:16.5px;font-weight:800;margin:10px 0 8px}
  #tw-funnel .tw-rev p{font-size:15px;color:var(--tw-soft);margin-bottom:14px}
  #tw-funnel .tw-who{font-size:13.5px;font-weight:700}
  #tw-funnel .tw-ver{color:var(--tw-trust);font-weight:700;font-size:12.5px}

  /* mechanisms */
  #tw-funnel .tw-mech{display:grid;gap:18px;margin-top:32px}
  @media(min-width:820px){#tw-funnel .tw-mech{grid-template-columns:repeat(3,1fr)}}
  #tw-funnel .tw-mcard{background:var(--tw-card);border:1px solid var(--tw-line);border-radius:var(--tw-r);
    padding:26px;position:relative;overflow:hidden}
  #tw-funnel .tw-mcard::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;
    background:linear-gradient(90deg,var(--tw-heat-a),var(--tw-heat-b))}
  #tw-funnel .tw-mnum{font-size:14px;font-weight:800;color:var(--tw-ember);margin-bottom:8px}
  #tw-funnel .tw-mcard h3{font-size:20px;margin-bottom:8px;font-weight:800}
  #tw-funnel .tw-mcard p{font-size:15px;color:var(--tw-soft)}
  #tw-funnel .tw-proofstrip{margin-top:32px;background:var(--tw-ink);color:#fff;border-radius:var(--tw-r);
    padding:26px 28px;text-align:center}
  #tw-funnel .tw-proofstrip q{display:block;font-size:19px;max-width:640px;margin:8px auto;font-weight:600}
  #tw-funnel .tw-proofstrip small{opacity:.75;font-weight:600}

  /* who for */
  #tw-funnel .tw-for{display:grid;gap:12px;margin-top:28px;grid-template-columns:repeat(2,1fr)}
  @media(min-width:820px){#tw-funnel .tw-for{grid-template-columns:repeat(3,1fr)}}
  #tw-funnel .tw-fcard{background:var(--tw-card);border:1px solid var(--tw-line);border-radius:12px;
    padding:18px;font-weight:600;font-size:15px;display:flex;gap:10px;align-items:center}

  /* comparison */
  #tw-funnel .tw-comp{overflow-x:auto;margin-top:28px;border-radius:var(--tw-r);
    box-shadow:0 10px 30px rgba(38,43,51,.08)}
  #tw-funnel table{width:100%;border-collapse:collapse;background:var(--tw-card);min-width:560px}
  #tw-funnel th,#tw-funnel td{padding:14px 16px;text-align:center;font-size:14.5px;
    border-bottom:1px solid var(--tw-line)}
  #tw-funnel th{font-weight:800;font-size:13.5px}
  #tw-funnel td:first-child,#tw-funnel th:first-child{text-align:left;font-weight:700}
  #tw-funnel th.us{background:linear-gradient(135deg,var(--tw-heat-b),var(--tw-ember));color:#fff}
  #tw-funnel td.us{background:var(--tw-wash);font-weight:800;color:var(--tw-ember)}
  #tw-funnel .no{color:#b0aca4}

  /* details / preserved copy */
  #tw-funnel .tw-desc{max-width:720px;margin:0 auto;background:var(--tw-card);
    border:1px solid var(--tw-line);border-radius:var(--tw-r);padding:8px 24px}
  #tw-funnel .tw-desc h3{font-size:18px;margin:18px 0 8px;font-weight:800}
  #tw-funnel .tw-desc ul{padding-left:20px;color:var(--tw-soft)}
  #tw-funnel .tw-desc p{margin:12px 0;color:var(--tw-soft)}
  #tw-funnel .tw-desc p strong{color:var(--tw-ink)}

  /* final */
  #tw-funnel .tw-final{background:var(--tw-ink);color:#fff}
  #tw-funnel .tw-final .tw-h2{color:#fff}
  #tw-funnel .tw-final .tw-lead{color:rgba(255,255,255,.75);margin:0 auto 24px}
  #tw-funnel .tw-final .tw-guarantee{background:rgba(255,255,255,.08)}
  #tw-funnel .tw-final .tw-guarantee p{color:rgba(255,255,255,.75)}
  #tw-funnel .tw-final .tw-guarantee b{color:#8fd3ab}
  #tw-funnel .tw-urgency{margin-top:14px;font-size:14px;font-weight:700;color:var(--tw-heat-a)}

  /* ===== STICKY HEAT BAR ===== */
  #tw-heatbar{position:fixed;left:0;right:0;bottom:0;z-index:60;transform:translateY(110%);
    transition:transform .3s ease;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);
    border-top:1px solid var(--tw-line);box-shadow:0 -8px 30px rgba(38,43,51,.12)}
  #tw-heatbar.show{transform:translateY(0)}
  #tw-heatbar .tw-track{height:4px;background:var(--tw-line);position:relative}
  #tw-heatbar .tw-fill{position:absolute;left:0;top:0;bottom:0;width:0;
    background:linear-gradient(90deg,var(--tw-heat-a),var(--tw-heat-b));transition:width .15s linear}
  #tw-heatbar .tw-bar-in{max-width:1080px;margin:0 auto;display:flex;align-items:center;gap:14px;
    padding:10px 16px}
  #tw-heatbar .tw-sec-label{flex:1;min-width:0;font-size:12.5px;font-weight:800;letter-spacing:.06em;
    text-transform:uppercase;color:var(--tw-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #tw-heatbar .tw-bar-price{font-size:13px;font-weight:800;white-space:nowrap}
  #tw-heatbar .tw-bar-btn{flex:none;border:none;cursor:pointer;color:#fff;font-weight:800;font-size:15px;
    padding:13px 22px;border-radius:12px;background:linear-gradient(135deg,var(--tw-heat-b),var(--tw-ember));
    box-shadow:0 0 0 0 rgba(214,74,33,.45)}
  #tw-heatbar.hot .tw-bar-btn{animation:tw-glow 1.6s ease-in-out infinite}
  @keyframes tw-glow{0%,100%{box-shadow:0 0 8px 1px rgba(214,74,33,.35)}
    50%{box-shadow:0 0 22px 6px rgba(228,87,46,.6)}}
  @media(prefers-reduced-motion:reduce){#tw-funnel *,#tw-heatbar,#tw-heatbar .tw-bar-btn{
    animation:none!important;transition:none!important}}
</style>

<div id="tw-funnel">

  <!-- ============ ABOVE THE FOLD ============ -->
  <section class="tw-hero" data-heat-label="{{ product.title }}" id="tw-top">
    <div class="tw-wrap tw-hero-grid">
      <div>
        <div class="tw-carousel">
          <div class="tw-slides" id="tw-slides">
            {%- for image in product.images limit: 6 -%}
              <div class="tw-slide">
                <img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                {%- if image.alt != blank -%}<div class="tw-slide-cap">{{ image.alt }}</div>{%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          <div class="tw-dots" id="tw-dots"></div>
        </div>
      </div>
      <div>
        <div class="tw-stars"><span class="tw-s">★★★★★</span><small>{{ section.settings.rating_text }}</small></div>
        <h1>{{ section.settings.headline }}</h1>
        <p class="tw-sub">{{ section.settings.subheadline }}</p>
        <ul class="tw-bullets">
          <li><span class="tw-tick">✓</span>Three heat settings — 45°C, 50°C and 65°C — warm in under a minute</li>
          <li><span class="tw-tick">✓</span>Three massage modes; use warmth and massage together or on their own</li>
          <li><span class="tw-tick">✓</span>Straps stay put, cordless — move around the house freely while it works</li>
          <li><span class="tw-tick">✓</span>Real buttons and a clear touch panel. No phone app, no fuss</li>
        </ul>
        <a class="tw-cta" href="#tw-offer">Choose My Bundle — From {{ single_now | money }} →</a>
        <div class="tw-under"><span>🚚 Free UK shipping</span><span>🛡️ 30-day returns</span><span>🔋 Cordless, USB rechargeable</span></div>
      </div>
    </div>
  </section>

  <div class="tw-trustbar">
    <div class="tw-wrap tw-trust-row">
      <span>🇬🇧 UK support, 7 days</span><span>⚡ Fast tracked delivery</span>
      <span>🔁 30-day money-back returns</span><span>✅ CE, FCC &amp; RoHS certified</span>
    </div>
  </div>

  <!-- ============ OFFER ============ -->
  <section class="tw-offer" id="tw-offer" data-heat-label="Choose your bundle">
    <div class="tw-wrap" style="text-align:center">
      <div class="tw-eyebrow" style="justify-content:center">{{ section.settings.sale_name }}</div>
      <h2 class="tw-h2">Warmth for one knee — or the whole household</h2>
      <p class="tw-lead" style="margin:0 auto">Both knees have had the same long days. Most customers choose the pair — one on each knee, or one for you and one for the person you'd have lent yours to anyway.</p>

      {%- form 'product', product, id: 'tw-atc-form' -%}
        <input type="hidden" name="id" value="{{ v.id }}">
        <input type="hidden" name="quantity" id="tw-qty" value="2">
        <input type="hidden" name="return_to" value="/checkout">

        <div class="tw-tiers" role="radiogroup" aria-label="Bundle options">
          <div class="tw-tier" data-qty="1" data-code="{{ section.settings.code_single }}" data-price-label="{{ single_now | money }}" role="radio" aria-checked="false" tabindex="0">
            <div class="tw-radio"></div>
            <div>
              <div class="tw-tname">1 × Heated Knee Massager</div>
              <div class="tw-tsub">Try it for yourself</div>
              {%- if single_pct > 0 -%}<div class="tw-tsave">Save {{ single_save | money }} ({{ single_pct }}%)</div>{%- endif -%}
            </div>
            <div class="tw-tprice"><div class="tw-now">{{ single_now | money }}</div>{%- if single_pct > 0 -%}<div class="tw-each" style="text-decoration:line-through">{{ single | money }}</div>{%- endif -%}</div>
          </div>

          <div class="tw-tier sel" data-qty="2" data-code="{{ section.settings.code_pair }}" data-price-label="{{ pair_total | money }}" role="radio" aria-checked="true" tabindex="0">
            <div class="tw-flag">★ Most popular — one for each knee</div>
            <div class="tw-radio"></div>
            <div>
              <div class="tw-tname">One Pair (2×)</div>
              <div class="tw-tsub">Both knees covered — or share with a partner</div>
              <div class="tw-tsave">Save {{ pair_save | money }} vs buying singly · {{ pair_each | money }} each</div>
            </div>
            <div class="tw-tprice"><div class="tw-now">{{ pair_total | money }}</div><div class="tw-each">{{ pair_each | money }} each</div></div>
          </div>

          <div class="tw-tier" data-qty="4" data-code="{{ section.settings.code_quad }}" data-price-label="{{ quad_total | money }}" role="radio" aria-checked="false" tabindex="0">
            <div class="tw-radio"></div>
            <div>
              <div class="tw-tname">Two Pairs (4×)</div>
              <div class="tw-tsub">The family bundle — the gift that gets phone calls</div>
              <div class="tw-tsave">Best value · Save {{ quad_save | money }} · {{ quad_each | money }} each</div>
            </div>
            <div class="tw-tprice"><div class="tw-now">{{ quad_total | money }}</div><div class="tw-each">{{ quad_each | money }} each</div></div>
          </div>
        </div>

        <div class="tw-bulk">
          <div style="text-align:left"><b>Buying in bulk?</b><small>Care homes, clubs &amp; resellers — ask about trade pricing on 10+ units.</small></div>
          <a href="mailto:{{ section.settings.bulk_email }}?subject=Bulk%20order%20enquiry%20—%20Heated%20Knee%20Massager">Contact us now</a>
        </div>

        <div class="tw-offer-cta">
          <button type="submit" class="tw-cta" id="tw-buy-btn">Buy Now — {{ pair_total | money }} · Secure Checkout →</button>
        </div>
      {%- endform -%}

      <div class="tw-guarantee" style="text-align:left">
        <div class="tw-gb">🛡️</div>
        <div><b>Backed by 30-day returns.</b>
