{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section stw-show-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .stw-show-{{ section.id }} .stw-show-grid{
      max-width:1180px; margin:0 auto; padding:80px 24px;
      display:grid; grid-template-columns:1fr 1.05fr; gap:56px; align-items:center;
    }
    .stw-show-{{ section.id }} .stw-show-img{
      border-radius:20px; overflow:hidden; background:#fff; border:1px solid var(--bp-line);
    }
    .stw-show-{{ section.id }} .stw-show-img img{ display:block; width:100%; height:auto; }
    .stw-show-{{ section.id }} h2{ font-size:32px; margin-bottom:10px; }
    .stw-show-{{ section.id }} .stw-show-intro{ font-size:17px; color:var(--bp-muted); margin:0 0 30px; max-width:52ch; }
    .stw-show-{{ section.id }} .stw-fn{ display:flex; gap:18px; padding:20px 0; border-top:1px solid var(--bp-line); }
    .stw-show-{{ section.id }} .stw-fn:last-child{ border-bottom:1px solid var(--bp-line); }
    .stw-show-{{ section.id }} .stw-fn-num{
      flex-shrink:0; width:44px; height:44px; border-radius:50%;
      border:1.5px solid var(--bp-pink-deep); color:var(--bp-pink-deep);
      display:flex; align-items:center; justify-content:center;
      font-family:var(--bp-serif); font-size:18px;
    }
    .stw-show-{{ section.id }} .stw-fn h3{ font-family:var(--bp-sans); font-size:17.5px; font-weight:700; margin-bottom:5px; }
    .stw-show-{{ section.id }} .stw-fn p{ font-size:15.5px; color:var(--bp-muted); margin:0; line-height:1.6; }
    @media (max-width:900px){
      .stw-show-{{ section.id }} .stw-show-grid{ grid-template-columns:1fr; gap:34px; padding:52px 20px; }
      .stw-show-{{ section.id }} h2{ font-size:27px; }
    }
  </style>
  <div class="stw-show-grid">
    <div class="stw-show-img">
      {% if section.settings.show_demo_video %}
        <video
          controls
          preload="none"
          playsinline
          poster="{{ section.settings.video_poster | default: 'tw-lifestyle-beanbag.jpg' | asset_url }}"
          style="display:block; width:100%; height:auto; background:#000;"
          aria-label="{{ section.settings.video_caption | default: 'Product demonstration video' }}">
          <source src="{{ 'stw-demo.mp4' | asset_url }}" type="video/mp4">
        </video>
        {% if section.settings.video_caption != blank %}
          <div style="padding:14px 18px; font-size:13.5px; color:var(--bp-muted); border-top:1px solid var(--bp-line);">{{ section.settings.video_caption }}</div>
        {% endif %}
      {% else %}
        <img src="{{ section.settings.image_asset | default: 'stw-joints.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1200" height="1200">
      {% endif %}
    </div>
    <div>
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="stw-show-intro">{{ section.settings.intro }}</p>
      <div>
        {% for block in section.blocks %}
          <div class="stw-fn" {{ block.shopify_attributes }}>
            <div class="stw-fn-num">{{ forloop.index }}</div>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STW Showcase",
  "tag": "section",
  "class": "section-stw-showcase",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F2EEE4" },
    { "type": "text", "id": "image_asset", "label": "Image asset filename", "default": "stw-joints.jpg" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "The heated massager wrapped around a shoulder, a knee and an elbow" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT IT ACTUALLY DOES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Warmth and gentle massage, in one simple wrap." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Fasten it around the joint that bothers you, press a button, and choose what feels right." },
    { "type": "checkbox", "id": "show_demo_video", "label": "Show demo video instead of the static photo", "default": false },
    { "type": "text", "id": "video_poster", "label": "Video poster image filename", "default": "tw-lifestyle-beanbag.jpg" },
    { "type": "text", "id": "video_caption", "label": "Video caption", "default": "See it wrap, warm up and adjust in under a minute." }
  ],
  "blocks": [
    {
      "type": "function",
      "name": "Function",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "It warms" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Three heat settings — 45°C, 50°C and 65°C." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "STW Showcase",
      "blocks": [
        { "type": "function", "settings": { "title": "It keeps you low", "text": "A compact, low-profile seat that keeps you level with the row." } },
        { "type": "function", "settings": { "title": "It stays steady", "text": "A welded steel frame on wide curved runners — flat on carpet, no rocking." } },
        { "type": "function", "settings": { "title": "It goes where you pray", "text": "Just 1.2kg — carried to the masjid in one hand." } }
      ]
    }
  ]
}
{% endschema %}
