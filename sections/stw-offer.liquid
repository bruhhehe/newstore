{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

{%- assign p = all_products[section.settings.product] -%}

<div class="bp-section stw-offer-{{ section.id }}" id="offer" style="background:{{ section.settings.bg_color }};">
  <style>
    .stw-offer-{{ section.id }} .stw-off-wrap{ max-width:720px; margin:0 auto; padding:82px 24px; }
    .stw-offer-{{ section.id }} .stw-off-card{
      background:#fff; border:2px solid var(--bp-line); border-radius:var(--bp-radius);
      box-shadow:0 14px 40px rgba(30,38,34,.07); padding:26px 24px; margin-top:36px;
    }
    .stw-offer-{{ section.id }} .stw-off-banner{
      display:flex; align-items:center; gap:12px; flex-wrap:wrap;
      background:linear-gradient(90deg, var(--bp-heat-a), var(--bp-heat-b));
      color:#2A1F0A; border-radius:12px; padding:12px 16px; margin-bottom:8px;
      font-size:14px;
    }
    .stw-offer-{{ section.id }} .stw-off-banner b{ font-size:13px; letter-spacing:.1em; }
    .stw-offer-{{ section.id }} .stw-off-name .sale{ color:var(--bp-pink-deep); font-size:16px; }
    .stw-offer-{{ section.id }} .stw-off-name s{ color:var(--bp-muted); font-weight:500; }
    .stw-offer-{{ section.id }} .stw-off-row{
      display:flex; align-items:center; gap:16px; padding:16px 0;
    }
    .stw-offer-{{ section.id }} .stw-off-row + .stw-off-row{ border-top:1px solid var(--bp-line); }
    .stw-offer-{{ section.id }} .stw-off-swatch{
      flex:none; width:64px; height:64px; border-radius:12px; overflow:hidden;
      border:1px solid var(--bp-line); background:#FAF7F0;
    }
    .stw-offer-{{ section.id }} .stw-off-swatch img{ width:100%; height:100%; object-fit:cover; display:block; }
    .stw-offer-{{ section.id }} .stw-off-name{ flex:1; min-width:0; }
    .stw-offer-{{ section.id }} .stw-off-name b{ display:block; font-size:16.5px; }
    .stw-offer-{{ section.id }} .stw-off-name span{ font-size:13.5px; color:var(--bp-muted); }
    .stw-offer-{{ section.id }} .stw-off-step{
      flex:none; display:flex; align-items:center; gap:0;
      border:2px solid var(--bp-line); border-radius:12px; overflow:hidden;
    }
    .stw-offer-{{ section.id }} .stw-off-step button{
      width:46px; height:46px; border:0; background:#fff; font-size:22px; font-weight:800;
      color:var(--bp-pink-deep); cursor:pointer; line-height:1;
    }
    .stw-offer-{{ section.id }} .stw-off-step button:disabled{ color:#C9C4B8; cursor:default; }
    .stw-offer-{{ section.id }} .stw-off-step output{
      width:44px; text-align:center; font-size:18px; font-weight:800; font-variant-numeric:tabular-nums;
    }
    .stw-offer-{{ section.id }} .stw-off-sum{ margin-top:20px; padding-top:18px; border-top:2px solid var(--bp-line); }
    .stw-offer-{{ section.id }} .stw-off-line{
      display:flex; justify-content:space-between; align-items:baseline;
      font-size:15.5px; color:var(--bp-muted); margin-bottom:6px;
    }
    .stw-offer-{{ section.id }} .stw-off-line.total{ font-size:20px; color:var(--bp-ink); font-weight:800; margin-top:8px; }
    .stw-offer-{{ section.id }} .stw-off-line .was{ text-decoration:line-through; margin-right:8px; color:var(--bp-muted); font-weight:500; font-size:16px; }
    .stw-offer-{{ section.id }} .stw-off-badge{
      display:inline-block; background:var(--bp-trust-wash); color:var(--bp-green);
      font-size:13.5px; font-weight:800; border-radius:999px; padding:5px 12px;
    }
    .stw-offer-{{ section.id }} .stw-off-cta{
      display:block; width:100%; text-align:center; margin-top:18px;
      background:linear-gradient(135deg, #14735A, #0E5F46); color:#fff;
      font-weight:800; font-size:17px; padding:16px 20px; border-radius:14px; border:0;
      box-shadow:0 8px 22px rgba(14,95,70,.30); cursor:pointer; text-decoration:none;
    }
    .stw-offer-{{ section.id }} .stw-off-cta[aria-disabled="true"]{ opacity:.45; pointer-events:none; box-shadow:none; }
    .stw-offer-{{ section.id }} .stw-off-note{ text-align:center; font-size:13.5px; color:var(--bp-muted); margin-top:12px; }
    .stw-offer-{{ section.id }} .stw-off-bulk{
      margin-top:18px; background:transparent; border:2px dashed var(--bp-line);
      border-radius:var(--bp-radius); padding:20px 22px; display:flex; gap:14px;
      align-items:center; justify-content:space-between; flex-wrap:wrap;
    }
    .stw-offer-{{ section.id }} .stw-off-bulk b{ display:block; font-size:16px; }
    .stw-offer-{{ section.id }} .stw-off-bulk span{ font-size:14px; color:var(--bp-muted); }
    .stw-offer-{{ section.id }} .stw-off-bulk a{
      font-weight:800; color:var(--bp-pink-deep); text-decoration:underline; text-underline-offset:3px;
    }
    @media (max-width:560px){
      .stw-offer-{{ section.id }} .stw-off-wrap{ padding:56px 18px; }
      .stw-offer-{{ section.id }} .stw-off-swatch{ width:52px; height:52px; }
    }
  </style>

  <div class="stw-off-wrap">
    <div class="bp-center">
      <div class="bp-eyebrow" style="justify-content:center">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:33px;">{{ section.settings.heading }}</h2>
      <p style="color:var(--bp-muted); margin-top:12px;">{{ section.settings.subheading }}</p>
    </div>

    {%- if p != blank -%}
      {%- assign tan_variant = blank -%}
      {%- assign black_variant = blank -%}
      {%- for v in p.variants -%}
        {%- assign t = v.title | downcase -%}
        {%- if t contains 'tan' or t contains 'brown' -%}{%- assign tan_variant = v -%}{%- endif -%}
        {%- if t contains 'black' -%}{%- assign black_variant = v -%}{%- endif -%}
      {%- endfor -%}

      {%- assign pct1_keep = 100 | minus: section.settings.discount_percent -%}
      {%- assign unit_now = p.price | times: pct1_keep | divided_by: 100.0 | round -%}
      {%- assign pct2_keep = 100 | minus: section.settings.quad_percent -%}
      {%- assign unit_now2 = p.price | times: pct2_keep | divided_by: 100.0 | round -%}
      <div class="stw-off-card"
           data-offer
           data-unit="{{ p.price }}"
           data-pct1="{{ section.settings.discount_percent | default: 25 }}"
           data-pct2="{{ section.settings.quad_percent | default: 30 }}"
           data-code1="{{ section.settings.discount_code | strip }}"
           data-code2="{{ section.settings.quad_code | strip }}"
           data-currency="{{ cart.currency.symbol | default: '£' }}">

        <div class="stw-off-banner">
          <b>LAUNCH OFFER</b>
          <span>{{ section.settings.discount_percent | round }}% off · {{ section.settings.quad_percent | round }}% off two or more · applied automatically</span>
        </div>

        {%- if tan_variant != blank -%}
        <div class="stw-off-row">
          <div class="stw-off-swatch"><img src="{{ 'skn-stool-brown.jpg' | asset_url }}" alt="Warm tan colour" loading="lazy" width="128" height="128"></div>
          <div class="stw-off-name"><b>Warm tan</b><span><strong class="sale">{{ unit_now | money }}</strong> <s>{{ p.price | money }}</s> each</span></div>
          <div class="stw-off-step" data-stepper data-variant="{{ tan_variant.id }}">
            <button type="button" data-minus aria-label="Fewer warm tan">−</button>
            <output data-qty aria-live="polite">0</output>
            <button type="button" data-plus aria-label="More warm tan">+</button>
          </div>
        </div>
        {%- endif -%}

        {%- if black_variant != blank -%}
        <div class="stw-off-row">
          <div class="stw-off-swatch"><img src="{{ 'skn-stool-black.jpg' | asset_url }}" alt="Classic black colour" loading="lazy" width="128" height="128"></div>
          <div class="stw-off-name"><b>Classic black</b><span><strong class="sale">{{ unit_now | money }}</strong> <s>{{ p.price | money }}</s> each</span></div>
          <div class="stw-off-step" data-stepper data-variant="{{ black_variant.id }}">
            <button type="button" data-minus aria-label="Fewer classic black">−</button>
            <output data-qty aria-live="polite">0</output>
            <button type="button" data-plus aria-label="More classic black">+</button>
          </div>
        </div>
        {%- endif -%}

        <div class="stw-off-sum">
          <div class="stw-off-line"><span data-count-label>No stools selected yet</span><span class="stw-off-badge" data-badge hidden></span></div>
          <div class="stw-off-line total"><span>Total</span><span><span class="was" data-was hidden></span><span data-total>—</span></span></div>
          <div class="stw-off-line"><span data-save hidden></span></div>
        </div>

        <a class="stw-off-cta" href="#" data-checkout aria-disabled="true">Checkout securely →</a>
        <div class="stw-off-note">Discount applied for you at checkout · Free UK delivery · 30-day returns · No account needed</div>
      </div>

      <div class="stw-off-bulk">
        <div>
          <b>Ordering in bulk?</b>
          <span>Equipping a masjid, or buying for the whole family — tell us how many and we'll sort a fair price and an invoice.</span>
        </div>
        <a href="{{ section.settings.bulk_link | default: 'mailto:s77506910@gmail.com?subject=Bulk%20order%20enquiry%20—%20Sukoon%20Prayer%20Stool' }}">Contact us</a>
      </div>

      <script>
        (function(){
          var root = document.querySelector('.stw-offer-{{ section.id }} [data-offer]');
          if (!root) return;
          var unit = parseInt(root.dataset.unit, 10);
          var pct1 = parseFloat(root.dataset.pct1) || 0;
          var pct2 = parseFloat(root.dataset.pct2) || 0;
          var code1 = root.dataset.code1 || '';
          var code2 = root.dataset.code2 || '';
          var MAX = 10;
          var steppers = [].slice.call(root.querySelectorAll('[data-stepper]'));
          var qty = steppers.map(function(){ return 0; });

          var fmt = function(pence){
            return '£' + (pence / 100).toFixed(2);
          };

          function render(){
            var total = 0;
            steppers.forEach(function(s, i){
              s.querySelector('[data-qty]').textContent = qty[i];
              s.querySelector('[data-minus]').disabled = qty[i] <= 0;
              s.querySelector('[data-plus]').disabled = qty[i] >= MAX;
              total += qty[i];
            });
            var was = unit * total;
            var pct = total >= 2 ? pct2 : (total >= 1 ? pct1 : 0);
            var code = total >= 2 ? code2 : (total >= 1 ? code1 : '');
            var now = Math.round(was * (100 - pct) / 100);
            var save = was - now;

            var countLabel = root.querySelector('[data-count-label]');
            var badge = root.querySelector('[data-badge]');
            var wasEl = root.querySelector('[data-was]');
            var totalEl = root.querySelector('[data-total]');
            var saveEl = root.querySelector('[data-save]');
            var cta = root.querySelector('[data-checkout]');

            if (total === 0){
              countLabel.textContent = 'Pick your colours above';
              badge.hidden = true; wasEl.hidden = true; saveEl.hidden = true;
              totalEl.textContent = 'From ' + fmt(Math.round(unit * (100 - pct1) / 100));
              cta.setAttribute('aria-disabled', 'true');
              cta.setAttribute('href', '#');
              return;
            }
            countLabel.textContent = total + (total === 1 ? ' stool' : ' stools');
            badge.hidden = false;
            badge.textContent = Math.round(pct) + '% off' + (total >= 2 ? ' — two or more' : ' — launch offer');
            wasEl.hidden = false; wasEl.textContent = fmt(was);
            totalEl.textContent = fmt(now);
            saveEl.hidden = false; saveEl.textContent = 'You save ' + fmt(save) + (code ? ' with ' + code + ', applied automatically' : '');

            var parts = [];
            steppers.forEach(function(s, i){
              if (qty[i] > 0) parts.push(s.dataset.variant + ':' + qty[i]);
            });
            var href = '/cart/' + parts.join(',') + (code ? '?discount=' + encodeURIComponent(code) : '');
            cta.setAttribute('href', href);
            cta.removeAttribute('aria-disabled');
          }

          steppers.forEach(function(s, i){
            s.querySelector('[data-plus]').addEventListener('click', function(){ if (qty[i] < MAX){ qty[i]++; render(); } });
            s.querySelector('[data-minus]').addEventListener('click', function(){ if (qty[i] > 0){ qty[i]--; render(); } });
          });
          render();
        })();
      </script>
    {%- else -%}
      <p style="text-align:center; color:var(--bp-muted); margin-top:30px;">Select a product in the theme editor to show the offer.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "STW Offer",
  "tag": "section",
  "class": "section-stw-offer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF7F0" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CHOOSE YOURS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mix your colours. We'll sort the rest." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Launch offer — 25% off one, 30% off two or more. Applied for you at checkout." },
    { "type": "text", "id": "discount_code", "label": "Single-stool discount code", "info": "Auto-applied at checkout for 1 item. Displayed prices use the percentage below — keep it matching the real code.", "default": "SUKOON25" },
    { "type": "number", "id": "discount_percent", "label": "Single-stool percentage (decimals allowed)", "default": 25 },
    { "type": "text", "id": "quad_code", "label": "Two-or-more discount code", "info": "Auto-applied at checkout for 2+ items.", "default": "SUKOON30" },
    { "type": "number", "id": "quad_percent", "label": "Two-or-more percentage (decimals allowed)", "default": 30 },
    { "type": "url", "id": "bulk_link", "label": "Bulk enquiry link", "info": "Where the masjid/bulk 'Contact us' points. Defaults to the support email." }
  ],
  "presets": [{ "name": "STW Offer" }]
}
{% endschema %}
