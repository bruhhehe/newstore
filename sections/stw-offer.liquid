{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}
{{ 'steadwell-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product
-%}

<div id="offer" style="scroll-margin-top: 100px; display: block !important;"></div>
<div class="bp-section" style="background:{{ section.settings.bg_color }}; padding:88px 0;">
  {%- if product == blank -%}
    <div class="bp-wrap">
      <p>Select a product in the theme editor to show the offer.</p>
    </div>
  {%- else -%}
    {%- liquid
      assign variant = product.selected_or_first_available_variant
      assign unit_price = variant.price
      assign code = section.settings.discount_code | strip
      assign pct = section.settings.discount_percent
      assign keep = 100 | minus: pct

      assign q1_was = unit_price
      assign q2_was = unit_price | times: 2
      assign q4_was = unit_price | times: 4

      if code != blank
        assign q1_now = q1_was | times: keep | divided_by: 100.0 | round
        assign q2_now = q2_was | times: keep | divided_by: 100.0 | round
        assign q4_now = q4_was | times: keep | divided_by: 100.0 | round
      else
        assign q1_now = q1_was
        assign q2_now = q2_was
        assign q4_now = q4_was
      endif

      assign q1_save = q1_was | minus: q1_now
      assign q2_save = q2_was | minus: q2_now
      assign q4_save = q4_was | minus: q4_now

      assign checkout_suffix = ''
      if code != blank
        assign checkout_suffix = '?discount=' | append: code
      endif
    -%}
    <div class="bp-center" style="margin-bottom:44px; padding:0 24px;">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:32px;">{{ section.settings.heading }}</h2>
      <p style="color:var(--bp-muted); margin-top:12px; max-width:520px; margin-left:auto; margin-right:auto;">{{ section.settings.subheading }}</p>
    </div>

    <div class="stw-offer-grid">
      <div class="stw-bundle-card">
        <h3>1 {{ product.title }}</h3>
        <p class="stw-bundle-reason">Try it for yourself.</p>
        <div class="stw-bundle-price">
          <span class="now">{{ q1_now | money }}</span>
          {%- if code != blank -%}<span class="was">{{ q1_was | money }}</span>{%- endif -%}
        </div>
        <div class="stw-bundle-save">{% if code != blank %}You save {{ q1_save | money }} ({{ pct }}%) with {{ code }}{% else %}&nbsp;{% endif %}</div>
        <a class="stw-bundle-select" style="display:flex; align-items:center; justify-content:center; text-decoration:none;" href="/cart/{{ variant.id }}:1{{ checkout_suffix }}">Select — go to checkout</a>
      </div>

      <div class="stw-bundle-card is-popular">
        <span class="stw-bundle-badge">Most popular</span>
        <h3>2 {{ product.title }}s</h3>
        <p class="stw-bundle-reason">One for each knee — comfort on both sides.</p>
        <div class="stw-bundle-price">
          <span class="now">{{ q2_now | money }}</span>
          {%- if code != blank -%}<span class="was">{{ q2_was | money }}</span>{%- endif -%}
        </div>
        <div class="stw-bundle-save">{% if code != blank %}You save {{ q2_save | money }} ({{ pct }}%) with {{ code }}{% else %}&nbsp;{% endif %}</div>
        <a class="stw-bundle-select" style="display:flex; align-items:center; justify-content:center; text-decoration:none;" href="/cart/{{ variant.id }}:2{{ checkout_suffix }}">Select — go to checkout</a>
      </div>

      <div class="stw-bundle-card">
        <h3>2 Pairs — one each</h3>
        <p class="stw-bundle-reason">Your partner deserves one too. Four wraps: two for you, two for them.</p>
        <div class="stw-bundle-price">
          <span class="now">{{ q4_now | money }}</span>
          {%- if code != blank -%}<span class="was">{{ q4_was | money }}</span>{%- endif -%}
        </div>
        <div class="stw-bundle-save">{% if code != blank %}You save {{ q4_save | money }} ({{ pct }}%) with {{ code }}{% else %}&nbsp;{% endif %}</div>
        <a class="stw-bundle-select" style="display:flex; align-items:center; justify-content:center; text-decoration:none;" href="/cart/{{ variant.id }}:4{{ checkout_suffix }}">Select — go to checkout</a>
      </div>

      <div class="stw-bundle-card">
        <h3>Ordering in bulk?</h3>
        <p class="stw-bundle-reason">Buying for a care home, club, or the wider family? We'll sort a price for you.</p>
        <div class="stw-bundle-price"><span class="now" style="font-size:22px;">Let's talk</span></div>
        <div class="stw-bundle-save">Reply within 24 hours, 7 days a week</div>
        <a class="stw-bundle-select" style="display:flex; align-items:center; justify-content:center; text-decoration:none;" href="{{ section.settings.bulk_link | default: '/pages/support#bp-contact' }}">Contact us</a>
      </div>
    </div>

    {%- if code != blank -%}
      <p style="text-align:center; font-size:15px; color:var(--bp-muted); margin:22px auto 0; max-width:560px;">
        Code <strong style="color:var(--bp-ink);">{{ code }}</strong> is applied for you at checkout — nothing to type in. Summer Sale ends 31 August.
      </p>
    {%- endif -%}

    <div class="stw-offer-gift">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#33483A" stroke-width="2" style="flex-shrink:0;"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
      <p><b>Every order includes a large-print quick-start guide</b>Clear, easy-to-read setup instructions — no squinting at tiny print.</p>
    </div>

    <div style="max-width:640px; margin:26px auto 0; text-align:center;">
      <p style="font-size:15px; color:var(--bp-muted); margin:0 0 12px;">
        <strong style="color:var(--bp-ink);">Straight to secure checkout — no account needed.</strong>
        Free UK delivery on this item · 3–5 working days · 30-day returns.
      </p>
      <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:center;">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'stw-pay-icon' }}
        {%- endfor -%}
      </div>
      <style>.stw-pay-icon{ height:26px; width:auto; border-radius:4px; }</style>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "STW Offer",
  "tag": "section",
  "class": "section-stw-offer",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FBF8F1" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CHOOSE YOUR SET" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One for you — or share the comfort." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Many customers buy a second for the other knee, or as a gift for a parent or partner." },
    { "type": "text", "id": "discount_code", "label": "Discount code (auto-applied at checkout)", "info": "Leave blank to show full price with no code. Displayed prices use the percentage below — make sure it matches the code's real percentage in Discounts.", "default": "SUMMER20" },
    { "type": "range", "id": "discount_percent", "label": "Discount percentage shown", "min": 5, "max": 50, "step": 5, "default": 20 },
    { "type": "url", "id": "bulk_link", "label": "Bulk enquiry link", "info": "Where the 'Contact us' card points. Defaults to the support page contact section." }
  ],
  "presets": [{ "name": "STW Offer" }]
}
{% endschema %}
