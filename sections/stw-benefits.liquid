{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section stw-ben-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .stw-ben-{{ section.id }} .stw-ben-wrap{ max-width:1080px; margin:0 auto; padding:78px 24px; }
    .stw-ben-{{ section.id }} .stw-ben-grid{
      display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:38px;
    }
    .stw-ben-{{ section.id }} .stw-ben-card{
      background:#fff; border:2px solid var(--bp-line); border-radius:var(--bp-radius);
      padding:26px 24px; box-shadow:0 10px 30px rgba(38,43,51,.05);
    }
    .stw-ben-{{ section.id }} .stw-ben-ic{
      width:46px; height:46px; border-radius:12px; margin-bottom:16px;
      background:linear-gradient(135deg, var(--bp-heat-a), var(--bp-heat-b));
      color:#fff; display:flex; align-items:center; justify-content:center;
      font-size:21px; font-weight:800;
    }
    .stw-ben-{{ section.id }} .stw-ben-card h3{ font-size:19px; margin-bottom:8px; }
    .stw-ben-{{ section.id }} .stw-ben-card p{ font-size:15.5px; color:var(--bp-muted); line-height:1.6; margin:0; }
    @media (max-width:820px){
      .stw-ben-{{ section.id }} .stw-ben-wrap{ padding:52px 20px; }
      .stw-ben-{{ section.id }} .stw-ben-grid{ grid-template-columns:1fr; }
    }
  </style>
  <div class="stw-ben-wrap">
    <div class="bp-center">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:32px;">{{ section.settings.heading }}</h2>
    </div>
    <div class="stw-ben-grid">
      {% for block in section.blocks %}
        <div class="stw-ben-card" {{ block.shopify_attributes }}>
          <div class="stw-ben-ic">{{ block.settings.icon }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STW Benefits",
  "tag": "section",
  "class": "section-stw-benefits",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY IT WORKS SO WELL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three things no bottle, patch or pad gives you." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon character", "default": "♨" },
        { "type": "text", "id": "title", "label": "Title", "default": "Warmth that stays" },
        { "type": "textarea", "id": "text", "label": "Explanation", "default": "Steady heat for as long as you want it." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "STW Benefits" }]
}
{% endschema %}
