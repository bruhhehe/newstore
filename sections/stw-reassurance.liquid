{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}
{{ 'steadwell-landing.css' | asset_url | stylesheet_tag }}

<div class="bp-section stw-reassure" style="padding:88px 0;">
  <div class="bp-center" style="margin-bottom:44px; padding:0 24px;">
    <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
    <h2 style="font-size:32px; max-width:640px; margin:0 auto;">{{ section.settings.heading }}</h2>
  </div>
  <div class="stw-reassure-grid">
    {% for block in section.blocks %}
      <div class="stw-reassure-card" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.question }}</h3>
        <p>{{ block.settings.answer }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "STW Reassurance",
  "tag": "section",
  "class": "section-stw-reassurance",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "IS THIS FOR ME?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Straight answers to the questions people actually have." }
  ],
  "blocks": [
    {
      "type": "objection",
      "name": "Objection",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will it fit me?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "The adjustable strap is designed to fit most leg sizes comfortably." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "STW Reassurance",
      "blocks": [
        { "type": "objection", "settings": { "question": "Will it fit me?", "answer": "The adjustable strap is designed to fit most leg sizes comfortably — snugger or looser, depending on what feels right for you." } },
        { "type": "objection", "settings": { "question": "Is it safe to use every day?", "answer": "Yes — it's designed for regular use. As with any heat product, follow the included guide, and check with your GP first if you have a health condition." } },
        { "type": "objection", "settings": { "question": "Will this replace my doctor's treatment?", "answer": "No. It's designed for warmth, gentle compression and comfort — not to treat, prevent or cure any condition. For ongoing joint pain, please speak to your GP." } }
      ]
    }
  ]
}
{% endschema %}
