{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section stw-cmp-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .stw-cmp-{{ section.id }} .stw-cmp-wrap{ max-width:940px; margin:0 auto; padding:80px 24px; }
    .stw-cmp-{{ section.id }} table{
      width:100%; border-collapse:separate; border-spacing:0; margin-top:36px;
      background:var(--bp-bg-blush-light); border:1px solid var(--bp-line); border-radius:16px; overflow:hidden;
    }
    .stw-cmp-{{ section.id }} th, .stw-cmp-{{ section.id }} td{
      padding:16px 14px; text-align:center; font-size:16px; border-bottom:1px solid var(--bp-line);
    }
    .stw-cmp-{{ section.id }} th{ font-size:15px; font-weight:700; background:#EFE9DA; }
    .stw-cmp-{{ section.id }} td:first-child, .stw-cmp-{{ section.id }} th:first-child{
      text-align:left; font-weight:600; width:38%;
    }
    .stw-cmp-{{ section.id }} .stw-cmp-us{
      background:var(--bp-pink-deep); color:#fff; font-weight:700;
    }
    .stw-cmp-{{ section.id }} td.stw-cmp-usc{ background:rgba(184,92,36,.07); font-weight:600; }
    .stw-cmp-{{ section.id }} tr:last-child td{ border-bottom:none; }
    .stw-cmp-{{ section.id }} .yes{ color:var(--bp-green); font-weight:700; }
    .stw-cmp-{{ section.id }} .no{ color:#A2A093; }
    @media (max-width:700px){
      .stw-cmp-{{ section.id }} .stw-cmp-wrap{ padding:52px 14px; }
      .stw-cmp-{{ section.id }} th, .stw-cmp-{{ section.id }} td{ padding:13px 8px; font-size:14.5px; }
      .stw-cmp-{{ section.id }} th{ font-size:13.5px; }
      .stw-cmp-{{ section.id }} td:first-child, .stw-cmp-{{ section.id }} th:first-child{ width:34%; font-size:14px; }
    }
  </style>
  <div class="stw-cmp-wrap">
    <div class="bp-center">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:32px;">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p style="color:var(--bp-muted); margin-top:12px; max-width:560px; margin-left:auto; margin-right:auto;">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
    <table>
      <thead>
        <tr>
          <th></th>
          <th class="stw-cmp-us">Steadwell</th>
          <th>{{ section.settings.alt_1 }}</th>
          <th>{{ section.settings.alt_2 }}</th>
          <th>{{ section.settings.alt_3 }}</th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          <tr {{ block.shopify_attributes }}>
            <td>{{ block.settings.feature }}</td>
            <td class="stw-cmp-usc"><span class="yes">✓</span></td>
            <td>{% if block.settings.a1 %}<span class="yes">✓</span>{% else %}<span class="no">—</span>{% endif %}</td>
            <td>{% if block.settings.a2 %}<span class="yes">✓</span>{% else %}<span class="no">—</span>{% endif %}</td>
            <td>{% if block.settings.a3 %}<span class="yes">✓</span>{% else %}<span class="no">—</span>{% endif %}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if section.settings.cta_text != blank %}
      <div style="text-align:center; margin-top:36px;">
        <a class="bp-btn" href="{{ section.settings.cta_link | default: '/#offer' }}">{{ section.settings.cta_text }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "STW Comparison",
  "tag": "section",
  "class": "section-stw-comparison",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F2EEE4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT COMPARES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You've probably tried the others." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Most people reach for a hot water bottle or a heat patch first. Here's how they stack up." },
    { "type": "text", "id": "alt_1", "label": "Alternative 1", "default": "Hot water bottle" },
    { "type": "text", "id": "alt_2", "label": "Alternative 2", "default": "Heat patches" },
    { "type": "text", "id": "alt_3", "label": "Alternative 3", "default": "Plug-in heat pad" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "See the Summer Sale price" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Stays warm as long as you like" },
        { "type": "checkbox", "id": "a1", "label": "Alternative 1 has this", "default": false },
        { "type": "checkbox", "id": "a2", "label": "Alternative 2 has this", "default": false },
        { "type": "checkbox", "id": "a3", "label": "Alternative 3 has this", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "STW Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Stays warm — doesn't cool down", "a1": false, "a2": true, "a3": true } },
        { "type": "row", "settings": { "feature": "Straps on — hands free", "a1": false, "a2": true, "a3": false } },
        { "type": "row", "settings": { "feature": "No wires — walk around freely", "a1": true, "a2": true, "a3": false } },
        { "type": "row", "settings": { "feature": "Choose your exact temperature", "a1": false, "a2": false, "a3": true } },
        { "type": "row", "settings": { "feature": "Adds massage, not just heat", "a1": false, "a2": false, "a3": false } },
        { "type": "row", "settings": { "feature": "Reusable — no refilling or replacing", "a1": true, "a2": false, "a3": true } }
      ]
    }
  ]
}
{% endschema %}
