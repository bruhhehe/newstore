{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section stw-day-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .stw-day-{{ section.id }} .stw-day-wrap{ max-width:1180px; margin:0 auto; padding:70px 24px; }
    .stw-day-{{ section.id }} .stw-day-strip{
      display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-top:34px;
    }
    .stw-day-{{ section.id }} .stw-day-card{
      position:relative; border-radius:14px; overflow:hidden; background:#EDE7D8;
    }
    .stw-day-{{ section.id }} .stw-day-card::before{ content:""; display:block; padding-top:118%; }
    .stw-day-{{ section.id }} .stw-day-card img{
      position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
    }
    .stw-day-{{ section.id }} .stw-day-tag{
      position:absolute; left:0; right:0; bottom:0; z-index:2;
      padding:18px 10px 9px; text-align:center;
      background:linear-gradient(to top, rgba(38,43,51,.82), rgba(38,43,51,0));
      color:#fff; font-size:12.5px; font-weight:700;
    }
    @media (max-width:820px){
      .stw-day-{{ section.id }} .stw-day-strip{ grid-template-columns:repeat(3,1fr); gap:10px; }
    }
    @media (max-width:480px){
      .stw-day-{{ section.id }} .stw-day-wrap{ padding:46px 18px; }
      .stw-day-{{ section.id }} .stw-day-strip{ grid-template-columns:repeat(2,1fr); }
    }
  </style>
  <div class="stw-day-wrap">
    <div class="bp-center">
      <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 style="font-size:32px;">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p style="color:var(--bp-muted); margin-top:12px; max-width:560px; margin-left:auto; margin-right:auto;">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
    <div class="stw-day-strip">
      {% for block in section.blocks %}
        <div class="stw-day-card" {{ block.shopify_attributes }}>
          <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.label | escape }}" loading="lazy" width="320" height="380">
          <div class="stw-day-tag">{{ block.settings.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STW Daily life",
  "tag": "section",
  "class": "section-stw-daily",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GOES WHERE YOU GO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fits into your day, not just your evening." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Cordless means it comes with you — not just for the armchair." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "text", "id": "image_asset", "label": "Image asset filename" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "STW Daily life",
      "blocks": [
        { "type": "photo", "settings": { "image_asset": "tw-use-shoulder-office.jpg", "label": "At the office" } },
        { "type": "photo", "settings": { "image_asset": "tw-use-elbow-bed.jpg", "label": "Getting on with chores" } },
        { "type": "photo", "settings": { "image_asset": "tw-use-knee-sofa.jpg", "label": "Winding down" } },
        { "type": "photo", "settings": { "image_asset": "tw-use-elbow-driving.jpg", "label": "On the drive" } },
        { "type": "photo", "settings": { "image_asset": "tw-use-shoulder-desk.jpg", "label": "At the desk" } },
        { "type": "photo", "settings": { "image_asset": "tw-use-knee-dogwalk.jpg", "label": "Walking the dog" } }
      ]
    }
  ]
}
{% endschema %}
