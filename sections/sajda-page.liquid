<div class="stick">
  <div class="p" id="stick-price">£35.00 <s>£46.67</s></div>
  <a class="btn" href="#buy" id="stick-btn">Order now</a>
</div>

<script>
(function(){
  var RRP = 46.67, MAXTOTAL = 5;
  var rows = [].slice.call(document.querySelectorAll('.crow'));
  var priceP = document.getElementById('panel-price'), bulkP = document.getElementById('panel-bulk');
  var elTotal = document.getElementById('p-total'), elRrp = document.getElementById('p-rrp'),
      elSave = document.getElementById('p-save'), elEach = document.getElementById('p-each'),
      elCode = document.getElementById('p-code'), elNote = document.getElementById('p-note'),
      mixnote = document.getElementById('mixnote'),
      cta = document.getElementById('cta-buy'), stickP = document.getElementById('stick-price'),
      stickB = document.getElementById('stick-btn');
  var data = document.getElementById('sajda-buy-data');
  var NAMES = { tan: 'warm tan', black: 'classic black' };
  var qty = { tan: 1, black: 0 };

  function money(n){ return '\u00a3' + n.toFixed(2); }
  function plural(n){ return n === 1 ? 'stool' : 'stools'; }

  function describe(){
    var parts = [];
    ['tan','black'].forEach(function(k){
      if (qty[k] > 0) parts.push(qty[k] + ' ' + NAMES[k]);
    });
    return parts.join(' and ');
  }

  function render(){
    var total = qty.tan + qty.black;

    rows.forEach(function(r){
      var k = r.dataset.row;
      r.querySelector('[data-qty]').textContent = qty[k];
      r.classList.toggle('has', qty[k] > 0);
      r.querySelector('[data-minus]').disabled = qty[k] <= 0;
      // cap the pair at 5; beyond that it's a bulk enquiry
      r.querySelector('[data-plus]').disabled = total >= MAXTOTAL + 1;
    });

    // ---- beyond five: bulk enquiry ----
    if (total > MAXTOTAL){
      priceP.hidden = true; bulkP.hidden = false;
      mixnote.hidden = true;
      cta.textContent = 'Contact us about a bulk order';
      cta.setAttribute('href','/pages/contact#bulk');
      if (stickP) stickP.textContent = '6 or more';
      if (stickB) stickB.textContent = 'Enquire';
      return;
    }

    priceP.hidden = false; bulkP.hidden = true;

    // ---- nothing chosen ----
    if (total === 0){
      mixnote.hidden = true;
      elTotal.textContent = 'From ' + money(RRP * 0.75);
      elRrp.textContent = money(RRP);
      elSave.hidden = true;
      elEach.textContent = 'Choose a colour above to see your price.';
      elCode.parentNode.hidden = true;
      elNote.textContent = 'Free tracked UK delivery.';
      cta.textContent = 'Choose a colour to continue';
      cta.setAttribute('href','#buy');
      cta.setAttribute('aria-disabled','true');
      if (stickP) stickP.innerHTML = 'From ' + money(RRP * 0.75) + ' <s>' + money(RRP) + '</s>';
      if (stickB) stickB.textContent = 'Order now';
      return;
    }

    // ---- rate is set by the TOTAL, never by colour ----
    var rate = total === 1 ? 0.75 : 0.70;
    var each = Math.round(RRP * rate * 100) / 100;
    var pay  = Math.round(each * total * 100) / 100;
    var full = Math.round(RRP * total * 100) / 100;
    var code = total === 1 ? 'SAJDA25' : 'SAJDA30';

    elSave.hidden = false;
    elCode.parentNode.hidden = false;
    cta.removeAttribute('aria-disabled');

    elTotal.textContent = money(pay);
    elRrp.textContent = money(full);
    elSave.textContent = 'Save ' + money(Math.round((full - pay) * 100) / 100);
    elEach.textContent = total === 1
      ? 'One stool in ' + describe().replace(/^1 /,'') + ', at ' + money(pay) + '.'
      : describe() + ' \u2014 ' + total + ' stools at ' + money(each) + ' each.';
    elCode.textContent = code;
    elNote.textContent = total === 1
      ? 'Free tracked UK delivery.'
      : 'Free tracked UK delivery on the whole order.';

    // one stool: the upsell. two or more: reassurance that mixing is fine.
    mixnote.hidden = false;
    mixnote.innerHTML = total === 1
      ? 'Add a second in either colour and the whole order drops to <b>30% off</b>.'
      : 'Mix them however you like \u2014 <b>two or more is 30% off</b>, whatever the combination.';

    cta.textContent = 'Order ' + (total === 1 ? 'one stool' : total + ' stools') + ' \u2014 ' + money(pay);
    if (data){
      var parts = [];
      ['tan','black'].forEach(function(k){
        var id = data.dataset[k];
        if (qty[k] > 0 && id) parts.push(id + ':' + qty[k]);
      });
      cta.setAttribute('href', parts.length ? '/cart/' + parts.join(',') + '?discount=' + code : '#buy');
    }
    if (stickP) stickP.innerHTML = money(pay) + ' <s>' + money(full) + '</s>';
    if (stickB) stickB.textContent = 'Order now';
  }

  rows.forEach(function(r){
    var k = r.dataset.row;
    r.querySelector('[data-plus]').addEventListener('click', function(){
      if (qty.tan + qty.black < MAXTOTAL + 1){ qty[k]++; render(); }
    });
    r.querySelector('[data-minus]').addEventListener('click', function(){
      if (qty[k] > 0){ qty[k]--; render(); }
    });
  });
  render();
})();

(function(){
  var els = document.querySelectorAll('.rise');
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    els.forEach(function(e){ e.classList.add('in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); }
    });
  }, {rootMargin:'0px 0px -8% 0px', threshold:0.05});
  els.forEach(function(e, i){ e.style.transitionDelay = Math.min(i%6,4)*45 + 'ms'; io.observe(e); });
})();

(function(){
  var END = new Date('2026-08-31T23:59:59+01:00').getTime();
  var clock = document.getElementById('cd-clock'),
      live  = document.getElementById('cd-live'),
      done  = document.getElementById('cd-done');
  if(!clock) return;
  function pad(n){ return (n<10?'0':'') + n; }
  function tick(){
    var left = END - Date.now();
    if (left <= 0){
      live.hidden = true; done.hidden = false;
      clearInterval(timer);
      return;
    }
    var sec = Math.floor(left/1000);
    clock.textContent = Math.floor(sec/86400) + 'd '
      + pad(Math.floor(sec%86400/3600)) + 'h '
      + pad(Math.floor(sec%3600/60)) + 'm '
      + pad(sec%60) + 's';
  }
  tick();
  var timer = setInterval(tick, 1000);
})();



(function(){
  var bar = document.querySelector('.stick');
  var buy = document.getElementById('buy');
  if (!bar) return;
  bar.classList.remove('is-away');
  if (!buy || !('IntersectionObserver' in window)) return;

  // Hide only while the buy section itself is on screen — it duplicates
  // what's already in view there. Everywhere else the bar stays put.
  var io = new IntersectionObserver(function(entries){
    bar.classList.toggle('is-away', entries[0].isIntersecting);
  }, { threshold: 0.12 });
  io.observe(buy);
})();
</script>

