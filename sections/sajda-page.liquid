{%- comment -%}
  Sajda — single-page storefront.
  Faithful port of the owner-supplied sajda-prayer-stool-page_1.html:
  markup, copy, CSS and images are reproduced as delivered. Two additions
  only, both explicitly requested or required to function on Shopify:
    1. Launch countdown to 31 Aug 2026 in the #buy section.
    2. The existing CTA buttons wired to a real cart permalink so they
       actually sell (button label text unchanged).
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
<style>

:root{
  --paper:#FAF7F0; --white:#fff; --ink:#1E2622; --muted:#47534D; --line:#E4E0D4;
  --emerald:#0E5F46; --emerald-lt:#14735A; --dark:#10241C;
  --gold-a:#E8C36A; --gold-b:#C6913A; --wash:#F5EDD8; --trust:#E7F0EA;
  --sans:'Public Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
  --measure:640px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);
  font-size:18px;line-height:1.65;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:var(--emerald)}

.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
.col{max-width:var(--measure)}
.band{padding:64px 0;border-bottom:1px solid var(--line)}
.band--white{background:var(--white)}
.band--wash{background:var(--wash);border-bottom:0}
.band--ink{background:var(--dark);color:#E8EDE9;border-bottom:0}
.band--ink h2,.band--ink h3{color:#fff}
.band--ink p{color:#C9D6CE}

.eyebrow{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:800;
  letter-spacing:.15em;text-transform:uppercase;color:var(--gold-b);margin:0 0 18px}
.eyebrow::before{content:"";width:26px;height:3px;border-radius:2px;flex:none;
  background:linear-gradient(90deg,var(--gold-a),var(--gold-b))}
.band--ink .eyebrow{color:var(--gold-a)}

h1{font-size:clamp(36px,5.6vw,60px);font-weight:800;letter-spacing:-.03em;line-height:1.06;margin:0 0 20px}
h2{font-size:clamp(27px,3.6vw,38px);font-weight:800;letter-spacing:-.025em;line-height:1.15;margin:0 0 14px;max-width:15ch}
h2.wide{max-width:20ch}
h3{font-size:19px;font-weight:800;letter-spacing:-.01em;margin:34px 0 8px}
p{margin:0 0 15px;max-width:var(--measure)}
.lede{font-size:21px;color:var(--muted);line-height:1.55}
.small{font-size:14px;color:var(--muted);line-height:1.6}
strong{font-weight:700}

/* ---------- announcement + header ---------- */
.announce{background:var(--dark);color:#C9D6CE;font-size:13.5px;text-align:center;padding:11px 20px;letter-spacing:.01em}
.announce b{color:var(--gold-a);font-weight:700}
.head{background:var(--paper);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:40}
.head .wrap{display:flex;align-items:center;justify-content:space-between;height:72px;gap:20px}
.head img{width:132px}
.head .links{display:flex;gap:26px;font-size:14.5px;font-weight:600}
.head .links a{color:var(--muted);text-decoration:none}
.head .links a:hover{color:var(--emerald)}
@media(max-width:820px){.head .links{display:none}}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;
  background:linear-gradient(180deg,var(--emerald-lt),var(--emerald));color:#fff;
  font-weight:800;font-size:17px;letter-spacing:.01em;text-decoration:none;
  padding:17px 34px;border-radius:10px;border:0;cursor:pointer;
  box-shadow:0 1px 0 rgba(255,255,255,.18) inset,0 6px 18px rgba(14,95,70,.22)}
.btn:hover{filter:brightness(1.06)}
.btn--ghost{background:transparent;color:var(--emerald);border:1.5px solid var(--emerald);box-shadow:none}
.btn--ghost:hover{background:var(--trust);filter:none}
.cta-note{font-size:13.5px;color:var(--muted);margin:14px 0 0}

/* ---------- hero ---------- */
.hero{padding:48px 0 56px;border-bottom:1px solid var(--line)}
.hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}
.hero .price{display:flex;align-items:baseline;gap:12px;margin:0 0 6px}
.hero .price .now{font-size:38px;font-weight:800;letter-spacing:-.03em;color:var(--emerald)}
.hero .price .was{font-size:17px;color:var(--muted);text-decoration:line-through}
.hero .price .code{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  color:var(--emerald);background:var(--trust);border-radius:999px;padding:5px 11px}
.hero ul{list-style:none;padding:0;margin:26px 0 30px;font-size:16px}
.hero ul li{padding:9px 0 9px 28px;border-top:1px solid var(--line);position:relative;color:var(--muted)}
.hero ul li:last-child{border-bottom:1px solid var(--line)}
.hero ul li::before{content:"";position:absolute;left:2px;top:18px;width:9px;height:9px;
  border-radius:50%;background:linear-gradient(180deg,var(--gold-a),var(--gold-b))}
.hero ul li b{color:var(--ink);font-weight:700}

/* the mihrab arch as a real frame — brand signature */
.arch{position:relative;padding:18px}
.arch::before{content:"";position:absolute;inset:0;border:2px solid rgba(198,145,58,.34);
  border-radius:50% 50% 8px 8px / 32% 32% 3% 3%;pointer-events:none}
.arch img{border-radius:50% 50% 6px 6px / 30% 30% 2% 2%;width:100%;
  aspect-ratio:4/5;object-fit:cover;object-position:52% 40%}
@media(max-width:900px){
  .hero .wrap{grid-template-columns:1fr;gap:40px}
  .hero{padding:34px 0 40px}
  .band{padding:46px 0}
  .arch{order:-1;max-width:420px;margin:0 auto}
}

/* ---------- full-bleed photo ---------- */
.bleed{position:relative;border-bottom:1px solid var(--line)}
.bleed img{width:100%;height:clamp(300px,52vw,560px);object-fit:cover}
.bleed figcaption{position:absolute;left:0;right:0;bottom:0;padding:26px 24px;
  background:linear-gradient(180deg,rgba(16,36,28,0),rgba(16,36,28,.82));
  color:#F2EFE6;font-size:15px}
.bleed figcaption span{display:block;max-width:1032px;margin:0 auto}

/* ---------- the sequence ---------- */
.seq{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:44px 0 0;
  border-top:1px solid var(--line)}
.seq > div{padding:26px 26px 26px 0;border-right:1px solid var(--line)}
.seq > div:last-child{border-right:0;padding-right:0}
.seq > div:not(:first-child){padding-left:26px}
.seq .pos{font-size:12px;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:var(--gold-b);margin:0 0 10px}
.seq h4{margin:0 0 6px;font-size:18px;font-weight:800;letter-spacing:-.01em}
.seq p{margin:0;font-size:15.5px;color:var(--muted);line-height:1.6}
@media(max-width:760px){
  .seq{grid-template-columns:1fr}
  .seq > div{border-right:0;border-bottom:1px solid var(--line);padding:22px 0}
  .seq > div:not(:first-child){padding-left:0}
  .seq > div:last-child{border-bottom:0}
}

/* ---------- the 25cm rule — signature element ---------- */
.rulewrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;margin-top:16px}
.rule{position:relative;height:412px;margin:18px 0 0;padding:0 0 0 56px}
.rule .axis{position:absolute;left:40px;bottom:0;height:376px;width:1px;background:var(--line)}
.rule .tick{position:absolute;left:40px;height:1px;background:var(--line);width:9px}
.rule .tick span{position:absolute;right:15px;top:-9px;font-size:11px;color:var(--muted);
  font-variant-numeric:tabular-nums;letter-spacing:.05em;width:40px;text-align:right}
.rule .floor{position:absolute;left:0;right:44px;bottom:0;height:2px;background:var(--ink)}
.rule .floor span{position:absolute;left:0;bottom:9px;font-size:11px;font-weight:800;
  letter-spacing:.14em;text-transform:uppercase;color:var(--ink)}
.rule .mark{position:absolute;left:56px;right:44px;height:0;border-top:2px dashed rgba(71,83,77,.4)}
.rule .mark b{position:absolute;left:0;top:-12px;font-size:14px;font-weight:700;color:var(--muted);
  background:var(--paper);padding:1px 9px 1px 0;white-space:nowrap;line-height:1.6}
.rule .mark.is-sajda{border-top:3px solid var(--emerald)}
.rule .mark.is-sajda b{color:var(--emerald);font-weight:800;font-size:16.5px;top:-14px}
.rule .band-heel{position:absolute;left:56px;right:44px;bottom:0;background:var(--trust)}
.rule .gap{position:absolute;right:20px;width:3px;border-radius:2px;
  background:linear-gradient(180deg,var(--gold-a),var(--gold-b))}
.rule .gap i{position:absolute;right:-6px;top:50%;transform:translateY(-50%) rotate(90deg);
  transform-origin:center;font-style:normal;font-size:12px;font-weight:800;color:var(--gold-b);
  white-space:nowrap;letter-spacing:.08em}
@media(max-width:900px){.rulewrap{grid-template-columns:1fr;gap:34px}}
@media(max-width:420px){.rule .mark b{font-size:12.5px}.rule .mark.is-sajda b{font-size:14px}}

/* ---------- comparison table ---------- */
.vs{width:100%;border-collapse:collapse;margin-top:30px;font-size:16.5px}
.vs th,.vs td{padding:15px 16px;border-bottom:1px solid var(--line);text-align:left}
.vs thead th{font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);font-weight:800}
.vs thead th.mine{color:var(--emerald)}
.vs td.mine{font-weight:700;color:var(--emerald);background:rgba(231,240,234,.5)}
.vs td.attr{color:var(--muted);font-size:14.5px}

/* ---------- spec list ---------- */
.spec{width:100%;border-collapse:collapse;font-size:16.5px;margin-top:8px}
.spec th{width:210px;text-align:left;padding:14px 0;border-bottom:1px solid var(--line);
  font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:800;vertical-align:top}
.spec td{padding:14px 0;border-bottom:1px solid var(--line)}
@media(max-width:640px){
  .spec th{display:block;border-bottom:0;padding-bottom:2px}
  .spec td{display:block;padding-top:0}
}

/* ---------- cards / notes ---------- */
.note{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:28px 30px;margin:30px 0 0}
.note.plain{background:transparent}
.band--wash .note{background:rgba(255,255,255,.62);border-color:rgba(198,145,58,.28)}
.note h3{margin-top:0}
.note p:last-child{margin-bottom:0}
.script{border-left:3px solid var(--gold-b);padding:6px 0 6px 22px;margin:22px 0;
  font-size:20px;font-weight:600;letter-spacing:-.01em;line-height:1.5;max-width:var(--measure)}
.src{font-size:14px;color:var(--muted);margin-top:-6px}

/* ---------- two-up image grid ---------- */
.realshots{margin:34px auto 0;max-width:760px}
.realshots .rl{margin:0 0 12px;font-size:12px;font-weight:800;letter-spacing:.14em;
  text-transform:uppercase;color:var(--gold-b);max-width:none}
.realgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.realgrid figure{margin:0}
.realgrid img{width:100%;height:auto;border-radius:12px;border:1px solid var(--line);background:#fff}
.realgrid figcaption{margin-top:8px;font-size:13.5px;color:var(--muted);font-weight:600}
@media(max-width:560px){.realgrid{gap:10px}}
.imgnote{margin:18px auto 0;max-width:760px;font-size:13.5px;line-height:1.6;
  color:var(--muted);padding:16px 18px;background:var(--wash);border-radius:12px}
.duo{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:36px}
.duo figure{margin:0}
.duo img{border-radius:14px;width:100%;aspect-ratio:1;object-fit:cover;border:1px solid var(--line)}
.duo figcaption{font-size:14px;color:var(--muted);padding-top:10px}
@media(max-width:700px){.duo{grid-template-columns:1fr}}

/* ---------- offer ---------- */
.offer{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:34px 0 0}
.tier{background:rgba(255,255,255,.06);border:1px solid rgba(232,195,106,.24);border-radius:16px;padding:24px}
.tier.pick{border-color:var(--gold-a);background:rgba(232,195,106,.09)}
.tier .qty{font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-a);margin:0 0 10px}
.tier .amt{font-size:31px;font-weight:800;letter-spacing:-.03em;color:#fff;margin:0}
.tier .rrp{font-size:14px;color:#8FA79A;margin:2px 0 12px}
.tier .rrp s{opacity:.85}
.tier .use{font-size:13.5px;color:#C9D6CE;margin:0}
.tier .use b{color:var(--gold-a);letter-spacing:.06em}
@media(max-width:760px){.offer{grid-template-columns:1fr}}

/* ---------- faq ---------- */
.faq{margin-top:14px;max-width:760px}
.faq details{border-bottom:1px solid var(--line)}
.faq summary{cursor:pointer;list-style:none;padding:20px 40px 20px 0;position:relative;
  font-size:18px;font-weight:700;letter-spacing:-.01em}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";position:absolute;right:8px;top:17px;font-size:24px;
  font-weight:400;color:var(--gold-b);line-height:1}
.faq details[open] summary::after{content:"–"}
.faq .a{padding:0 0 22px;color:var(--muted);font-size:16.5px}
.faq .a p{margin:0 0 12px}
.faq .a p:last-child{margin:0}

/* ---------- footer ---------- */
footer{background:var(--dark);color:#8FA79A;padding:52px 0 60px;font-size:14.5px}
footer img{width:150px;margin:0 0 22px}
footer a{color:#C9D6CE}
footer .fine{margin-top:22px;padding-top:20px;border-top:1px solid rgba(255,255,255,.1);font-size:13px;line-height:1.7}

/* ---------- mobile sticky buy ---------- */
.stick{position:fixed;left:0;right:0;bottom:0;z-index:50;display:none;gap:14px;align-items:center;
  background:rgba(250,247,240,.97);border-top:1px solid var(--line);padding:12px 18px;
  backdrop-filter:blur(8px)}
.stick .p{font-size:15px;font-weight:800;color:var(--emerald);white-space:nowrap}
.stick .p s{font-weight:400;color:var(--muted);font-size:13px;margin-left:6px}
.stick .btn{flex:1;padding:14px 18px;font-size:16px}
.stick{transition:transform .25s ease, opacity .2s ease}
.stick.is-away{transform:translateY(120%);opacity:0;pointer-events:none}
@media(prefers-reduced-motion:reduce){.stick{transition:none}}
@media(max-width:820px){.stick{display:flex}body{padding-bottom:80px}}

/* ---------- motion ---------- */
.rise{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease}
.rise.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rise{opacity:1;transform:none;transition:none}
}
/* ---------- offer / quantity picker ---------- */
.picker{margin:26px 0 0;max-width:720px}
.picker-lbl{margin:0 0 12px;color:#8FA79A;font-weight:700;letter-spacing:.1em;
  text-transform:uppercase;font-size:12px}
.crow{display:flex;align-items:center;justify-content:space-between;gap:14px;
  background:rgba(255,255,255,.05);border:1.5px solid rgba(232,195,106,.22);
  border-radius:14px;padding:12px 14px 12px 16px;margin:0 0 10px;
  transition:border-color .15s,background .15s}
.crow.has{border-color:var(--gold-a);background:rgba(232,195,106,.09)}
.crow .cname{display:flex;align-items:center;gap:11px;font-size:16px;font-weight:700;color:#E8EDE9}
.crow .cdot{width:18px;height:18px;border-radius:50%;flex:none;
  border:1px solid rgba(0,0,0,.3);box-shadow:0 1px 2px rgba(0,0,0,.25)}
.crow .cdot.tan{background:#A5613A}
.crow .cdot.black{background:#1B1B1B}
.step{display:flex;align-items:center;gap:0;flex:none;
  border:1.5px solid rgba(232,195,106,.3);border-radius:11px;overflow:hidden;background:rgba(0,0,0,.18)}
.step button{appearance:none;border:0;background:transparent;color:var(--gold-a);
  font-family:inherit;font-size:21px;font-weight:800;line-height:1;
  width:46px;height:46px;cursor:pointer;transition:background .12s,color .12s}
.step button:hover:not(:disabled){background:rgba(232,195,106,.16)}
.step button:disabled{color:rgba(232,195,106,.28);cursor:default}
.step output{width:42px;text-align:center;font-size:17px;font-weight:800;color:#fff;
  font-variant-numeric:tabular-nums}
.mixnote{margin:2px 0 18px;font-size:14px;color:#8FA79A;line-height:1.55}
.mixnote b{color:var(--gold-a)}

.panel{background:rgba(255,255,255,.06);border:1px solid rgba(232,195,106,.24);
  border-radius:18px;padding:28px 30px}
.panel .row{display:flex;align-items:baseline;flex-wrap:wrap;gap:14px}
.panel .total{font-size:44px;font-weight:800;letter-spacing:-.035em;color:#fff;line-height:1}
.panel .rrp{font-size:16px;color:#8FA79A}
.panel .rrp s{opacity:.9}
.panel .save{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  color:var(--dark);background:var(--gold-a);border-radius:999px;padding:5px 12px}
.panel .each{font-size:15px;color:#C9D6CE;margin:12px 0 0}
.panel .codeline{margin:20px 0 0;padding:16px 0 0;border-top:1px solid rgba(255,255,255,.12);
  font-size:15px;color:#C9D6CE}
.panel .codeline b{color:var(--gold-a);font-weight:800;letter-spacing:.08em;
  font-family:ui-monospace,Menlo,monospace;font-size:15.5px}
.panel .use{font-size:14px;color:#8FA79A;margin:8px 0 0}
.panel[hidden]{display:none}
.panel.bulk p{color:#C9D6CE;margin:0 0 14px;max-width:52ch}
.panel.bulk p:last-child{margin:0}
.panel.bulk a{color:var(--gold-a);font-weight:700}

:focus-visible{outline:3px solid var(--gold-b);outline-offset:3px;border-radius:4px}
.faq summary:focus{outline:none}
.faq summary:focus-visible{outline:2px solid var(--gold-b);outline-offset:-2px;border-radius:6px}
html,body{overflow-x:hidden;max-width:100%}

/* portrait pairing — used where the source image must not be cropped */
.pair{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:44px;align-items:start;margin-top:40px}
.pair img{border-radius:16px;width:100%;height:auto;border:1px solid var(--line)}
.pair h3:first-child{margin-top:0}
@media(max-width:820px){.pair{grid-template-columns:1fr;gap:30px}.pair figure{max-width:420px}}
.standalone{margin:0 auto;max-width:560px;text-align:left}
.standalone img{border-radius:16px;width:100%;height:auto}
.standalone figcaption{font-size:14px;color:var(--muted);padding-top:12px}

/* ---------- launch countdown (added) ---------- */
.cd{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin:4px 0 18px;
  font-size:14px;color:#8FA79A}
.cd b{color:var(--gold-a);font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:.01em}
.cd .cd-done{color:#C9D6CE}


/* ---------- mobile: fit the whole buy decision on one screen ----------
   Kept last in the stylesheet deliberately: an earlier 560px block used to
   sit mid-sheet and override these. Desktop is untouched. */
@media(max-width:560px){
  #buy h2{font-size:26px}
  #buy .lede,#buy > .wrap > .col > p{font-size:15.5px}
  .picker{margin-top:26px}
  .crow{padding:9px 10px 9px 13px;margin-bottom:8px;border-radius:12px}
  .crow .cname{font-size:15px;gap:9px}
  .crow .cdot{width:16px;height:16px}
  .step button{width:42px;height:42px;font-size:20px}
  .step output{width:38px;font-size:16px}
  .mixnote{margin-bottom:18px;font-size:13.5px}
  .panel{padding:18px 18px}
  .panel .total{font-size:32px}
  .panel .each{font-size:14.5px}
  .panel .use{display:none}          /* already in the sticky + announcement bars */
  .cd{margin-bottom:18px;font-size:13px}
  #cta-buy{display:block;width:100%;text-align:center;padding:16px 18px}
}
</style>

<div class="sajda-page">


<div class="announce">Launch price until 31 August — <b>£35</b> with code SAJDA25 · Free tracked UK delivery</div>

<header class="head">
  <div class="wrap">
    <a href="#top" aria-label="Sajda home"><img src="{{ 'sajda-img-01.png' | asset_url }}" alt="Sajda"></a>
    <nav class="links">
      <a href="#how">How it works</a>
      <a href="#permission">Is it allowed?</a>
      <a href="#specs">Specifications</a>
      <a href="/blogs/journal">Journal</a>
      <a href="#buy">Price</a>
    </nav>
  </div>
</header>

<!-- ================= HERO ================= -->
<section class="hero" id="top">
  <div class="wrap">
    <div>
      <p class="eyebrow">The prayer stool</p>
      <h1>It was never the sujud. It's the sitting in between.</h1>
      <p class="lede">A 25cm prayer stool for the one part of salah your knees won't hold. You still stand for qiyam. Your forehead still goes to the floor. You just stop sitting back on your ankles.</p>

      <ul>
        <li><b>25cm</b> — low enough to stay level with the row</li>
        <li><b>Sujud stays on the floor</b> — no shelf, nothing under your head</li>
        <li><b>1.2kg</b> — carried to the masjid in one hand</li>
        <li><b>Holds up to 200kg</b> — light to carry, built to take your weight</li>
      </ul>

      <div class="price">
