<div class="stick">
  <div class="p" id="stick-price">£35.00 <s>£46.67</s></div>
  <a class="btn" href="#buy" id="stick-btn">Order now</a>
</div>

<script>
(function(){
  var RRP = 46.67, MAX = 5;
  var qty = { tan: 1, black: 0 };
  var rows = [].slice.call(document.querySelectorAll('.line'));
  var data = document.getElementById('sajda-buy-data');
  var el = {
    items: document.getElementById('s-items'),
    sub:   document.getElementById('s-sub'),
    dlbl:  document.getElementById('s-dlabel'),
    disc:  document.getElementById('s-disc'),
    was:   document.getElementById('s-was'),
    total: document.getElementById('s-total'),
    upsell:document.getElementById('upsell'),
    cta:   document.getElementById('cta-buy'),
    stickP:document.getElementById('stick-price'),
    stickB:document.getElementById('stick-btn'),
    bump:  document.getElementById('bump-check'),
    bumpRow:document.getElementById('s-bump-row'),
    bumpPrice:document.getElementById('s-bump-price')
  };
  if (!rows.length || !el.cta) return;
  function money(n){ return '\u00a3' + n.toFixed(2); }
  // marginal cost of stool #2: pay(2 at 30% off) minus pay(1 at 25% off)
  var EACH1 = Math.round(RRP * 0.75 * 100) / 100;
  var EACH2 = Math.round(RRP * 0.70 * 100) / 100;
  var SECOND = Math.round((EACH2 * 2 - EACH1) * 100) / 100;

  function render(){
    var total = qty.tan + qty.black;
    var rate  = total >= 2 ? 0.70 : 0.75;
    var each  = Math.round(RRP * rate * 100) / 100;

    rows.forEach(function(r){
      var k = r.dataset.row, q = qty[k];
      r.querySelector('[data-qty]').textContent = q;
      r.querySelector('[data-minus]').disabled = q <= 0;
      r.querySelector('[data-plus]').disabled = total >= MAX;
      r.classList.toggle('is-off', q === 0);
      r.querySelector('[data-each]').textContent = q > 0
        ? q + ' \u00d7 ' + money(each)
        : money(each) + ' each';
    });

    if (total === 0){
      if (el.bumpRow) el.bumpRow.hidden = true;
      el.items.textContent = 'No stools selected';
      el.sub.textContent = '\u2014';
      el.dlbl.textContent = 'Launch discount';
      el.disc.textContent = '\u2014';
      el.was.textContent = '';
      el.total.textContent = money(Math.round(RRP * 0.75 * 100) / 100);
      el.upsell.innerHTML = 'Pick a colour above to see your price.';
      el.cta.textContent = 'Choose a colour';
      el.cta.setAttribute('href', '#buy');
      el.cta.style.opacity = '.55';
      if (el.stickP) el.stickP.innerHTML = 'From ' + money(Math.round(RRP * 0.75 * 100) / 100);
      return;
    }

    var full = Math.round(RRP * total * 100) / 100;
    var pay  = Math.round(each * total * 100) / 100;
    var stoolsOnly = pay;   // the product price, before any add-on
    var code = total >= 2 ? 'SAJDA30' : 'SAJDA25';

    var bumpOn = !!(el.bump && el.bump.checked);
    var bumpP  = bumpOn ? (parseFloat(el.bump.dataset.price) || 0) : 0;
    if (el.bumpRow){
      el.bumpRow.hidden = !bumpOn;
      if (bumpOn && el.bumpPrice) el.bumpPrice.textContent = '+' + money(bumpP);
    }

    el.cta.style.opacity = '1';
    el.items.textContent = total + (total === 1 ? ' stool' : ' stools');
    el.sub.textContent = money(full);
    el.dlbl.textContent = 'Launch discount (' + (total >= 2 ? '30' : '25') + '%)';
    el.disc.textContent = '\u2212' + money(Math.round((full - pay) * 100) / 100);
    el.was.textContent = money(Math.round((full + bumpP) * 100) / 100);
    el.total.textContent = money(Math.round((pay + bumpP) * 100) / 100);
    el.upsell.innerHTML = total === 1
      ? 'The second stool costs <b>' + money(SECOND) + '</b>, not ' + money(EACH1) + ' \u2014 both drop to 30% off. <button type="button" id="add-second">+ Add a second</button>'
      : 'Mix them however you like \u2014 two or more is 30% off.';
    var addBtn = document.getElementById('add-second');
    if (addBtn) addBtn.addEventListener('click', function(){
      if (qty.tan + qty.black >= MAX) return;
      var k = qty.tan > 0 ? 'tan' : 'black';   // second of the colour they chose
      qty[k]++; render();
    });
    el.cta.textContent = 'Checkout';

    if (data){
      var parts = [];
      ['tan','black'].forEach(function(k){
        var id = data.dataset[k];
        if (qty[k] > 0 && id) parts.push(id + ':' + qty[k]);
      });
      if (bumpOn && el.bump.dataset.variant) parts.push(el.bump.dataset.variant + ':1');
      el.cta.setAttribute('href', parts.length
        ? '/cart/' + parts.join(',') + '?discount=' + code
        : '#buy');
    }
    if (el.stickP) el.stickP.innerHTML = money(stoolsOnly) + ' <s>' + money(full) + '</s>';
    if (el.stickB) el.stickB.textContent = 'Order now';
  }

  if (el.bump) el.bump.addEventListener('change', render);

  // gallery
  var galMain = document.getElementById('gal-main'), galCap = document.getElementById('gal-cap');
  var strip = document.querySelectorAll('.gal .strip button');
  var CAPS = {
    tan:   'Warm tan \u00b7 illustrative \u2014 colour may vary slightly due to lighting',
    black: 'Classic black \u00b7 illustrative \u2014 colour may vary slightly due to lighting',
    pair:  'Both colours \u2014 illustrative',
    use:   'In use \u00b7 supplier photograph',
    spec:  '25cm seat, welded steel frame, curved runners \u2014 illustrative'
  };
  function showGal(key){
    var btn = document.querySelector('.gal .strip button[data-gal="' + key + '"]');
    if (!btn || !galMain) return;
    galMain.src = btn.querySelector('img').src;
    galMain.alt = btn.querySelector('img').alt;
    if (galCap) galCap.textContent = CAPS[key] || '';
    strip.forEach(function(t){ t.setAttribute('aria-pressed', String(t === btn)); });
  }
  strip.forEach(function(t){
    t.addEventListener('click', function(){ showGal(t.dataset.gal); });
  });

  rows.forEach(function(r){
    var k = r.dataset.row;
    r.querySelector('[data-plus]').addEventListener('click', function(){
      if (qty.tan + qty.black < MAX){
        var was = qty[k];
        qty[k]++;
        render();
        if (was === 0) showGal(k);
      }
    });
    r.querySelector('[data-minus]').addEventListener('click', function(){
      if (qty[k] > 0){ qty[k]--; render(); }
    });
  });
  render();
})();

(function(){
  var els = document.querySelectorAll('.rise');
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    els.forEach(function(e){ e.classList.add('in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); }
    });
  }, {rootMargin:'0px 0px -8% 0px', threshold:0.05});
  els.forEach(function(e, i){ e.style.transitionDelay = Math.min(i%6,4)*45 + 'ms'; io.observe(e); });
})();





(function(){
  var bar = document.querySelector('.stick');
  var buy = document.getElementById('buy');
  if (!bar) return;
  bar.classList.remove('is-away');
  if (!buy || !('IntersectionObserver' in window)) return;

  // Hide only while the buy section itself is on screen — it duplicates
  // what's already in view there. Everywhere else the bar stays put.
  var io = new IntersectionObserver(function(entries){
    bar.classList.toggle('is-away', entries[0].isIntersecting);
  }, { threshold: 0.12 });
  io.observe(buy);
})();

(function(){
  var END = new Date('2026-08-31T23:59:59+01:00').getTime();
  var txt = document.getElementById('ends-txt');
  var ann = document.getElementById('announce-left');
  if (!txt) return;
  function pad(n){ return (n < 10 ? '0' : '') + n; }
  function tick(){
    var left = END - Date.now();
    if (left <= 0){
      txt.textContent = 'The launch price has ended';
      if (ann) ann.textContent = '';
      clearInterval(timer);
      return;
    }
    var s = Math.floor(left / 1000);
    var d = Math.floor(s / 86400);
    var h = Math.floor((s % 86400) / 3600);
    var m = Math.floor((s % 3600) / 60);
    var sec = s % 60;
    txt.innerHTML = 'Ends 31 August &middot; <b>' + d + 'd ' + pad(h) + 'h ' + pad(m) + 'm ' + pad(sec) + 's</b>';
    if (ann) ann.innerHTML = ' \u00b7 ends in <b>' + d + 'd ' + pad(h) + 'h</b>';
  }
  tick();
  var timer = setInterval(tick, 1000);
})();

(function(){
  // Concrete delivery window: dispatch 1\u20133 working days + 7\u201310 day delivery
  // \u2248 8\u201313 calendar days out. Same promise as the copy, made specific.
  var span = document.getElementById('del-window');
  if (!span) return;
  function fmt(d){
    return d.toLocaleDateString('en-GB', { weekday:'short', day:'numeric', month:'short' });
  }
  var a = new Date(); a.setDate(a.getDate() + 8);
  var b = new Date(); b.setDate(b.getDate() + 13);
  span.innerHTML = 'Order today \u2014 typically arrives between <b>' + fmt(a) + '</b> and <b>' + fmt(b) + '</b>';
})();

(function(){
  // Anchor links to #buy were landing in the section's top padding, above
  // the card. Scroll to the card itself, offset for the sticky header.
  var head = document.querySelector('.head');
  function target(){
    // land on the purchase controls, not the gallery above them. On desktop
    // the details column starts level with the card, so this is the same
    // place; on mobile it skips the stacked image and puts the colour rows,
    // price and Checkout button on screen.
    return document.querySelector('.buycard .inner')
        || document.querySelector('.buycard')
        || document.getElementById('buy');
  }
  function jump(e){
    var el = target();
    if (!el) return;
    e.preventDefault();
    var offset = (head ? head.offsetHeight : 0) + (window.innerWidth <= 900 ? 10 : 14);
    var y = el.getBoundingClientRect().top + window.pageYOffset - offset;
    window.scrollTo({ top: y, behavior: 'smooth' });
    history.replaceState(null, '', '#buy');
  }
  document.querySelectorAll('a[href="#buy"], a[href$="#buy"]').forEach(function(a){
    if (a.getAttribute('href').indexOf('#buy') === 0 || a.getAttribute('href') === '#buy'){
      a.addEventListener('click', jump);
    }
  });
})();



(function(){
  // If Judge.me reports real reviews, replace the honest placeholder with
  // the actual rating. Until then the strip says plainly that it's empty,
  // and the widget itself is collapsed to one row via .is-empty.
  var strip = document.getElementById('revstrip'),
      count = document.getElementById('rs-count'),
      note  = document.getElementById('rs-note'),
      band  = document.getElementById('sajda-reviews');
  if (band) band.classList.add('is-empty');
  if (!strip) return;
  function check(){
    var badge = document.querySelector('.jdgm-prev-badge[data-number-of-reviews]');
    if (!badge) return false;
    var n = parseInt(badge.getAttribute('data-number-of-reviews'), 10) || 0;
    var avg = parseFloat(badge.getAttribute('data-average-rating')) || 0;
    if (n < 1) return false;
    if (band) band.classList.remove('is-empty');
    strip.classList.add('has-reviews');
    count.textContent = avg.toFixed(1) + ' / 5 \u00b7 ' + n + (n === 1 ? ' review' : ' reviews');
    note.innerHTML = 'Every one of these is from someone who paid for a stool. We don\u2019t write them, we don\u2019t edit them, and we don\u2019t quietly remove the ones that sting. <a href="#sajda-reviews">Read them.</a>';
    return true;
  }
  if (!check()){
    var obs = new MutationObserver(function(){ if (check()) obs.disconnect(); });
    obs.observe(document.body, { childList: true, subtree: true });
    setTimeout(function(){ obs.disconnect(); }, 12000);
  }
})();
</script>

