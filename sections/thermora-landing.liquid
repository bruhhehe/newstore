<div class="stickybar" id="stickybar" aria-hidden="true">
  <div class="stickybar-in">
    <img class="mini" src="{{ 'th-hero-thumb.jpg' | asset_url }}" alt="" width="44" height="44" loading="lazy">
    <div class="info">
      <b>Thermora Heated Joint Massager</b>
      <span id="stickyPrice">{{ pair_disp }} · pair</span>
    </div>
    <a class="cta" href="#buy" id="stickyCta">Add to cart</a>
  </div>
</div>

</div>

<script>
(function(){
  var page=document.getElementById('th-page');
  var reduceMotion=window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var saleEnded=false;

  // ---- countdown timers (announce bar + sale chip) ----
  var timers=page.querySelectorAll('.th-timer');
  function endSale(){
    if(saleEnded)return; saleEnded=true;
    page.querySelectorAll('.sale-only').forEach(function(el){el.style.display='none';});
  }
  if(timers.length){
    var end=new Date(timers[0].getAttribute('data-end')).getTime();
    if(!isNaN(end)){
      var pad=function(n){return (n<10?'0':'')+n};
      var tick=function(){
        var d=end-Date.now();
        if(d<=0){endSale();return;}
        var days=Math.floor(d/864e5), h=Math.floor(d%864e5/36e5), m=Math.floor(d%36e5/6e4), s=Math.floor(d%6e4/1e3);
        var txt=(days>0?days+'d ':'')+pad(h)+':'+pad(m)+':'+pad(s);
        timers.forEach(function(t){t.textContent=txt});
        setTimeout(tick,1000);
      };
      tick();
    }
  }

  // ---- gallery: image/video swapper ----
  var main=document.getElementById('galleryMain');
  var thumbs=page.querySelectorAll('.thumb');
  function showMedia(t){
    thumbs.forEach(function(x){x.setAttribute('aria-pressed','false')});
    t.setAttribute('aria-pressed','true');
    main.innerHTML='';
    if(t.getAttribute('data-type')==='video'){
      main.classList.add('is-video');
      var v=document.createElement('video');
      v.src=t.getAttribute('data-src');
      v.poster=t.getAttribute('data-poster')||'';
      v.muted=true; v.loop=true; v.playsInline=true; v.setAttribute('playsinline','');
      v.controls=true; v.preload='metadata';
      main.appendChild(v);
      if(!reduceMotion){ v.play().catch(function(){}); }
    }else{
      main.classList.remove('is-video');
      var img=document.createElement('img');
      img.src=t.getAttribute('data-src');
      img.alt=t.getAttribute('data-alt')||'';
      main.appendChild(img);
    }
  }
  thumbs.forEach(function(t){ t.addEventListener('click',function(){showMedia(t)}); });

  // ---- quantity tiles → prices, CTA label, form quantity, discount code ----
  var tiles=page.querySelectorAll('.tile');
  var priceMain=document.getElementById('priceMain');
  var ctaPrice=document.getElementById('ctaPrice');
  var priceNote=document.getElementById('priceNote');
  var stickyPrice=document.getElementById('stickyPrice');
  var qtyInput=document.getElementById('lpQty');
  var planEl=document.getElementById('thPlan');
  var planTotalEl=document.getElementById('thPlanTotal');
  var planUnit=0;
  if(planEl){
    // parse the unit price once from the rendered money string
    planUnit=parseFloat((planEl.getAttribute('data-price')||'').replace(/[^0-9.]/g,''))||0;
  }
  function currentQty(){
    var t=page.querySelector('.tile[aria-pressed="true"]');
    return t ? (parseInt(t.getAttribute('data-qty'),10)||1) : 1;
  }
  function money(n){ return '\u00a3'+(n%1===0?n.toFixed(0):n.toFixed(2)); }
  function packTotal(){
    var t=page.querySelector('.tile[aria-pressed="true"]');
    if(!t)return 0;
    return parseFloat((t.getAttribute('data-total')||'').replace(/[^0-9.]/g,''))||0;
  }
  // CTA and sticky bar always show what the customer will actually be charged,
  // so ticking the add-on can never surprise them at checkout.
  function refreshPlan(){
    var checked = !!(planEl && planEl.checked);
    if(planTotalEl){
      // flat fee per order — deliberately does NOT multiply by pack size
      planTotalEl.style.opacity = checked ? '1' : '.6';
    }
    var grand = packTotal() + (checked ? planUnit : 0);
    if(ctaPrice) ctaPrice.textContent = money(grand);
    var t=page.querySelector('.tile[aria-pressed="true"]');
    if(stickyPrice && t){
      stickyPrice.textContent = money(grand) + ' \u00b7 ' + (t.getAttribute('data-sticky')||'').split('\u00b7').pop().trim();
    }
    if(priceNote && t){
      priceNote.textContent = t.getAttribute('data-note') + (checked ? ' \u00b7 incl. priority handling' : '');
    }
  }
  if(planEl){ planEl.addEventListener('change',refreshPlan); }

  function select(tile){
    tiles.forEach(function(x){x.setAttribute('aria-pressed','false');x.setAttribute('aria-checked','false')});
    tile.setAttribute('aria-pressed','true');tile.setAttribute('aria-checked','true');
    priceMain.textContent=tile.getAttribute('data-total');
    var vEl=document.getElementById('lpVariant');
    if(vEl){ vEl.value=tile.getAttribute('data-variant'); }
    refreshPlan();
  }
  tiles.forEach(function(t){t.addEventListener('click',function(){select(t)})});
  // Pair is the server-rendered default; sync JS state to it.
  refreshPlan();

  // ---- add to cart: AJAX, then auto-apply the pack's sale code ----
  var form=document.getElementById('lpBuyForm');
  if(form){
    form.addEventListener('submit',function(e){
      e.preventDefault();
      var btn=document.getElementById('mainCta');
      btn.disabled=true; btn.style.opacity='.75';
      // Clear first so returning and clicking again REPLACES the selection
      // instead of stacking quantities, then add and go straight to checkout.
      var sel = page.querySelector('.tile[aria-pressed="true"]');
      var variantId = parseInt((sel && sel.getAttribute('data-variant')) || {{ v_pair.id | json }}, 10);
      var items = [{ id: variantId, quantity: 1 }];
      var plan = document.getElementById('thPlan');
      if (plan && plan.checked) {
        // ONE per order: priority dispatch speeds up the whole parcel, so it
        // must not scale with pack size
        items.push({ id: parseInt(plan.getAttribute('data-variant'),10), quantity: 1 });
      }
      fetch('{{ routes.cart_url }}/clear.js',{method:'POST',headers:{'Accept':'application/json'}})
        .then(function(){
          return fetch('{{ routes.cart_add_url }}.js',{
            method:'POST',
            headers:{'Content-Type':'application/json','Accept':'application/json'},
            body: JSON.stringify({ items: items })
          });
        })
        .then(function(r){ if(!r.ok){throw new Error('add failed')} return r.json(); })
        .then(function(){
          // Summer Sale is an automatic discount, so no /discount/ hop is needed
          window.location.href = '/checkout';
        })
        .catch(function(){ btn.disabled=false; btn.style.opacity='1'; form.submit(); });
    });
  }

  // ---- back button: browsers restore this page from bfcache with the
  //      button still disabled from the previous click, which looked broken.
  //      Re-enable it on every restore (and on normal load). ----
  function resetCta(){
    var b=document.getElementById('mainCta');
    if(b){ b.disabled=false; b.style.opacity='1'; }
  }
  window.addEventListener('pageshow', resetCta);
  resetCta();

  // ---- FAQ accordion ----
  page.querySelectorAll('.faq-q').forEach(function(q){
    q.addEventListener('click',function(){
      var item=q.parentElement, open=item.classList.toggle('open');
      q.setAttribute('aria-expanded',open?'true':'false');
      q.querySelector('.pm').textContent=open?'\u2013':'+';
    });
  });

  // ---- sticky bar: show once buy box scrolls out ----
  var bar=document.getElementById('stickybar');
  var buy=document.getElementById('buy');
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(entries){
      var visible=entries[0].isIntersecting;
      bar.classList.toggle('show',!visible);
      bar.setAttribute('aria-hidden',visible?'true':'false');
    },{threshold:0.05}).observe(buy);
  }else{bar.classList.add('show');bar.setAttribute('aria-hidden','false');}

  // ---- comparison table: hide right fade when scrolled to the end ----
  var outer=document.getElementById('compareOuter');
  var scroller=document.getElementById('compareScroll');
  if(outer&&scroller){
    var checkEnd=function(){
      var atEnd=scroller.scrollLeft+scroller.clientWidth>=scroller.scrollWidth-8;
      outer.classList.toggle('at-end',atEnd);
    };
    scroller.addEventListener('scroll',checkEnd,{passive:true});
    window.addEventListener('resize',checkEnd);
    checkEnd();
  }


  // ---- unwired CTA (no sellable variant resolved) ----
  var unwired=page.querySelector('#mainCta[data-unwired]');
  if(unwired){
    unwired.addEventListener('click',function(){
      alert('Almost live: publish the Thermora joint massager product (price above \u00a30) in Shopify admin, then pick it under Theme editor \u2192 Thermora Landing \u2192 Product.');
    });
  }
})();
</script>

{% schema %}
{
  "name": "Thermora Landing",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "The joint massager product the buy buttons add to cart. Falls back to handle 'thermora-heated-joint-massager' if unset."
    },
    {
      "type": "checkbox",
      "id": "show_protection",
      "label": "Offer the priority handling add-on",
      "default": true,
      "info": "Only tick this if you will genuinely submit and pay these orders to CJ ahead of the rest, every working day. The promise is deliberately scoped to what you control (order goes in first, chased, fee refunded if dispatch takes over 3 working days) — do NOT reword it into a next-day dispatch or delivery guarantee, which the warehouse, not you, decides."
    },
    {
      "type": "product",
      "id": "protection_product",
      "label": "Add-on product (priority handling)",
      "info": "Falls back to handle 'priority-handling-order-goes-first'. Hidden automatically if the product is missing or unpriced."
    },
    {
      "type": "text",
      "id": "condition_lead",
      "label": "Condition list heading",
      "default": "Used daily by people with:",
      "info": "Keep it factual about WHO buys it. Do not change to 'Helps with' or 'Treats' — naming a condition after those verbs is a medical claim (ASA/CAP Section 12) and is what gets ads banned."
    },
    {
      "type": "textarea",
      "id": "condition_chips",
      "label": "Conditions (comma separated)",
      "default": "Osteoarthritis, Rheumatoid arthritis, Bone-on-bone knees, Runner's knee, Jumper's knee, Housemaid's knee, Meniscus wear, Chondromalacia, Frozen shoulder, Rotator cuff aches, Shoulder bursitis, Tennis elbow, Golfer's elbow, Old ACL &amp; ligament injuries, After a joint replacement, Cold-weather flare-ups, Kneeling &amp; manual work",
      "info": "Shown as chips under the subhead. Leave empty to hide the whole block."
    },
    {
      "type": "header",
      "content": "Summer Sale"
    },
    {
      "type": "checkbox",
      "id": "sale_enabled",
      "label": "Summer Sale on",
      "default": true,
      "info": "Shows the sale price, savings and countdown. The discount itself is AUTOMATIC in Shopify admin (no code) and applies to every pack including the single. Auto-hides after the end date."
    },
    {
      "type": "number",
      "id": "sale_percent",
      "label": "Sale percentage",
      "default": 10,
      "info": "MUST match the automatic discount in admin ('Summer Sale — 10% off all Thermora packs'). The page mirrors this number; if the two disagree, the price shown won't be the price charged."
    },
    {
      "type": "text",
      "id": "sale_end",
      "label": "Sale end (ISO date-time)",
      "default": "2026-09-01T23:59:59+01:00",
      "info": "Countdown target. Must match the discounts' end date in admin."
    },
    {
      "type": "header",
      "content": "Trust & legal"
    },
    {
      "type": "url",
      "id": "cert_ce_url",
      "label": "CE certificate PDF (Shopify Files URL)",
      "info": "Upload 'tst certificate of compliance.pdf' under Content > Files, paste the URL here, and the CE badge becomes a link. Leave empty to show the badge unlinked."
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Verified review count (optional)",
      "info": "Leave empty until you have a real, reconciled number. Never guess."
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder first name"
    },
    {
      "type": "richtext",
      "id": "founder_note",
      "label": "Founder note (true story only)",
      "info": "Hidden until filled. Paste the real, verified founder story (~120 words) — never an invented one (CMA/DMCC risk)."
    },
    {
      "type": "text",
      "id": "company_number",
      "label": "Company number (optional)"
    }
  ],
  "presets": [{ "name": "Thermora Landing" }]
}
{% endschema %}
