{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}
{{ 'steadwell-landing.css' | asset_url | stylesheet_tag }}

<div id="reviews" style="scroll-margin-top: 100px; display: block !important;"></div>
<div class="bp-section" style="background:{{ section.settings.bg_color }}; padding:88px 0;">
  <div class="bp-wrap" style="padding-top:0; padding-bottom:0;">
    <div class="stw-reviews-box">
      <div class="stw-reviews-stars" aria-hidden="true">
        {% for i in (1..5) %}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="1.5"><polygon points="12 2 15 9 22 9.3 16.5 14 18.5 21 12 17 5.5 21 7.5 14 2 9.3 9 9"/></svg>
        {% endfor %}
      </div>
      <h3>{{ section.settings.heading }}</h3>
      <p>{{ section.settings.text }}</p>
      <a class="bp-btn bp-btn--outline" href="{{ section.settings.cta_link | default: '#offer' }}">{{ section.settings.cta_text }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STW Reviews (empty state)",
  "tag": "section",
  "class": "section-stw-reviews-empty",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F2EEE4" },
    { "type": "color", "id": "accent_color", "label": "Star color", "default": "#B85C24" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be the first to share how it's worked for you" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We open reviews once the first orders have had time to arrive and settle in. Bought one already? We'll email you in a couple of weeks to ask." },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop now, review later" }
  ],
  "presets": [{ "name": "STW Reviews (empty state)" }]
}
{% endschema %}
