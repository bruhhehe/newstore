{% render 'sajda-head' %}

<section class="band">
  <div class="wrap">
    <div class="col">
      <p class="eyebrow">About</p>
      <h1>{{ page.title }}</h1>
      <p class="lede">{{ section.settings.lede }}</p>
    </div>
  </div>
</section>

<section class="band band--white">
  <div class="wrap">
    <div class="article">
      {{ page.content }}
    </div>
  </div>
</section>

<section class="band band--wash">
  <div class="wrap">
    <div class="col">
      <p class="eyebrow">The wrap</p>
      <h2>Thirty minutes of warmth that doesn't go cold.</h2>
      <p>Free UK delivery, 30 days to change your mind with the return postage paid, a two-year warranty, and a person on the end of the email.</p>
      <p style="margin-top:24px"><a class="btn" href="/#buy">See {{ shop.name }}</a></p>
    </div>
  </div>
</section>

{% render 'sajda-foot' %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": {{ page.title | json }},
  "url": {{ shop.url | append: page.url | json }},
  "mainEntity": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    {%- if shop.email != blank %}
    "email": {{ shop.email | json }},
    {%- endif %}
    "areaServed": "GB",
    "description": "{{ shop.name }} makes a cordless heated wrap that holds its set warmth for a full thirty minutes, on a knee, shoulder or elbow."
  }
}
</script>

{% schema %}
{
  "name": "Sajda about",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "One product, made for one problem \u2014 and honest about what it will and won't do." }
  ],
  "presets": [{ "name": "Sajda about" }]
}
{% endschema %}
