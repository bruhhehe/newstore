{{ 'bunny-trust.css' | asset_url | stylesheet_tag }}

<div class="bp-section stw-prom-{{ section.id }}" style="background:{{ section.settings.bg_color }};">
  <style>
    .stw-prom-{{ section.id }} .stw-prom-wrap{
      max-width:780px; margin:0 auto; padding:82px 24px;
    }
    .stw-prom-{{ section.id }} h2{
      font-size:33px; line-height:1.2; margin-bottom:24px; color:{{ section.settings.text_color }};
    }
    .stw-prom-{{ section.id }} .stw-prom-body p{
      font-size:18px; line-height:1.75; color:{{ section.settings.text_color }};
      opacity:.9; margin:0 0 18px;
    }
    .stw-prom-{{ section.id }} .stw-prom-body p:last-child{ margin-bottom:0; }
    .stw-prom-{{ section.id }} .stw-prom-lead{
      font-size:20px !important; font-weight:600; opacity:1 !important;
    }
    .stw-prom-{{ section.id }} .stw-prom-rule{
      width:54px; height:2px; background:{{ section.settings.accent_color }};
      margin:0 0 26px;
    }
    .stw-prom-{{ section.id }} .stw-prom-sign{
      margin-top:30px; padding-top:24px; border-top:1px solid rgba(128,120,100,.28);
      display:flex; align-items:center; gap:14px; flex-wrap:wrap;
    }
    .stw-prom-{{ section.id }} .stw-prom-sign .name{
      font-family:var(--bp-serif); font-size:19px; color:{{ section.settings.text_color }};
    }
    .stw-prom-{{ section.id }} .stw-prom-sign .role{
      font-size:15px; color:{{ section.settings.text_color }}; opacity:.7;
    }
    .stw-prom-{{ section.id }} .stw-prom-pledges{
      display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:34px;
    }
    .stw-prom-{{ section.id }} .stw-prom-pledge{
      background:rgba(255,255,255,.55); border:1px solid var(--bp-line);
      border-radius:var(--bp-radius); padding:18px 20px;
    }
    .stw-prom-{{ section.id }} .stw-prom-pledge b{
      display:block; font-size:15.5px; margin-bottom:5px; color:{{ section.settings.text_color }};
    }
    .stw-prom-{{ section.id }} .stw-prom-pledge span{
      font-size:15px; line-height:1.55; color:{{ section.settings.text_color }}; opacity:.75;
    }
    @media (max-width:760px){
      .stw-prom-{{ section.id }} .stw-prom-wrap{ padding:54px 20px; }
      .stw-prom-{{ section.id }} h2{ font-size:26px; }
      .stw-prom-{{ section.id }} .stw-prom-body p{ font-size:17px; }
      .stw-prom-{{ section.id }} .stw-prom-lead{ font-size:18.5px !important; }
      .stw-prom-{{ section.id }} .stw-prom-pledges{ grid-template-columns:1fr; }
    }
  </style>
  <div class="stw-prom-wrap">
    <div class="bp-eyebrow">{{ section.settings.eyebrow }}</div>
    <h2>{{ section.settings.heading }}</h2>
    <div class="stw-prom-rule"></div>
    <div class="stw-prom-body">
      {{ section.settings.body }}
    </div>

    {% if section.settings.signature_name != blank %}
      <div class="stw-prom-sign">
        <span class="name">{{ section.settings.signature_name }}</span>
        <span class="role">{{ section.settings.signature_role }}</span>
      </div>
    {% endif %}

    <div class="stw-prom-pledges">
      {% for block in section.blocks %}
        <div class="stw-prom-pledge" {{ block.shopify_attributes }}>
          <b>{{ block.settings.title }}</b>
          <span>{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "STW Our promise",
  "tag": "section",
  "class": "section-stw-promise",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#EFE9DA" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#23201B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B85C24" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY WE MADE THIS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We build for the people we'd give it to first." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Ageing rarely announces itself. It arrives quietly — in the hand that reaches for the armrest, in the walk that gets a little shorter, in someone you love saying they're fine when they plainly aren't.</p><p>That's who we make things for. Not for a market segment — for the people at our own kitchen tables.</p>" },
    { "type": "text", "id": "signature_name", "label": "Signature name", "default": "" },
    { "type": "text", "id": "signature_role", "label": "Signature role", "default": "Steadwell" }
  ],
  "blocks": [
    {
      "type": "pledge",
      "name": "Pledge",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "A person, not a bot" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Email us and one of us answers." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "STW Our promise",
      "blocks": [
        { "type": "pledge", "settings": { "title": "A person, not a bot", "text": "Write to us and one of us answers — usually the same day." } },
        { "type": "pledge", "settings": { "title": "We'll tell you if it's not right", "text": "Ask us before you buy. If it isn't what you need, we'll say so." } },
        { "type": "pledge", "settings": { "title": "Thirty days, no arguments", "text": "Send it back inside a month and we refund every penny." } }
      ]
    }
  ]
}
{% endschema %}

